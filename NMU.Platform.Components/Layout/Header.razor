@using NMU.Platform.Components.Services
@using Microsoft.JSInterop
@implements IDisposable
@inject FullscreenService FullscreenService
@inject IPlatformService Platform
@inject NavigationManager Navigation
@inject IJSRuntime JS
@inject NavigationState NavState
@inject ToastService Toast
@inject NavigationHistoryService NavHistory
@inject QuizStateService QuizState
@inject LayoutState LayoutState

<header class="header" dir="ltr" lang="en">
    <div class="header-left">
        <button class="menu-toggle-btn" @onclick="ToggleSidebar" title="Menu" aria-label="Menu">
            <i class="fas fa-bars"></i>
        </button>
        @if (!IsHome)
        {
            <button class="back-btn" @onclick="GoBack" title="Back">
                <i class="fas fa-arrow-left"></i>
            </button>
        }
    </div>

    <div class="header-center">
        <h2>@NavState.PageTitle</h2>
    </div>

    <div class="header-right">
        @if (Platform.IsWeb && IsHome)
        {
            <button class="download-btn" @onclick="DownloadApp">
                <span>Download App</span>
            </button>
        }
        @if (Platform.IsWeb)
        {
            <button id="fullscreen-btn" class="icon-btn" @onclick="ToggleFullscreen">
                <i class="fas fa-expand"></i>
            </button>
        }
        @if (Platform.IsDesktop)
        {
            @if (!Platform.IsFullScreen)
            {
                <button class="win-btn win-btn-fs" @onclick="ToggleFullscreen" title="Full Screen">
                    <i class="fas fa-expand"></i>
                </button>
            }
            else
            {
                <button class="win-btn win-btn-fs" @onclick="ToggleFullscreen" title="Exit Full Screen">
                    <i class="fas fa-compress"></i>
                </button>
            }
            <button class="win-btn win-btn-min" @onclick="Minimize" title="Minimize">
                <i class="fas fa-minus"></i>
            </button>
            <button class="win-btn win-btn-max" @onclick="ToggleMaximize" title="Maximize">
                <i class="fas fa-square"></i>
            </button>
            <button class="win-btn win-btn-close" @onclick="CloseApp" title="Close">
                <i class="fas fa-times"></i>
            </button>
        }
        @if (!Platform.IsWeb && !Platform.IsDesktop && NavState.CurrentFileUrl != null)
        {
            <button class="icon-btn" @onclick="DownloadCurrentFile" disabled="@_isDownloading" title="Download">
                @if (_isDownloading)
                {
                    <span class="btn-spinner"></span>
                }
                else
                {
                    <i class="fas fa-download"></i>
                }
            </button>
        }
    </div>
</header>

@if (_showExitConfirm)
{
    <div class="modal-overlay active-modal">
        <div class="modal-box" style="text-align:center; padding:25px;">
            <div style="font-size:3rem; margin-bottom:15px;">
                <i class="fas fa-sign-out-alt" style="color:var(--wrong)"></i>
            </div>
            <h3 style="margin-bottom:10px; color:var(--text-primary);">Exit Application?</h3>
            <p style="color:var(--text-secondary); margin-bottom:20px;">
                Are you sure you want to exit the application?
            </p>
            <div style="display:flex; gap:10px; justify-content:center;">
                <button class="ctrl-btn" style="flex:1; border-color:var(--text-secondary); color:#fff;"
                        @onclick="CancelAppExit">Cancel</button>
                <button class="ctrl-btn" style="flex:1; background:var(--wrong); color:#fff; border:none;"
                        @onclick="ConfirmAppExit">Exit</button>
            </div>
        </div>
    </div>
}

@code {
    private bool IsHome => string.IsNullOrEmpty(Navigation.ToBaseRelativePath(Navigation.Uri).Trim('/'));
    private bool IsVideoPlayer => Navigation.Uri.Contains("/player") && !Navigation.Uri.Contains("/youtube/");
    private bool IsYouTubePlayer => Navigation.Uri.Contains("/youtube/") && Navigation.Uri.Contains("/player");
    private bool _isDownloading;
    private bool _showExitConfirm;

    private void ToggleSidebar() => LayoutState.ToggleSidebar();

    private void TriggerExitConfirmation()
    {
        _showExitConfirm = true;
        StateHasChanged();
    }

    private async Task ToggleMaximize() => await Platform.ToggleMaximizeAsync();

    private async Task Minimize() => await Platform.MinimizeAsync();

    private void CloseApp()
    {
        TriggerExitConfirmation();
    }

    private DotNetObjectReference<Header>? _dotNetRef;

    protected override void OnInitialized()
    {
        if (Platform.IsDesktop)
            Platform.FullScreenChanged += OnFullScreenChanged;
        Navigation.LocationChanged += OnLocationChanged;
        var initUrl = Navigation.ToBaseRelativePath(Navigation.Uri).TrimEnd('/');
        NavHistory.NavigatedTo(string.IsNullOrEmpty(initUrl) ? "/" : "/" + initUrl);
    }

    private void OnFullScreenChanged() => StateHasChanged();

    protected override async Task OnAfterRenderAsync(bool firstRender)
    {
        if (firstRender && !Platform.IsWeb)
        {
            _dotNetRef = DotNetObjectReference.Create(this);
            await JS.InvokeVoidAsync("window.nmuAddGoBackListener", _dotNetRef);
        }
    }

    [JSInvokable]
    public async Task HandleGoBack()
    {
        await GoBack();
    }

    private void OnLocationChanged(object? sender, Microsoft.AspNetCore.Components.Routing.LocationChangedEventArgs e)
    {
        var newPath = Navigation.ToBaseRelativePath(e.Location).TrimEnd('/');
        if (newPath == "") newPath = "/";

        NavHistory.NavigatedTo(newPath);

        var parts = newPath.Split('/');
        if (!(parts.Length >= 3 && parts[0] == "materials" && parts[^1] == "viewer"))
        {
            NavState.CurrentFileUrl = null;
            NavState.CurrentFileName = null;
        }
        StateHasChanged();
    }

    private async Task GoBack()
    {
        if (IsVideoPlayer)
            try { await JS.InvokeVoidAsync("videoPlayer.destroy"); } catch { }
        NavState.CurrentFileUrl = null;
        NavState.CurrentFileName = null;
        NavState.IsFullScreen = false;

        if (QuizState.IsQuizActive)
        {
            QuizState.RequestBack();
            return;
        }

        var prev = NavHistory.Pop();
        if (prev != null)
        {
            Navigation.NavigateTo(prev.TrimStart('/'), replace: true);
            return;
        }

        if (IsHome && !Platform.IsWeb)
        {
            TriggerExitConfirmation();
            return;
        }

        Navigation.NavigateTo("", replace: true);
    }

    private async Task ToggleFullscreen()
    {
        if (Platform.IsDesktop)
        {
            await Platform.ToggleFullScreenAsync();
            return;
        }
        if (IsVideoPlayer)
        {
            await JS.InvokeVoidAsync("videoPlayer.toggleFullscreen");
            return;
        }
        if (IsYouTubePlayer)
        {
            await JS.InvokeVoidAsync("youtubePlayer.toggleFullscreen");
            return;
        }
        await FullscreenService.ToggleAsync();
    }

    private async Task DownloadCurrentFile()
    {
        var url = NavState.CurrentFileUrl;
        var name = NavState.CurrentFileName ?? "document.pdf";
        if (string.IsNullOrEmpty(url)) return;
        _isDownloading = true;
        StateHasChanged();
        try
        {
            // Try cached bytes first (no internet needed)
            byte[]? cachedBytes = null;
            if (!Platform.IsWeb)
            {
                try
                {
                    var pdfKey = GetPdfCacheKey(url);
                    cachedBytes = await JS.InvokeAsync<byte[]>("nmuFunctions.getCachedPdfBytes", pdfKey);
                }
                catch { }
            }

            DownloadResult result;
            if (cachedBytes != null && cachedBytes.Length > 0)
            {
                result = await Platform.SaveFileAsync(cachedBytes, name);
            }
            else
            {
                result = await Platform.DownloadFileAsync(url, name);
            }

            switch (result)
            {
                case DownloadResult.Success:
                    Toast.ShowToast($"Downloaded {name}", ToastType.Success);
                    break;
                case DownloadResult.Cancelled:
                    Toast.ShowToast("Download cancelled", ToastType.Cancelled);
                    break;
                case DownloadResult.Error:
                    Toast.ShowToast("An error occurred", ToastType.Error);
                    break;
            }
        }
        finally
        {
            _isDownloading = false;
            StateHasChanged();
        }
    }

    private static string GetPdfCacheKey(string fileUrl)
    {
        if (string.IsNullOrEmpty(fileUrl)) return "";
        var hash = Convert.ToHexString(System.Security.Cryptography.SHA256.HashData(
            System.Text.Encoding.UTF8.GetBytes(fileUrl)))[..16];
        return $"pdf_{hash}";
    }

    private async void ConfirmAppExit()
    {
        _showExitConfirm = false;
        StateHasChanged();
        await Platform.CloseAsync();
    }

    private void CancelAppExit()
    {
        _showExitConfirm = false;
        StateHasChanged();
    }

    private void DownloadApp()
    {
        var url = "https://drive.google.com/uc?export=download&id=1PjC905nxFVN9LbdGov5gNtZyc7dqOmqs";
        if (Platform.IsDesktop)
            try { System.Diagnostics.Process.Start(new System.Diagnostics.ProcessStartInfo(url) { UseShellExecute = true }); } catch { }
        else
            Navigation.NavigateTo(url);
    }

    public void Dispose()
    {
        _dotNetRef?.Dispose();
        if (Platform.IsDesktop)
            Platform.FullScreenChanged -= OnFullScreenChanged;
        Navigation.LocationChanged -= OnLocationChanged;
    }
}

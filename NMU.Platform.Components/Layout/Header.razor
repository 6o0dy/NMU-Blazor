@using NMU.Platform.Components.Services
@using Microsoft.JSInterop
@implements IDisposable
@inject FullscreenService FullscreenService
@inject IPlatformService Platform
@inject NavigationManager Navigation
@inject IJSRuntime JS
@inject NavigationState NavState

<header class="header" dir="ltr" lang="en">
    <div class="header-left">
        @if (!IsHome)
        {
            <button class="back-btn" @onclick="GoBack" title="Back">
                <i class="fas fa-arrow-left"></i>
            </button>
        }
        @if (IsHome)
        {
            <button class="info-btn" @onclick="GoToFeedback" title="About / Feedback">
                <svg viewBox="0 0 24 24" width="22" height="22">
                    <path d="M11 7h2v2h-2zm0 4h2v6h-2zm1-9C6.48 2 2 6.48 2 12s4.48 10 10 10 10-4.48 10-10S17.52 2 12 2zm0 18c-4.41 0-8-3.59-8-8s3.59-8 8-8 8 3.59 8 8-3.59 8-8 8z" fill="currentColor"/>
                </svg>
            </button>
        }
    </div>

    <div class="header-center">
        <h2>@NavState.PageTitle</h2>
    </div>

    <div class="header-right">
        @if (Platform.IsWeb && IsHome)
        {
            <button class="download-btn" @onclick="DownloadApp">
                <span>Download App</span>
            </button>
        }
        @if (Platform.IsDesktop)
        {
            @if (!Platform.IsFullScreen)
            {
                <button class="win-btn win-btn-fs" @onclick="ToggleFullscreen" title="Full Screen">
                    <i class="fas fa-expand"></i>
                </button>
                <button class="win-btn win-btn-min" @onclick="Minimize" title="Minimize">
                    <i class="fas fa-minus"></i>
                </button>
                <button class="win-btn win-btn-max" @onclick="ToggleMaximize" title="Maximize">
                    <i class="fas fa-square"></i>
                </button>
            }
            else
            {
                <button class="win-btn win-btn-fs" @onclick="ToggleFullscreen" title="Exit Full Screen">
                    <i class="fas fa-compress"></i>
                </button>
            }
            <button class="win-btn win-btn-close" @onclick="CloseApp" title="Close">
                <i class="fas fa-times"></i>
            </button>
        }
        else if (Platform.IsWeb)
        {
            <button id="fullscreen-btn" class="icon-btn" @onclick="ToggleFullscreen">
                <i class="fas fa-expand"></i>
            </button>
        }
        @if (!Platform.IsWeb && !Platform.IsDesktop && NavState.CurrentFileUrl != null)
        {
            <button class="icon-btn" @onclick="DownloadCurrentFile" title="Download">
                <i class="fas fa-download"></i>
            </button>
        }
    </div>
</header>

@code {
    private bool IsHome => Navigation.Uri.TrimEnd('/').EndsWith("/") || Navigation.Uri.EndsWith("/");

    private readonly Stack<string> _navStack = new();
    private bool _isGoingBack;
    private string _prevPath = "";

    protected override void OnInitialized()
    {
        if (Platform.IsDesktop)
            Platform.FullScreenChanged += OnFullScreenChanged;
        Navigation.LocationChanged += OnLocationChanged;
        _prevPath = Navigation.ToBaseRelativePath(Navigation.Uri).TrimEnd('/');
        if (_prevPath == "") _prevPath = "/";
    }

    private void OnLocationChanged(object? sender, Microsoft.AspNetCore.Components.Routing.LocationChangedEventArgs e)
    {
        var newPath = Navigation.ToBaseRelativePath(e.Location).TrimEnd('/');
        if (newPath == "") newPath = "/";

        if (!_isGoingBack && _prevPath != newPath && _prevPath != "")
        {
            var pp = _prevPath.Trim('/').Split('/');
            var isViewer = pp.Length >= 3 && pp[0] == "materials" && pp[^1] == "viewer";
            if (!(isViewer && NavState.CurrentFileUrl == null))
                _navStack.Push(_prevPath);
        }

        _isGoingBack = false;
        _prevPath = newPath;

        var parts = newPath.Split('/');
        if (!(parts.Length >= 3 && parts[0] == "materials" && parts[^1] == "viewer"))
        {
            NavState.CurrentFileUrl = null;
            NavState.CurrentFileName = null;
        }
        StateHasChanged();
    }

    private void OnFullScreenChanged() => StateHasChanged();

    public void Dispose()
    {
        if (Platform.IsDesktop)
            Platform.FullScreenChanged -= OnFullScreenChanged;
        Navigation.LocationChanged -= OnLocationChanged;
    }

    private void GoBack()
    {
        while (_navStack.Count > 0)
        {
            var target = _navStack.Pop();
            var parts = target.Trim('/').Split('/');
            var isViewer = parts.Length >= 3 && parts[0] == "materials" && parts[^1] == "viewer";
            if (isViewer && NavState.CurrentFileUrl == null)
                continue;
            NavState.CurrentFileUrl = null;
            NavState.CurrentFileName = null;
            _isGoingBack = true;
            Navigation.NavigateTo(target, replace: true);
            return;
        }
        NavState.CurrentFileUrl = null;
        NavState.CurrentFileName = null;
        _isGoingBack = true;
        var cur = Navigation.ToBaseRelativePath(Navigation.Uri).TrimEnd('/');
        var segs = cur.Split('/');
        if (segs.Length >= 2 && segs[0] == "materials")
            Navigation.NavigateTo("/materials", replace: true);
        else
            Navigation.NavigateTo("/");
    }

    private async Task ToggleFullscreen()
    {
        if (Platform.IsDesktop)
            await Platform.ToggleFullScreenAsync();
        else
            await FullscreenService.ToggleAsync();
    }

    private async Task ToggleMaximize() => await Platform.ToggleMaximizeAsync();
    private async Task Minimize() => await Platform.MinimizeAsync();
    private async Task CloseApp() => await Platform.CloseAsync();

    private async Task DownloadCurrentFile()
    {
        var url = NavState.CurrentFileUrl;
        var name = NavState.CurrentFileName ?? "document.pdf";
        if (!string.IsNullOrEmpty(url))
            await Platform.DownloadFileAsync(url, name);
    }

    private void GoToFeedback() => Navigation.NavigateTo("/feedback");

    private void DownloadApp()
    {
        var url = "https://drive.google.com/uc?export=download&id=1PjC905nxFVN9LbdGov5gNtZyc7dqOmqs";
        if (Platform.IsDesktop)
            try { System.Diagnostics.Process.Start(new System.Diagnostics.ProcessStartInfo(url) { UseShellExecute = true }); } catch { }
        else
            Navigation.NavigateTo(url);
    }
}

@using NMU.Platform.Components.Services
@using NMU.Platform.Components.Loading
@using NMU.Platform.Components.Setup
@using NMU.Platform.Components.Models
@using Microsoft.JSInterop
@implements IDisposable
@inherits LayoutComponentBase
@inject StudentService StudentService
@inject QuizService QuizService
@inject IPlatformService Platform
@inject LayoutState LayoutState
@inject ToastService Toast
@inject NavigationState NavState
@inject NavigationManager Navigation
@inject IJSRuntime JS

<div class="app-shell" dir="ltr">
    @if (!NavState.IsFullScreen && !showLoading)
    {
        @if (LayoutState.SidebarOpen)
        {
            <div class="sidebar-backdrop" @onclick="CloseSidebar"></div>
        }
        <aside class="sidebar @(LayoutState.SidebarOpen ? "sidebar-open" : "")">
            <div class="brand-box">
                <div class="brand-badge">N</div>
                <span class="brand-name">NMU Platform</span>
            </div>

            <nav class="sidebar-nav">
                <NavLink class="sidebar-nav-item" href="/" Match="NavLinkMatch.All" @onclick="CloseSidebar">🏠 Home</NavLink>
                <NavLink class="sidebar-nav-item" href="/materials" Match="NavLinkMatch.Prefix" @onclick="CloseSidebar">📚 Study Materials</NavLink>
                <NavLink class="sidebar-nav-item" href="/recorded" Match="NavLinkMatch.Prefix" @onclick="CloseSidebar">🎥 Recorded Lectures</NavLink>
                <NavLink class="sidebar-nav-item" href="/quizzes" Match="NavLinkMatch.Prefix" @onclick="CloseSidebar">🧩 Quizzes &amp; Bank</NavLink>
                <NavLink class="sidebar-nav-item" href="/laboratory" Match="NavLinkMatch.Prefix" @onclick="CloseSidebar">🧪 Virtual Lab</NavLink>
                <NavLink class="sidebar-nav-item" href="/feedback" Match="NavLinkMatch.Prefix" @onclick="CloseSidebar">⭐ Feedback</NavLink>
            </nav>

            <div class="sidebar-spacer"></div>
            <div class="sidebar-divider"></div>
            <button class="sidebar-nav-item" @onclick="MenuWhatsApp">💬 WhatsApp</button>
            <button class="sidebar-nav-item" @onclick="MenuManageData">👤 My Data</button>
            <button class="sidebar-nav-item danger" @onclick="MenuClearCache">🗑️ Clear Cache</button>
        </aside>
    }

    <div class="main-wrapper">
        @if (!NavState.HideHeader)
        {
            <Header />
        }

        @if (showLoading)
        {
            <LoadingScreen IsVisible="true" OnComplete="@OnLoadingDone" />
        }
        else if (showSetup)
        {
            <SetupModal IsVisible="true" OnSave="@OnSetupSaved" />
        }
        else
        {
            @if (NavState.IsFullScreen)
            {
                @Body
            }
            else
            {
                @if (LayoutState.SearchBar != null)
                {
                    <div class="search-section">@LayoutState.SearchBar</div>
                }
                <div class="scroll-frame">
                    <div class="page-container @(IsFeedbackPage ? "page-container-wide" : "")">
                        @Body
                    </div>
                </div>
                @if (LayoutState.BottomBar != null)
                {
                    <div class="bottom-section">@LayoutState.BottomBar</div>
                }
            }
        }
    </div>
</div>

@if (!NavState.IsFullScreen)
{
    <nav class="mobile-bottom-nav" dir="ltr">
        <NavLink class="mobile-nav-btn" href="/" Match="NavLinkMatch.All">
            <span>🏠</span><span>Home</span>
        </NavLink>
        <NavLink class="mobile-nav-btn" href="/materials" Match="NavLinkMatch.Prefix">
            <span>📚</span><span>Materials</span>
        </NavLink>
        <NavLink class="mobile-nav-btn" href="/recorded" Match="NavLinkMatch.Prefix">
            <span>🎥</span><span>Lectures</span>
        </NavLink>
        <NavLink class="mobile-nav-btn" href="/quizzes" Match="NavLinkMatch.Prefix">
            <span>🧩</span><span>Quizzes</span>
        </NavLink>
    </nav>
}

@if (_toastVisible)
{
    <div class="toast-overlay" @onclick="HideToast">
        <div class="toast-box toast-@_toastType.ToString().ToLower()" @onclick:stopPropagation>
            <span class="toast-icon">@GetToastIcon()</span>
            <span class="toast-text">@_toastMessage</span>
        </div>
    </div>
}

@code {
    private static bool _initialLoadDone;
    private bool showLoading;
    private bool showSetup;
    private bool _toastVisible;
    private string _toastMessage = "";
    private ToastType _toastType;
    private CancellationTokenSource? _toastCts;

    private string GetToastIcon() => _toastType switch
    {
        ToastType.Success => "✓",
        ToastType.Cancelled => "✕",
        ToastType.Error => "✕",
        _ => "✓"
    };

    private bool IsHome => string.IsNullOrEmpty(Navigation.ToBaseRelativePath(Navigation.Uri).Trim('/'));

    private bool IsFeedbackPage => Navigation.ToBaseRelativePath(Navigation.Uri).TrimStart('/').StartsWith("feedback", StringComparison.OrdinalIgnoreCase);

    private void CloseSidebar() => LayoutState.CloseSidebar();

    private async Task MenuWhatsApp()
    {
        LayoutState.CloseSidebar();
        await JS.InvokeVoidAsync("open", "https://wa.me/201029691937", "_blank");
    }

    private void MenuManageData()
    {
        LayoutState.CloseSidebar();
        if (IsHome)
        {
            LayoutState.RequestSettings();
        }
        else
        {
            LayoutState.PendingSettings = true;
            Navigation.NavigateTo("", replace: true);
        }
    }

    private void MenuClearCache()
    {
        LayoutState.CloseSidebar();
        if (IsHome)
        {
            LayoutState.RequestClearCache();
        }
        else
        {
            LayoutState.PendingCache = true;
            Navigation.NavigateTo("", replace: true);
        }
    }

    protected override void OnInitialized()
    {
        LayoutState.StateChanged += OnLayoutStateChanged;
        Toast.Show += OnToastShow;
        Navigation.LocationChanged += OnLocationChanged;
    }

    private DotNetObjectReference<MainLayout>? _linkRef;

    protected override async Task OnAfterRenderAsync(bool firstRender)
    {
        if (firstRender)
        {
            _linkRef = DotNetObjectReference.Create(this);
            await JS.InvokeVoidAsync("window.nmuWireInternalLinks", _linkRef);
        }
    }

    [JSInvokable]
    public void HandleInternalLink(string url)
    {
        if (string.IsNullOrEmpty(url)) return;
        LayoutState.CloseSidebar();
        var target = url.TrimStart('/');
        if (Navigation.Uri.TrimEnd('/') == Navigation.BaseUri.TrimEnd('/') + "/" + target.TrimEnd('/'))
            return; // already on this page
        Navigation.NavigateTo(target, replace: true);
    }

    protected override async Task OnInitializedAsync()
    {
        if (Platform.IsDesktop)
            Platform.FullScreenChanged += OnFullScreenChanged;

        if (_initialLoadDone)
        {
            try
            {
                var student = await StudentService.GetStudentAsync();
                if (student != null)
                    _ = QuizService.EnsureQuizSyncedAsync(student.AcademicLevel, student.Semester);
                else
                    showSetup = true;
            }
            catch
            {
                showSetup = true;
            }
            return;
        }

        showLoading = true;
        _initialLoadDone = true;
    }

    private void OnLayoutStateChanged() => StateHasChanged();

    private void OnLocationChanged(object? sender, Microsoft.AspNetCore.Components.Routing.LocationChangedEventArgs e)
    {
        LayoutState.CloseSidebar();
        // Keep a guard history entry below the app at all times so the mobile
        // browser back button can never step off the site.
        if (Platform.IsWeb)
            _ = JS.InvokeVoidAsync("window.nmuEnsureWebBackTrap");
        StateHasChanged();
    }

    private async Task OnLoadingDone()
    {
        await Task.Delay(500);
        try
        {
            var student = await StudentService.GetStudentAsync();
            if (student != null)
            {
                showLoading = false;
                _ = QuizService.EnsureQuizSyncedAsync(student.AcademicLevel, student.Semester);
            }
            else
            {
                showLoading = false;
                showSetup = true;
            }
        }
        catch
        {
            showLoading = false;
            showSetup = true;
        }
        StateHasChanged();
    }

    private async Task OnSetupSaved()
    {
        showSetup = false;
        StateHasChanged();
    }

    private void OnFullScreenChanged() => StateHasChanged();

    private void OnToastShow((string message, ToastType type) data)
    {
        _toastCts?.Cancel();
        _toastCts = new CancellationTokenSource();
        _toastMessage = data.message;
        _toastType = data.type;
        _toastVisible = true;
        StateHasChanged();
        _ = AutoHideToast(_toastCts.Token);
    }

    private async Task AutoHideToast(CancellationToken ct)
    {
        try
        {
            await Task.Delay(4000, ct);
            if (!ct.IsCancellationRequested)
            {
                _toastVisible = false;
                StateHasChanged();
            }
        }
        catch (TaskCanceledException) { }
    }

    private void HideToast()
    {
        _toastVisible = false;
        StateHasChanged();
    }

    public void Dispose()
    {
        _toastCts?.Cancel();
        _linkRef?.Dispose();
        if (Platform.IsDesktop)
            Platform.FullScreenChanged -= OnFullScreenChanged;
        LayoutState.StateChanged -= OnLayoutStateChanged;
        Toast.Show -= OnToastShow;
        Navigation.LocationChanged -= OnLocationChanged;
    }
}
@page "/recorded/{Group}/player"
@using System.Globalization
@using System.Net.Http.Headers
@implements IDisposable
@inject IJSRuntime JS
@inject NavigationManager Navigation
@inject NavigationState NavState
@inject IPlatformService Platform
@inject HttpClient Http
@inject MediaCacheService MediaCache
@inject MediaProxyHost MediaProxyHost

<div class="vp-root @(_idle ? "idle" : "")" id="vp-body"
     @onmousemove="OnActivity" @ontouchstart="OnActivity">
    <div class="vp-player-wrapper @(_isAudio ? "audio-mode" : "")" id="vp-player-wrapper"
         @onclick="TogglePlay">
        <video id="vp-video" src="" playsinline preload="metadata"
               @onloadeddata="OnLoadedData"
               @ontimeupdate="OnTimeUpdate"
               @onplay="OnPlay"
               @onpause="OnPause"
               @onwaiting="OnWaiting"
               @onplaying="OnPlaying"
               @oncanplay="OnCanPlay"
               @onloadstart="OnLoadStart"
               @onclick:stopPropagation>
        </video>

        <div class="vp-audio-visual">
            <div class="vp-audio-icon"><i class="fa-solid fa-music"></i></div>
            <div class="vp-audio-bars">
                <div class="vp-bar"></div><div class="vp-bar"></div>
                <div class="vp-bar"></div><div class="vp-bar"></div>
                <div class="vp-bar"></div>
            </div>
        </div>

        <div class="vp-buffer" id="vp-buffer" style="display:@(_isBuffering ? "block" : "none")"></div>

        <div class="vp-center-play" style="opacity:@(_showCenterPlay ? "1" : "0")">
            <i class="fa-solid fa-play"></i>
        </div>

        @if (_cacheProgress is { } cp && cp.Total > 0 && !cp.Complete)
        {
            var pct = cp.Total > 0 ? (int)((double)cp.Cached / cp.Total * 100) : 0;
            <div class="vp-cache-bar">
                <div class="vp-cache-fill" style="width:@(pct)%"></div>
            </div>
        }
    </div>

    @if (_cacheProgress is { } c && c.Total > 0 && !c.Complete)
    {
        var pct2 = c.Total > 0 ? (int)((double)c.Cached / c.Total * 100) : 0;
        <div class="vp-cache-text">CACHING @pct2%</div>
    }

    <div class="vp-controls" @onclick:stopPropagation @onmousedown:stopPropagation>
        <div class="vp-progress-area">
            <span class="vp-time-current">@FormatTime(_currentTime)</span>
            <div class="vp-progress-bg"></div>
            <div class="vp-progress-bar" style="width:@ProgressPercent%"></div>
            @if (_cachedSegments.Count > 0 && _duration > 0)
            {
                <div class="vp-cache-segments">
                    @foreach (var seg in _cachedSegments)
                    {
                        var left = Math.Clamp(seg.Start / _duration * 100, 0, 100);
                        var right = Math.Clamp(seg.End / _duration * 100, 0, 100);
                        if (right <= left) continue;
                        <div class="vp-cache-seg"
                             style="left:@(left.ToString("0.##", CultureInfo.InvariantCulture))%;width:@((right - left).ToString("0.##", CultureInfo.InvariantCulture))%"></div>
                    }
                </div>
            }
            <div class="vp-progress-thumb" style="left:@ProgressPercent%"><span class="vp-thumb-gem"></span></div>
            <input type="range" class="vp-range" min="0" max="@_duration" step="0.1"
                   value="@_currentTime" @oninput="OnSeek" @onchange="OnSeekCommitted" />
            <span class="vp-time-duration">@FormatTime(_duration)</span>
        </div>

        <div class="vp-controls-row">
            <div class="vp-left">
                <button class="vp-btn vp-play-btn" @onclick="TogglePlay" type="button">
                    <i class="fa-solid fa-@(_isPaused ? "play" : "pause")"></i>
                </button>
                <div class="vp-volume">
                    <i class="fa-solid fa-volume-high" style="font-size:12px; opacity:0.7"></i>
                    <input type="range" min="0" max="1" step="0.05" value="@_volume"
                           @oninput="OnVolumeChange"
                           style="width:50px; height:3px; accent-color:var(--primary)" />
                </div>
            </div>
            <div class="vp-right">
                <button class="vp-btn" @onclick="TogglePiP" type="button" title="PiP"><i class="fa-solid fa-images"></i></button>
                <button class="vp-btn" @onclick="DownloadCurrentFile" type="button" title="Download"><i class="fa-solid fa-download"></i></button>
                <button class="vp-btn" @onclick="() => Skip(-10)" type="button" title="-10s"><i class="fa-solid fa-rotate-left"></i></button>
                <button class="vp-btn" @onclick="() => Skip(10)" type="button" title="+10s"><i class="fa-solid fa-rotate-right"></i></button>
                <button class="vp-btn vp-speed-btn" @onclick="ToggleSpeed" type="button">@_playbackRate.ToString("0.#")x</button>
                <button class="vp-btn" @onclick="ToggleFullscreen" type="button"><i class="fa-solid fa-expand"></i></button>
            </div>
        </div>
    </div>
</div>

@code {
    [Parameter] public string Group { get; set; } = "";

    private string _fileUrl = "";
    private string _fileName = "";
    private string _group = "";
    private bool _isAudio;
    private double _currentTime;
    private double _duration;
    private bool _isPaused = true;
    private bool _isBuffering;
    private double _volume = 1;
    private double _playbackRate = 1;
    private bool _showCenterPlay;
    private bool _idle;
    private bool _seeking;
    private DateTime _lastActivity = DateTime.UtcNow;
    private Timer? _idleTimer;
    private bool _disposed;
    private int _saveCounter;
    private CacheProgress? _cacheProgress;
    private Timer? _cachePollTimer;
    private string _cacheKey = "";
    private CancellationTokenSource? _cacheCts;
    private bool _cacheStarted;
    private List<(double Start, double End)> _cachedSegments = [];
    private Mp4TimeMap? _timeMap;
    private DateTime _lastTimeMapAttempt = DateTime.MinValue;

    private double ProgressPercent => _duration > 0 ? Math.Round(_currentTime / _duration * 100, 1) : 0;

    protected override void OnInitialized()
    {
        _group = Uri.UnescapeDataString(Group);
        var uri = new Uri(Navigation.Uri);
        var query = System.Web.HttpUtility.ParseQueryString(uri.Query);
        var urlFromQuery = query["url"];
        var nameFromQuery = query["name"];
        _fileUrl = urlFromQuery ?? NavState.CurrentFileUrl ?? "";
        _fileName = nameFromQuery ?? NavState.CurrentFileName ?? "Untitled";
        if (!string.IsNullOrEmpty(_fileUrl))
        {
            NavState.CurrentFileUrl = _fileUrl;
            NavState.CurrentFileName = _fileName;
        }
        if (string.IsNullOrEmpty(_fileUrl))
        {
            Navigation.NavigateTo($"recorded/{Uri.EscapeDataString(_group)}", replace: true);
            return;
        }
        _isAudio = _fileName.EndsWith(".mp3", StringComparison.OrdinalIgnoreCase) ||
                   _fileName.EndsWith(".wav", StringComparison.OrdinalIgnoreCase) ||
                   _fileName.EndsWith(".m4a", StringComparison.OrdinalIgnoreCase);
        _cacheKey = MediaCache.GetCacheKey(_fileUrl);
        NavState.IsFullScreen = true;
        NavState.PageTitle = _fileName;
    }

    protected override async Task OnAfterRenderAsync(bool firstRender)
    {
        if (firstRender)
        {
            var key = "nmu_prog_" + _fileUrl;
            await JS.InvokeVoidAsync("videoPlayer.init", key);
            await InitVideoSourceAsync();
            await RefreshCachedSegmentsAsync();
            StartIdleTimer();
            StartCachePollTimer();
        }
    }

    private async Task InitVideoSourceAsync()
    {
        try
        {
            var hasCache = await MediaCache.HasAnyCacheAsync(_cacheKey);

            if (hasCache)
            {
                var loaded = await LoadFromCacheAsync();
                if (!loaded)
                    await JS.InvokeVoidAsync("videoPlayer.setSource", _fileUrl);
            }
            else
            {
                await JS.InvokeVoidAsync("videoPlayer.setSource", _fileUrl);
            }

            if (hasCache && !await MediaCache.IsCompleteAsync(_cacheKey))
                _ = EnsureCacheEndsAsync();
        }
        catch { }
    }

    private async Task EnsureCacheEndsAsync()
    {
        try
        {
            var meta = await MediaCache.GetMetaAsync(_cacheKey);
            if (meta == null || meta.TotalSize <= 0) return;
            await MediaCache.PriorityCacheFirstChunkAsync(_cacheKey, _fileUrl, meta.TotalSize);
            await MediaCache.PriorityCacheLastChunkAsync(_cacheKey, _fileUrl, meta.TotalSize, meta.TotalChunks);
        }
        catch { }
    }

    private async Task<bool> LoadFromCacheAsync()
    {
        try
        {
            var meta = await MediaCache.GetMetaAsync(_cacheKey);
            if (meta == null) return false;

            var isComplete = await MediaCache.IsCompleteAsync(_cacheKey);

            if (isComplete)
            {
                var chunks = await MediaCache.ReadAvailableChunksAsync(_cacheKey);
                if (chunks == null || chunks.Count == 0) return false;
                foreach (var chunk in chunks)
                    await JS.InvokeVoidAsync("videoPlayer.appendChunk", chunk);
                await JS.InvokeVoidAsync("videoPlayer.finalizeBlob", meta.MimeType);
                return true;
            }

            var port = MediaProxyHost.EnsureRunning();
            var proxyUrl = $"http://127.0.0.1:{port}/media/{_cacheKey}";
            await JS.InvokeVoidAsync("videoPlayer.setSource", proxyUrl);
            return true;
        }
        catch { return false; }
    }

    private async Task OnLoadedData()
    {
        try
        {
            var saved = await JS.InvokeAsync<string>("videoPlayer.loadSavedTime");
            if (double.TryParse(saved, NumberStyles.Any, CultureInfo.InvariantCulture, out var t) && t > 0)
            {
                _currentTime = t;
                await JS.InvokeVoidAsync("videoPlayer.seekTo", t.ToString(CultureInfo.InvariantCulture));
                StateHasChanged();
            }
        }
        catch { }
    }

    private async Task OnTimeUpdate()
    {
        if (_seeking) return;
        try
        {
            var state = await JS.InvokeAsync<string>("videoPlayer.getState");
            var parts = state.Split('|');
            if (parts.Length == 2)
            {
                _currentTime = double.TryParse(parts[0], NumberStyles.Any, CultureInfo.InvariantCulture, out var ct) ? ct : 0;
                _duration = double.TryParse(parts[1], NumberStyles.Any, CultureInfo.InvariantCulture, out var d) ? d : 0;
                _saveCounter++;
                if (_saveCounter % 10 == 0)
                    await JS.InvokeVoidAsync("videoPlayer.saveTime", _currentTime.ToString(CultureInfo.InvariantCulture));
                StateHasChanged();
            }
        }
        catch { }
    }

    private void OnPlay()
    {
        _isPaused = false;
        _showCenterPlay = false;
        StateHasChanged();
        ResetIdle();
    }

    private void OnPause()
    {
        _isPaused = true;
        _showCenterPlay = true;
        StateHasChanged();
        _ = HideCenterPlayDelayed();
    }

    private async Task HideCenterPlayDelayed()
    {
        await Task.Delay(600);
        _showCenterPlay = false;
        await InvokeAsync(StateHasChanged);
    }

    private void OnWaiting() { _isBuffering = true; StateHasChanged(); }
    private void OnPlaying()
    {
        _isBuffering = false;
        StateHasChanged();
        if (!_cacheStarted)
        {
            _cacheStarted = true;
            _ = BackgroundCacheFromCSharpAsync();
        }
    }
    private void OnCanPlay() { _isBuffering = false; StateHasChanged(); }
    private void OnLoadStart() { _isBuffering = true; StateHasChanged(); }

    private async Task TogglePlay()
    {
        try
        {
            if (_isPaused)
                await JS.InvokeVoidAsync("videoPlayer.play");
            else
                await JS.InvokeVoidAsync("videoPlayer.pause");
        }
        catch { }
    }

    private async Task OnSeek(ChangeEventArgs e)
    {
        _seeking = true;
        if (double.TryParse(e.Value?.ToString(), NumberStyles.Any, CultureInfo.InvariantCulture, out var t))
        {
            _currentTime = t;
            StateHasChanged();
        }
    }

    private async Task OnSeekCommitted(ChangeEventArgs e)
    {
        if (double.TryParse(e.Value?.ToString(), NumberStyles.Any, CultureInfo.InvariantCulture, out var t))
        {
            _currentTime = t;
            await JS.InvokeVoidAsync("videoPlayer.seekTo", t.ToString(CultureInfo.InvariantCulture));
            if (_cacheStarted)
                _ = BackgroundCacheFromCSharpAsync();
        }
        _seeking = false;
        ResetIdle();
    }

    private async Task OnVolumeChange(ChangeEventArgs e)
    {
        if (double.TryParse(e.Value?.ToString(), NumberStyles.Any, CultureInfo.InvariantCulture, out var v))
        {
            _volume = v;
            await JS.InvokeVoidAsync("videoPlayer.setVolume", v.ToString(CultureInfo.InvariantCulture));
        }
    }

    private async Task Skip(double sec)
    {
        try
        {
            var state = await JS.InvokeAsync<string>("videoPlayer.getState");
            var parts = state.Split('|');
            if (parts.Length > 0 && double.TryParse(parts[0], NumberStyles.Any, CultureInfo.InvariantCulture, out var cur))
            {
                var newTime = Math.Max(0, cur + sec);
                _currentTime = newTime;
                await JS.InvokeVoidAsync("videoPlayer.seekTo", newTime.ToString(CultureInfo.InvariantCulture));
                StateHasChanged();
            }
        }
        catch { }
        ResetIdle();
    }

    private async Task ToggleSpeed()
    {
        _playbackRate = _playbackRate switch { 1 => 1.5, 1.5 => 2, 2 => 3, _ => 1 };
        await JS.InvokeVoidAsync("videoPlayer.setSpeed", _playbackRate.ToString(CultureInfo.InvariantCulture));
        StateHasChanged();
    }

    private async Task ToggleFullscreen()
    {
        await JS.InvokeVoidAsync("videoPlayer.toggleFullscreen");
    }

    private async Task TogglePiP()
    {
        try { await JS.InvokeVoidAsync("videoPlayer.togglePiP"); } catch { }
    }

    private async Task DownloadCurrentFile()
    {
        if (string.IsNullOrEmpty(_fileUrl)) return;
        if (Platform.IsWeb)
            Navigation.NavigateTo(_fileUrl);
        else
            await Platform.DownloadFileAsync(_fileUrl, _fileName);
    }

    private void OnActivity() { _lastActivity = DateTime.UtcNow; if (_idle) { _idle = false; StateHasChanged(); } }

    private void ResetIdle()
    {
        _lastActivity = DateTime.UtcNow;
        if (_idle) { _idle = false; InvokeAsync(StateHasChanged); }
    }

    private async Task BackgroundCacheFromCSharpAsync()
    {
        _cacheCts?.Cancel();
        _cacheCts?.Dispose();
        _cacheCts = new CancellationTokenSource();
        var ct = _cacheCts.Token;

        try
        {
            if (await MediaCache.IsCompleteAsync(_cacheKey)) return;

            long totalSize = 0;
            string mimeType = "video/mp4";
            int totalChunks = 0;

            while (!ct.IsCancellationRequested)
            {
                try
                {
                    using var headReq = new HttpRequestMessage(HttpMethod.Head, _fileUrl);
                    using var headResp = await Http.SendAsync(headReq, HttpCompletionOption.ResponseHeadersRead, ct);
                    if (headResp.IsSuccessStatusCode)
                    {
                        totalSize = headResp.Content.Headers.ContentLength ?? 0;
                        if (totalSize > 0)
                        {
                            mimeType = headResp.Content.Headers.ContentType?.MediaType ?? "video/mp4";
                            totalChunks = (int)Math.Ceiling((double)totalSize / 524288L);
                            break;
                        }
                    }
                }
                catch when (!ct.IsCancellationRequested) { }

                await Task.Delay(3000, ct);
            }

            if (totalSize <= 0 || totalChunks <= 0) return;

            await MediaCache.InitMetaAsync(_cacheKey, _fileUrl, totalSize, totalChunks, mimeType);
            await MediaCache.PriorityCacheLastChunkAsync(_cacheKey, _fileUrl, totalSize, totalChunks, ct);
            await MediaCache.PriorityCacheFirstChunkAsync(_cacheKey, _fileUrl, totalSize, ct);

            var posChunk = _duration > 0
                ? (int)Math.Clamp(_currentTime / _duration * totalChunks, 0, totalChunks - 1)
                : 0;

            await MediaCache.CacheFromNetworkAsync(
                _cacheKey, _fileUrl, posChunk, totalChunks, totalSize, mimeType,
                onProgress: async cp =>
                {
                    _cacheProgress = cp;
                    await InvokeAsync(StateHasChanged);
                },
                ct: ct, markComplete: false);

            if (ct.IsCancellationRequested) return;

            await MediaCache.CacheFromNetworkAsync(
                _cacheKey, _fileUrl, 0, posChunk, totalSize, mimeType,
                onProgress: async cp =>
                {
                    _cacheProgress = cp;
                    await InvokeAsync(StateHasChanged);
                },
                ct: ct, markComplete: true);
        }
        catch (OperationCanceledException) { }
        catch { }
    }

    private void StartCachePollTimer()
    {
        _cachePollTimer?.Dispose();
        _cachePollTimer = new Timer(async _ =>
        {
            if (_disposed) return;
            try
            {
                var result = await MediaCache.GetProgressAsync(_cacheKey);
                await RefreshCachedSegmentsAsync();
                _cacheProgress = result;
                if (result.Complete)
                {
                    _cachePollTimer?.Dispose();
                    _cachePollTimer = null;
                }
                await InvokeAsync(StateHasChanged);
            }
            catch { }
        }, null, 2000, 3000);
    }

    private async Task RefreshCachedSegmentsAsync()
    {
        try
        {
            var ranges = await MediaCache.GetCachedChunkRangesAsync(_cacheKey);
            if (ranges.Count == 0)
            {
                _cachedSegments = [];
                return;
            }
            if (_timeMap == null && (DateTime.UtcNow - _lastTimeMapAttempt).TotalSeconds > 10)
            {
                _lastTimeMapAttempt = DateTime.UtcNow;
                _timeMap = await MediaCache.GetTimeMapAsync(_cacheKey);
            }
            var meta = await MediaCache.GetMetaAsync(_cacheKey);
            var total = meta?.TotalSize ?? 0;
            var segs = new List<(double, double)>();
            foreach (var (s, e) in ranges)
            {
                var byteStart = s * 524288L;
                var byteEnd = Math.Min((e + 1) * 524288L, total);
                if (byteEnd <= byteStart) continue;
                if (_timeMap != null)
                    segs.Add((_timeMap.GetSyncTimeAtOrAfter(byteStart), _timeMap.MapTimeAt(byteEnd)));
                else if (total > 0 && _duration > 0)
                    segs.Add((byteStart / (double)total * _duration, byteEnd / (double)total * _duration));
            }
            _cachedSegments = segs;
        }
        catch { }
    }

    private void StartIdleTimer()
    {
        _idleTimer?.Dispose();
        _idleTimer = new Timer(_ =>
        {
            if (_disposed) return;
            if (!_isPaused && (DateTime.UtcNow - _lastActivity).TotalSeconds >= 3 && !_idle)
            {
                _idle = true;
                InvokeAsync(StateHasChanged);
            }
        }, null, 1000, 1000);
    }

    private async Task Close()
    {
        _cacheCts?.Cancel();
        _cachePollTimer?.Dispose();
        _cachePollTimer = null;
        _idleTimer?.Dispose();
        try { await JS.InvokeVoidAsync("videoPlayer.destroy"); } catch { }
        NavState.IsFullScreen = false;
        NavState.CurrentFileUrl = null;
        NavState.CurrentFileName = null;
        NavState.PageTitle = "NMU-CE & AIE";
        Navigation.NavigateTo($"recorded/{Uri.EscapeDataString(_group)}", replace: true);
    }

    private static string FormatTime(double t)
    {
        if (double.IsNaN(t) || double.IsInfinity(t) || t <= 0) return "0:00";
        var ts = TimeSpan.FromSeconds(t);
        return $"{(int)ts.TotalMinutes}:{ts.Seconds:D2}";
    }

    public void Dispose()
    {
        _disposed = true;
        _cacheCts?.Cancel();
        _cacheCts?.Dispose();
        _cachePollTimer?.Dispose();
        _idleTimer?.Dispose();
    }
}

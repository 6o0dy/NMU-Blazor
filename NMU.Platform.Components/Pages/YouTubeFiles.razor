@page "/youtube/{Channel}"
@using NMU.Platform.Components.Models
@implements IDisposable
@inject NavigationState NavState
@inject LayoutState LayoutState
@inject NavigationManager Navigation
@inject IJSRuntime JS
@inject YouTubeService YouTubeService

@if (_loading)
{
    <div class="loading-state">
        <i class="fas fa-circle-notch fa-spin fa-2x" style="color:var(--primary)"></i>
        <br /><br />Loading videos...
    </div>
}
else if (_channel == null)
{
    <div class="loading-state">
        Channel not found.
    </div>
}
else
{
    @* Same card design as the regular videos page. *@
    <div class="video-files">
        @if (_filteredVideos.Count == 0)
        {
            <div style="text-align:center; color:#94a3b8; padding:20px; grid-column: 1 / -1;">
                <span>No videos found.</span>
            </div>
        }
        @foreach (var vid in _filteredVideos)
        {
            var v = vid;
            <div class="video-card" @onclick="() => PlayVideo(v)">
                <img src="@v.Img" class="video-thumb" loading="lazy" onerror="nmuFunctions.ytImgFallback(this)" />
                <div class="video-info">
                    <div class="video-title" title="@v.Title">@v.Title</div>
                    <div class="video-meta">
                        <span class="badge badge-vid">VIDEO</span>
                        <span class="video-sub">@_channel?.ChannelName</span>
                    </div>
                </div>
                <div class="video-dl" @onclick:stopPropagation @onclick="() => OpenOnYoutube(v.Url)" title="Open in YouTube">
                    <i class="fa-brands fa-youtube"></i>
                </div>
            </div>
        }
    </div>
}

@code {
    [Parameter] public string Channel { get; set; } = "";

    private bool _loading = true;
    private YouTubeChannel? _channel;
    private List<YouTubeVideo> _filteredVideos = new();
    private string _searchQuery = "";

    // Single fragment instance (built once): identity comparison below
    // relies on it being the SAME delegate, not a fresh one per access.
    private RenderFragment? _searchBar;

    protected override void OnInitialized()
    {
        _searchBar = @<div class="files-search-fixed">
            <div class="search-wrapper">
                <i class="fa-solid fa-magnifying-glass search-icon-inside"></i>
                <input type="text" class="search-input" placeholder="Search in media..."
                       value="@_searchQuery"
                       @oninput="OnSearchInput" />
            </div>
        </div>;
    }

    protected override async Task OnInitializedAsync()
    {
        LayoutState.StateChanged += OnLayoutStateChanged;

        var decodedChannel = Uri.UnescapeDataString(Channel);
        var channels = await YouTubeService.GetChannelsAsync();
        _channel = channels.FirstOrDefault(c => c.GroupKey == decodedChannel);

        if (_channel != null)
        {
            NavState.PageTitle = _channel.ChannelName;
            _filteredVideos = _channel.Videos;
        }
        else
        {
            NavState.PageTitle = "YOUTUBE VIDEOS";
        }

        _loading = false;

        LayoutState.SearchBar = _searchBar;
        LayoutState.NotifyStateChanged();
    }

    protected override void OnAfterRender(bool firstRender)
    {
        // Self-heal: if this list is displayed without its search bar
        // (e.g. a lost layout notification on first/slow load), put it back.
        // Terminates: once assigned, the identity check below is true.
        if (!_loading && _channel != null && !ReferenceEquals(LayoutState.SearchBar, _searchBar))
        {
            LayoutState.SearchBar = _searchBar;
            LayoutState.NotifyStateChanged();
        }
    }

    private void OnSearchInput(ChangeEventArgs e)
    {
        _searchQuery = e.Value?.ToString() ?? "";
        ApplyFilter();
        LayoutState.SearchBar = _searchBar;
        LayoutState.NotifyStateChanged();
    }

    private void OnLayoutStateChanged() => StateHasChanged();

    private void ApplyFilter()
    {
        if (_channel == null) return;
        if (string.IsNullOrWhiteSpace(_searchQuery))
            _filteredVideos = _channel.Videos;
        else
        {
            var q = _searchQuery.ToLower();
            _filteredVideos = _channel.Videos
                .Where(v => v.Title.ToLower().Contains(q))
                .ToList();
        }
    }

    private void PlayVideo(YouTubeVideo video)
    {
        if (string.IsNullOrEmpty(video.VideoId)) return;
        NavState.YouTubeVideoTitle = video.Title;
        NavState.YouTubeVideoId = video.VideoId;
        var encodedId = Uri.EscapeDataString(video.VideoId);
        var encodedTitle = Uri.EscapeDataString(video.Title);
        Navigation.NavigateTo($"youtube/{Channel}/player?videoId={encodedId}&title={encodedTitle}", replace: true);
    }

    private void OpenOnYoutube(string url)
    {
        _ = JS.InvokeVoidAsync("nmuFunctions.openExternal", url);
    }

    public void Dispose()
    {
        LayoutState.StateChanged -= OnLayoutStateChanged;
        LayoutState.Clear();
    }
}

@page "/recorded"
@using NMU.Platform.Components.Models
@implements IDisposable
@inject RecordedService RecordedService
@inject MaterialsService MaterialsService
@inject StudentService StudentService
@inject NavigationManager Navigation
@inject NavigationState NavState
@inject LayoutState LayoutState
@inject IJSRuntime JS
@inject MediaCacheService MediaCache
@inject IPlatformService Platform

@if (_loading)
{
    <div class="loading-state">
        <i class="fas fa-circle-notch fa-spin fa-2x" style="color:var(--primary)"></i>
        <br /><br />Loading data...
    </div>
}
else if (_error)
{
    <div class="loading-state" style="color:#ef4444;">
        Failed to connect to server.
        <br /><br />
        <button class="placeholder-btn" @onclick="Reload">Retry</button>
    </div>
}
else
{
    <div class="recorded-container">
        <div class="page-heading">
            <h2>🎥 Recorded Lectures</h2>
            @if (_customMode)
            {
                <span class="code-tag">Custom • @_groupsInfo.Count groups</span>
            }
            else
            {
                <span class="code-tag">@_studentLevel.Replace("_", " ") • @_studentSemester.Replace("_", " ")</span>
            }
        </div>

        <div class="cards-grid">
            @for (int i = 0; i < _groupsInfo.Count; i++)
            {
                var g = _groupsInfo[i];
                var icon = RecordedService.GetIconClass((g.DisplayName ?? g.Name) + " " + g.Code);
                var style = MaterialsService.GetMaterialStyle(((string.IsNullOrEmpty(g.DisplayName) ? g.Name : g.DisplayName)) + " " + g.Code);
                var title = string.IsNullOrEmpty(g.DisplayName) ? g.Name.Replace("_", " ") : g.DisplayName;
                var line = GetGroupLine(g.Name);
                var offlineCount = _offlineCounts.TryGetValue(g.Name, out var oc) ? oc : 0;
                var lecList = _groupLecturers.TryGetValue(g.Name, out var gl) ? gl : new List<string>();
                <div class="dev-card mat-card" @onclick="() => OpenGroupAsync(g.Name)">
                    <div class="dev-card-top">
                        <span class="dev-card-icon @style.colorClass"><i class="@icon"></i></span>
                        @if (!string.IsNullOrEmpty(g.Code))
                        {
                            <span class="badge badge-sky mat-code">@g.Code</span>
                        }
                    </div>
                    <div class="dev-card-title mat-title" title="@title">@title</div>
                    <div class="dev-card-desc mat-sub" title="@line">
                        @if (lecList.Count == 0)
                        {
                            @line
                        }
                        else
                        {
                            @foreach (var l in lecList)
                            {
                                <span class="lec-chip" title="@l">@l</span>
                            }
                        }
                        @if (offlineCount > 0)
                        {
                            <span class="lec-chip lec-chip-off">✓ @offlineCount</span>
                        }
                    </div>
                    <button class="btn-outlined mat-open" @onclick="() => OpenGroupAsync(g.Name)" @onclick:stopPropagation>View Recordings ➔</button>
                </div>
            }
            @if (_groupsInfo.Count == 0)
            {
                <div style="color:var(--text-secondary); text-align:center; grid-column:1/-1; padding-top:50px;">
                    No recorded lectures available yet.
                </div>
            }
        </div>
    </div>
}

@if (_dialogOpen)
{
    <div class="subject-picker-overlay" @onclick="CloseLecturerDialog">
        <div class="subject-picker-card" @onclick:stopPropagation>
            <div class="subject-picker-header">
                <button class="btn-small-icon" @onclick="CloseLecturerDialog">&times;</button>
                <h3>Select Lecturer</h3>
            </div>
            <div class="subject-picker-body">
                @foreach (var lec in _dialogLecturers)
                {
                    var l = lec;
                    var split = RecordedService.SplitLecturerTag(l);
                    <div class="subject-check-card lec-pick" @onclick="() => PickDialogLecturer(l)">
                        <span class="subject-check-name" title="@l">@split.Name</span>
                        @if (!string.IsNullOrEmpty(split.Tag))
                        {
                            <span class="badge badge-sky lec-tag">@split.Tag</span>
                        }
                        <i class="fa-solid fa-chevron-right" style="color:var(--text-secondary);font-size:12px;"></i>
                    </div>
                }
            </div>
        </div>
    </div>
}

@code {
    private bool _loading = true;
    private bool _error;
    private List<RecordedGroupInfo> _groupsInfo = new();
    private string _studentLevel = "Level_1";
    private string _studentSemester = "First_Term";
    private string _studentDept = "ALL";
    private bool _customMode;
    private Dictionary<string, List<string>> _groupLecturers = new(StringComparer.OrdinalIgnoreCase);
    private Dictionary<string, int> _offlineCounts = new(StringComparer.OrdinalIgnoreCase);
    private List<RecordedFile> _allFiles = new();
    private Dictionary<string, List<string>> _customGroupLecturers = new(StringComparer.OrdinalIgnoreCase);
    private bool _dialogOpen;
    private string _dialogGroup = "";
    private List<string> _dialogLecturers = new();

    protected override async Task OnInitializedAsync()
    {
        NavState.PageTitle = "RECORDED LECTURER";
        LayoutState.RefreshRequested += OnRefreshRequested;
        // Return immediately so the router paints the page (loading state); all data
        // loading happens in the background, same as the materials page.
        _ = LoadDataAsync();
    }

    private async Task LoadDataAsync()
    {
        try
        {
            var student = await StudentService.GetStudentAsync();
            if (student != null)
            {
                _studentLevel = student.AcademicLevel.Replace(" ", "_");
                _studentSemester = student.Semester.Replace(" ", "_");
                _studentDept = NMU.Platform.Components.Services.ArchiveCatalog.NormalizeDepartment(student.Department);
            }

            // Custom subjects mode: only show groups that belong to selected subjects,
            // collecting from every level/semester the student registered in.
            if (student?.CustomSubjectsMode == true && student.CustomSubjects != null && student.CustomSubjects.Count > 0)
            {
                _customMode = true;
                _groupsInfo = await BuildCustomGroupsAsync(student.CustomSubjects);
                _loading = false;
                await InvokeAsync(StateHasChanged);
                return;
            }

            // Fast path: render from the small cached group list (name + count), so
            // the page paints immediately instead of waiting on the full archive list.
            _groupsInfo = await RecordedService.GetCachedGroupsInfoAsync(_studentLevel, _studentSemester);
            if (_groupsInfo.Count == 0)
                _groupsInfo = await RecordedService.GetGroupsInfoAsync(_studentLevel, _studentSemester);

            _groupsInfo = _groupsInfo.Where(g => NMU.Platform.Components.Services.ArchiveCatalog.IsVisibleForDepartment(g.Branch, _studentDept)).ToList();
            _loading = false;
            await InvokeAsync(StateHasChanged);

            // Background: lecturer names + offline counts per subject.
            _ = RefreshDetailsAsync();

            // Background revalidation: pick up newly added lectures without a cache clear.
            _ = RecordedService.CheckAndUpdateRecordedAsync(_studentLevel, _studentSemester, updated =>
            {
                _groupsInfo = updated.Where(g => NMU.Platform.Components.Services.ArchiveCatalog.IsVisibleForDepartment(g.Branch, _studentDept)).ToList();
                _ = InvokeAsync(StateHasChanged);
            });
        }
        catch
        {
            _error = true;
            _loading = false;
        }
        await InvokeAsync(StateHasChanged);
    }

    private async Task<List<RecordedGroupInfo>> BuildCustomGroupsAsync(List<CustomSubjectSelection> selections)
    {
        var result = new List<RecordedGroupInfo>();
        var seen = new HashSet<string>(StringComparer.OrdinalIgnoreCase);
        var lecMap = new Dictionary<string, List<string>>(StringComparer.OrdinalIgnoreCase);
        var fullMap = new Dictionary<string, List<string>>(StringComparer.OrdinalIgnoreCase);

        foreach (var group in selections.GroupBy(s => (s.Level, s.Semester)))
        {
            var files = await RecordedService.GetFilesAsync(group.Key.Level, group.Key.Semester);
            var groups = RecordedService.GetGroups(files, group.Key.Level, group.Key.Semester);
            var selectedNames = group.Select(s => s.Subject).ToList();

            foreach (var g in groups)
            {
                var keep = selectedNames.Any(sName => SubjectMatcher.Matches(sName, g));
                if (!keep) continue;
                if (seen.Add(g))
                {
                    var lecs = RecordedService.GetLecturersForGroup(files, group.Key.Level, group.Key.Semester, g);
                    fullMap[g] = lecs;
                    lecMap[g] = lecs;
                    result.Add(new RecordedGroupInfo
                    {
                        Name = g,
                        Count = RecordedService.GetFilesForGroup(files, group.Key.Level, group.Key.Semester, g).Count
                    });
                }
            }
        }

        _groupLecturers = lecMap;
        _customGroupLecturers = fullMap;
        return result;
    }

    private string GetGroupLine(string groupFull)
    {
        if (_groupLecturers.TryGetValue(groupFull, out var list) && list.Count > 0)
            return string.Join(", ", list);
        return "Recorded lectures";
    }

    private void RebuildLecturerMap(List<RecordedFile> files)
    {
        var map = new Dictionary<string, List<string>>(StringComparer.OrdinalIgnoreCase);
        foreach (var f in files)
        {
            RecordedService.ParseRecordedPath(f.Name, out var subj, out var lec);
            if (string.IsNullOrEmpty(subj)) subj = f.SubjectFullName;
            if (string.IsNullOrEmpty(subj)) continue;
            var lecturer = !string.IsNullOrEmpty(lec) ? lec : f.Lecturer;
            if (string.IsNullOrWhiteSpace(lecturer)) continue;
            if (!map.TryGetValue(subj, out var list)) { list = new List<string>(); map[subj] = list; }
            if (!list.Contains(lecturer, StringComparer.Ordinal)) list.Add(lecturer);
        }
        _groupLecturers = map;
    }

    private string ResolveUrl(RecordedFile file)
    {
        if (!string.IsNullOrEmpty(file.ArchiveId))
            return NMU.Platform.Components.Services.ArchiveCatalog.GetDownloadUrl(file.ArchiveId, file.Name);
        return RecordedService.GetDownloadUrl(file.Name, _studentLevel, _studentSemester);
    }

    private async Task RefreshDetailsAsync()
    {
        try
        {
            var files = await RecordedService.GetFilesAsync(_studentLevel, _studentSemester);
            _allFiles = files;
            RebuildLecturerMap(files);

            // Offline video counts (native only; web streams without a media cache).
            if (!Platform.IsWeb)
            {
                var counts = new Dictionary<string, int>(StringComparer.OrdinalIgnoreCase);
                foreach (var f in files)
                {
                    RecordedService.ParseRecordedPath(f.Name, out var subj, out _);
                    if (string.IsNullOrEmpty(subj)) subj = f.SubjectFullName;
                    if (string.IsNullOrEmpty(subj)) continue;
                    var key = MediaCache.GetCacheKey(ResolveUrl(f));
                    if (await MediaCache.IsCompleteAsync(key))
                    {
                        counts.TryGetValue(subj, out var c);
                        counts[subj] = c + 1;
                    }
                }
                _offlineCounts = counts;
            }

            await InvokeAsync(StateHasChanged);
        }
        catch { }
    }

    private void Reload()
    {
        _error = false;
        _loading = true;
        StateHasChanged();
        _ = LoadDataAsync();
    }

    private async Task OpenGroupAsync(string group)
    {
        try
        {
            List<string> lecturers;
            if (_customMode && _customGroupLecturers.TryGetValue(group, out var full))
            {
                lecturers = full;
            }
            else
            {
                if (_allFiles.Count == 0)
                {
                    _allFiles = await RecordedService.GetFilesAsync(_studentLevel, _studentSemester);
                    RebuildLecturerMap(_allFiles);
                    await InvokeAsync(StateHasChanged);
                }
                lecturers = RecordedService.GetFilesForGroup(_allFiles, _studentLevel, _studentSemester, group)
                    .Select(f => f.Lecturer)
                    .Where(l => !string.IsNullOrWhiteSpace(l))
                    .Distinct(StringComparer.Ordinal)
                    .OrderBy(l => l, StringComparer.OrdinalIgnoreCase)
                    .ToList();
            }

            // Multiple lecturers: choose first on this page, navigate after.
            if (lecturers.Count > 1)
            {
                _dialogGroup = group;
                _dialogLecturers = lecturers;
                _dialogOpen = true;
                await InvokeAsync(StateHasChanged);
                return;
            }

            NavigateToGroup(group, lecturers.Count == 1 ? lecturers[0] : null);
        }
        catch
        {
            NavigateToGroup(group, null);
        }
    }

    private void NavigateToGroup(string group, string? lecturer)
    {
        _dialogOpen = false;
        var url = $"recorded/{Uri.EscapeDataString(group)}";
        if (!string.IsNullOrEmpty(lecturer))
            url += $"?lecturer={Uri.EscapeDataString(lecturer)}";
        Navigation.NavigateTo(url, replace: true);
    }

    private void PickDialogLecturer(string lecturer) => NavigateToGroup(_dialogGroup, lecturer);

    private void CloseLecturerDialog() => _dialogOpen = false;

    private void OnRefreshRequested() => Reload();

    public void Dispose()
    {
        LayoutState.RefreshRequested -= OnRefreshRequested;
    }
}

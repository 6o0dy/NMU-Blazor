@page "/materials"
@using NMU.Platform.Components.Models
@implements IDisposable
@inject MaterialsService MaterialsService
@inject StudentService StudentService
@inject NavigationManager Navigation
@inject NavigationState NavState
@inject LayoutState LayoutState
@inject IJSRuntime JS

@if (_loading)
{
    <div class="loading-state">
        <i class="fas fa-circle-notch fa-spin fa-2x" style="color:var(--primary)"></i>
        <br /><br />Loading data...
    </div>
}
else if (_error)
{
    <div class="loading-state" style="color:var(--wrong);">
        Failed to connect to server.
        <br /><br />
        <button class="placeholder-btn" @onclick="Reload">Retry</button>
    </div>
}
else
{
    <div class="materials-container">
<div class="page-heading">
            <h2>📚 Study Materials</h2>
            @if (_customMode)
            {
                <span class="code-tag">Custom • @_subjects.Count subjects</span>
            }
            else
            {
                <span class="code-tag">@_studentLevel.Replace("_", " ") • @_studentSemester.Replace("_", " ")</span>
            }
        </div>

        <div class="cards-grid">
            @for (int i = 0; i < _subjects.Count; i++)
            {
                var sub = _subjects[i];
                var style = MaterialsService.GetMaterialStyle(sub.DisplayName + " " + sub.Code);
                var subjectName = string.IsNullOrEmpty(sub.DisplayName) ? sub.Name.Replace("_", " ") : sub.DisplayName;
                var offlineCount = _offlineCounts.TryGetValue(sub.Name, out var oc) ? oc : 0;
                var subLine = GetSubjectLine(sub.Name);
                <div class="dev-card mat-card" @onclick="() => OpenSubject(sub.Name)">
                    <div class="dev-card-top">
                        <span class="dev-card-icon @style.colorClass"><i class="@style.icon"></i></span>
                        @if (!string.IsNullOrEmpty(sub.Code))
                        {
                            <span class="badge badge-sky mat-code">@sub.Code</span>
                        }
                    </div>
                    <div class="dev-card-title mat-title" title="@subjectName">@subjectName</div>
                    <div class="dev-card-desc mat-sub" title="@subLine">
                        @subLine
                        @if (offlineCount > 0)
                        {
                            <span class="mat-offline"> • ✓ @offlineCount Offline</span>
                        }
                    </div>
                    <button class="btn-outlined mat-open" @onclick="() => OpenSubject(sub.Name)" @onclick:stopPropagation>Open Files ➔</button>
                </div>
            }
            @if (_noData)
            {
                <div style="color:var(--text-secondary); text-align:center; grid-column:1/-1; padding-top:50px;">
                    No study materials available yet.
                    <br /><br />
                    <small style="opacity:.6;">
                        Searching in: @(_archiveId ?? "—") — files found: @_allFiles.Count
                        @(_semesterHint)
                    </small>
                </div>
            }
        </div>
    </div>
}

@code {
    private string? _archiveId;

    private bool _loading = true;
    private bool _error;
    private bool _noData;
    private List<MaterialSubjectInfo> _subjects = new();
    private Dictionary<string, string> _subjectSources = new();
    private List<ArchiveFile> _allFiles = new();
    private HashSet<string> _cachedPdfKeys = new();
    private Dictionary<string, int> _offlineCounts = new(StringComparer.OrdinalIgnoreCase);
    private string _studentLevel = "Level_1";
    private string _studentSemester = "First_Term";
    private string _studentDept = "ALL";
    private bool _customMode;

    private string _semesterHint
    {
        get
        {
            if (_studentSemester.Contains("First_Term"))
                return "— Hint: the archive uses \"Semester_1\"/\"Semester_2\". Make sure you picked the semester in setup.";
            return "";
        }
    }

    protected override async Task OnInitializedAsync()
    {
        NavState.PageTitle = "MATERIALS";
        LayoutState.RefreshRequested += OnRefreshRequested;
        // Return immediately so the router paints the page (loading state) without
        // freezing the current page; all data loading happens in the background.
        _ = LoadDataAsync();
    }

    private async Task LoadDataAsync()
    {
        try
        {
            var student = await StudentService.GetStudentAsync();
            if (student != null)
            {
                _studentLevel = student.AcademicLevel.Replace(" ", "_");
                _studentSemester = student.Semester.Replace(" ", "_");
                _studentDept = NMU.Platform.Components.Services.ArchiveCatalog.NormalizeDepartment(student.Department);
            }
            _archiveId = NMU.Platform.Components.Services.ArchiveCatalog.GetArchiveId(_studentLevel, _studentSemester);

            // Custom subjects mode: only show the subjects the student registered in,
            // each pinned to its own level/semester (credit-hours system).
            if (student?.CustomSubjectsMode == true && student.CustomSubjects != null && student.CustomSubjects.Count > 0)
            {
                _customMode = true;
                _subjects = student.CustomSubjects
                    .Select(s => new MaterialSubjectInfo { Name = s.Subject, FileCount = 0 })
                    .GroupBy(s => s.Name, StringComparer.OrdinalIgnoreCase)
                    .Select(g => g.First())
                    .ToList();
                _subjectSources = student.CustomSubjects
                    .GroupBy(s => s.Subject, StringComparer.OrdinalIgnoreCase)
                    .ToDictionary(g => g.First().Subject,
                                  g => $"{g.First().Level.Replace("_", " ")} • {g.First().Semester.Replace("_", " ")}",
                                  StringComparer.OrdinalIgnoreCase);
                _noData = _subjects.Count == 0;
                _loading = false;
                await InvokeAsync(StateHasChanged);
                return;
            }

            // Fast path: render from the small cached subject list (same as the quiz page),
            // so the page paints immediately instead of waiting on the full archive list.
            _subjects = await MaterialsService.GetCachedSubjectsInfoAsync(_studentLevel, _studentSemester);
            if (_subjects.Count == 0)
                _subjects = await MaterialsService.GetSubjectsInfoAsync(_studentLevel, _studentSemester);

            _subjects = FilterByDepartment(_subjects);
            _noData = _subjects.Count == 0;
            _loading = false;
            await InvokeAsync(StateHasChanged);

            // Background: load the full file list + cached PDF keys to refresh offline badges.
            _ = RefreshDetailsAsync();

            // Background revalidation (HEAD request), same as the quiz page.
            _ = MaterialsService.CheckAndUpdateMaterialsAsync(_studentLevel, _studentSemester,
                async subjects =>
                {
                    await InvokeAsync(() =>
                    {
                        _subjects = FilterByDepartment(subjects);
                        _noData = _subjects.Count == 0;
                        RefreshOfflineBadges();
                    });
                });
        }
        catch
        {
            _error = true;
            _loading = false;
            await InvokeAsync(StateHasChanged);
        }
    }

    private async Task RefreshDetailsAsync()
    {
        try
        {
            var filesTask = MaterialsService.GetFilesAsync(_studentLevel, _studentSemester);
            try
            {
                var keys = await JS.InvokeAsync<string[]>("nmuFunctions.getCachedPdfKeys");
                _cachedPdfKeys = new HashSet<string>(keys ?? Array.Empty<string>(), StringComparer.Ordinal);
            }
            catch { _cachedPdfKeys = new HashSet<string>(); }

            _allFiles = await filesTask;
            RebuildLecturerMap();
            await InvokeAsync(() =>
            {
                RefreshOfflineBadges();
                StateHasChanged();
            });
        }
        catch { }
    }

    private void RefreshOfflineBadges()
    {
        var counts = new Dictionary<string, int>(StringComparer.OrdinalIgnoreCase);
        // Single pass over the file list: compute the cache key once per file
        // and count how many files per subject are available offline.
        foreach (var f in _allFiles)
        {
            if (f.Name.ToLowerInvariant().EndsWith("_text.pdf")) continue;
            var url = NMU.Platform.Components.Services.ArchiveCatalog.GetArchiveId(_studentLevel, _studentSemester) is string aid
                ? NMU.Platform.Components.Services.ArchiveCatalog.GetDownloadUrl(aid, f.Name)
                : f.Name;
            if (_cachedPdfKeys.Contains(GetPdfCacheKey(url)))
            {
                var subj = SubjectOf(f.Name);
                counts.TryGetValue(subj, out var c);
                counts[subj] = c + 1;
            }
        }
        _offlineCounts = counts;
    }

    private Dictionary<string, string> _subjectLecturers = new(StringComparer.OrdinalIgnoreCase);

    private string GetSubjectLine(string subjectFull)
    {
        if (_customMode && _subjectSources.TryGetValue(subjectFull, out var src))
            return src.Replace("_", " ");
        if (_subjectLecturers.TryGetValue(subjectFull, out var lec) && !string.IsNullOrEmpty(lec))
            return lec;
        return "PDF study materials";
    }

    private void RebuildLecturerMap()
    {
        var map = new Dictionary<string, List<string>>(StringComparer.OrdinalIgnoreCase);
        foreach (var f in _allFiles)
        {
            if (!f.Name.StartsWith("Data/", StringComparison.Ordinal)) continue;
            var segs = f.Name.Split('/');
            if (segs.Length < 2) continue;
            var subject = segs[1];
            string? lec = null;
            var pdfIdx = Array.FindIndex(segs, s => s.Equals("PDFs", StringComparison.OrdinalIgnoreCase));
            if (pdfIdx >= 0 && pdfIdx + 1 < segs.Length) lec = segs[pdfIdx + 1];
            if (string.IsNullOrWhiteSpace(lec)) continue;
            if (!map.TryGetValue(subject, out var list)) { list = new List<string>(); map[subject] = list; }
            if (!list.Contains(lec, StringComparer.Ordinal)) list.Add(lec);
        }
        _subjectLecturers = map.ToDictionary(
            kv => kv.Key,
            kv => kv.Value.Count == 1 ? kv.Value[0] : $"{kv.Value[0]} +{kv.Value.Count - 1}",
            StringComparer.OrdinalIgnoreCase);
    }

    private List<MaterialSubjectInfo> FilterByDepartment(List<MaterialSubjectInfo> list)
    {
        return list.Where(s => NMU.Platform.Components.Services.ArchiveCatalog.IsVisibleForDepartment(s.Branch, _studentDept)).ToList();
    }

    private string SubjectOf(string fileName)
    {
        // New layout: Data/{Subject}/PDFs/...
        if (!fileName.StartsWith("Data/", StringComparison.Ordinal)) return "";
        var segs = fileName.Split('/');
        return segs.Length >= 2 ? segs[1] : "";
    }

    private void Reload()
    {
        _error = false;
        _loading = true;
        StateHasChanged();
        _ = LoadDataAsync();
    }

    private void OpenSubject(string subject)
    {
        Navigation.NavigateTo($"materials/{Uri.EscapeDataString(subject)}", replace: true);
    }

    private static string GetPdfCacheKey(string fileUrl)
    {
        if (string.IsNullOrEmpty(fileUrl)) return "";
        var hash = Convert.ToHexString(System.Security.Cryptography.SHA256.HashData(System.Text.Encoding.UTF8.GetBytes(fileUrl)))[..16];
        return $"pdf_{hash}";
    }

    private void OnRefreshRequested() => Reload();

    public void Dispose()
    {
        LayoutState.RefreshRequested -= OnRefreshRequested;
    }
}
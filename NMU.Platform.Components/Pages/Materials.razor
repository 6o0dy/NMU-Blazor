@page "/materials"
@using NMU.Platform.Components.Models
@implements IDisposable
@inject MaterialsService MaterialsService
@inject StudentService StudentService
@inject NavigationManager Navigation
@inject NavigationState NavState
@inject LayoutState LayoutState
@inject IJSRuntime JS

@if (_loading)
{
    <div class="loading-state">
        <i class="fas fa-circle-notch fa-spin fa-2x" style="color:var(--primary)"></i>
        <br /><br />Loading data...
    </div>
}
else if (_error)
{
    <div class="loading-state" style="color:var(--wrong);">
        Failed to connect to server.
        <br /><br />
        <button class="placeholder-btn" @onclick="Reload">Retry</button>
    </div>
}
else
{
    <div class="materials-container">
<div class="page-heading">
            <h2>📚 Study Materials</h2>
            @if (_customMode)
            {
                <span class="code-tag">Custom • @_subjects.Count subjects</span>
            }
            else
            {
                <span class="code-tag">@_studentLevel.Replace("_", " ") • @_studentSemester.Replace("_", " ")</span>
            }
        </div>

        <div class="cards-grid">
            @for (int i = 0; i < _subjects.Count; i++)
            {
                var sub = _subjects[i];
                var subjectName = string.IsNullOrEmpty(sub.DisplayName) ? sub.Name.Replace("_", " ") : sub.DisplayName;
                var style = SubjectIcons.Resolve(sub.Code, subjectName);
                var offlineCount = _offlineCounts.TryGetValue(sub.Name, out var oc) ? oc : 0;
                var subLine = GetSubjectLine(sub.Name);
                var lecList = _subjectLecturers.TryGetValue(sub.Name, out var ll) ? ll : new List<string>();
                <div class="dev-card mat-card" @onclick="() => OpenSubject(sub.Name)">
                    <div class="dev-card-top">
                        <span class="dev-card-icon @style.ColorClass"><i class="@style.Icon"></i></span>
                        @if (!string.IsNullOrEmpty(sub.Code))
                        {
                            <span class="badge badge-sky mat-code">@sub.Code</span>
                        }
                    </div>
                    <div class="dev-card-title mat-title" title="@subjectName">@subjectName</div>
                    <div class="dev-card-desc mat-sub" title="@subLine">
                        @if (lecList.Count == 0)
                        {
                            @subLine
                        }
                        else
                        {
                            @foreach (var l in lecList)
                            {
                                <span class="lec-chip" title="@l">@l</span>
                            }
                        }
                        @if (offlineCount > 0)
                        {
                            <span class="lec-chip lec-chip-off">✓ @offlineCount</span>
                        }
                    </div>
                    <button class="btn-outlined mat-open" @onclick="() => OpenSubject(sub.Name)" @onclick:stopPropagation>Open Files ➔</button>
                </div>
            }
            @if (_noData)
            {
                <div style="color:var(--text-secondary); text-align:center; grid-column:1/-1; padding-top:50px;">
                    No study materials available yet.
                    <br /><br />
                    <small style="opacity:.6;">
                        Searching in: @(_archiveId ?? "—") — files found: @_allFiles.Count
                        @(_semesterHint)
                    </small>
                </div>
            }
        </div>
    </div>
}

@if (_dialogOpen)
{
    <div class="subject-picker-overlay" @onclick="CloseLecturerDialog">
        <div class="subject-picker-card" @onclick:stopPropagation>
            <div class="subject-picker-header">
                <button class="btn-small-icon" @onclick="CloseLecturerDialog">&times;</button>
                <h3>Select Lecturer</h3>
            </div>
            <div class="subject-picker-body">
                @foreach (var lec in _dialogLecturers)
                {
                    var l = lec;
                    var split = NMU.Platform.Components.Services.RecordedService.SplitLecturerTag(l);
                    var clean = string.IsNullOrEmpty(split.Name) ? l : split.Name;
                    <div class="subject-check-card lec-pick" @onclick="() => PickDialogLecturer(l)">
                        <span class="subject-check-name" title="@l">@clean</span>
                        @if (!string.IsNullOrEmpty(split.Tag))
                        {
                            <span class="badge badge-sky lec-tag">@split.Tag</span>
                        }
                        <i class="fa-solid fa-chevron-right" style="color:var(--text-secondary);font-size:12px;"></i>
                    </div>
                }
            </div>
        </div>
    </div>
}

@code {
    private string? _archiveId;

    private bool _loading = true;
    private bool _error;
    private bool _noData;
    private List<MaterialSubjectInfo> _subjects = new();
    private Dictionary<string, string> _subjectSources = new();
    private List<ArchiveFile> _allFiles = new();
    private HashSet<string> _cachedPdfKeys = new();
    private Dictionary<string, int> _offlineCounts = new(StringComparer.OrdinalIgnoreCase);
    private string _studentLevel = "Level_1";
    private string _studentSemester = "First_Term";
    private string _studentDept = "ALL";
    private bool _customMode;
    private List<CustomSubjectSelection> _customSelections = new();
    private bool _dialogOpen;
    private string _dialogSubject = "";
    private List<string> _dialogLecturers = new();

    private string _semesterHint
    {
        get
        {
            if (_studentSemester.Contains("First_Term"))
                return "— Hint: the archive uses \"Semester_1\"/\"Semester_2\". Make sure you picked the semester in setup.";
            return "";
        }
    }

    protected override async Task OnInitializedAsync()
    {
        NavState.PageTitle = "MATERIALS";
        LayoutState.RefreshRequested += OnRefreshRequested;
        // Return immediately so the router paints the page (loading state) without
        // freezing the current page; all data loading happens in the background.
        _ = LoadDataAsync();
    }

    private async Task LoadDataAsync()
    {
        try
        {
            var student = await StudentService.GetStudentAsync();
            if (student != null)
            {
                _studentLevel = student.AcademicLevel.Replace(" ", "_");
                _studentSemester = student.Semester.Replace(" ", "_");
                _studentDept = NMU.Platform.Components.Services.ArchiveCatalog.NormalizeDepartment(student.Department);
            }
            _archiveId = NMU.Platform.Components.Services.ArchiveCatalog.GetArchiveId(_studentLevel, _studentSemester);

            // Custom subjects mode: only show the subjects the student registered in,
            // each pinned to its own level/semester (credit-hours system).
            if (student?.CustomSubjectsMode == true && student.CustomSubjects != null && student.CustomSubjects.Count > 0)
            {
                _customMode = true;
                _customSelections = student.CustomSubjects
                    .GroupBy(s => s.Subject, StringComparer.OrdinalIgnoreCase)
                    .Select(g => g.First())
                    .ToList();
                _subjects = _customSelections
                    .Select(s =>
                    {
                        // Parse "CSE014 - Structured Programming.(ALL)" like the normal
                        // path does, so cards get the same icon, code badge and title.
                        NMU.Platform.Components.Services.ArchiveCatalog.ParseSubjectFolder(
                            s.Subject, out var code, out var clean, out var branch);
                        return new MaterialSubjectInfo
                        {
                            Name = s.Subject,
                            Code = code,
                            DisplayName = clean,
                            Branch = branch,
                            FileCount = 0
                        };
                    })
                    .ToList();
                _subjectSources = _customSelections
                    .ToDictionary(s => s.Subject,
                                  s => $"{s.Level.Replace("_", " ")} • {s.Semester.Replace("_", " ")}",
                                  StringComparer.OrdinalIgnoreCase);
                _noData = _subjects.Count == 0;
                _loading = false;
                await InvokeAsync(StateHasChanged);
                // Background: lecturers + offline badges per subject's own archive.
                _ = RefreshCustomDetailsAsync();
                return;
            }

            // Fast path: render from the small cached subject list (same as the quiz page),
            // so the page paints immediately instead of waiting on the full archive list.
            _subjects = await MaterialsService.GetCachedSubjectsInfoAsync(_studentLevel, _studentSemester);
            if (_subjects.Count == 0)
                _subjects = await MaterialsService.GetSubjectsInfoAsync(_studentLevel, _studentSemester);

            _subjects = FilterByDepartment(_subjects);
            _noData = _subjects.Count == 0;
            _loading = false;
            await InvokeAsync(StateHasChanged);

            // Background: load the full file list + cached PDF keys to refresh offline badges.
            _ = RefreshDetailsAsync();

            // Background revalidation (HEAD request), same as the quiz page.
            _ = MaterialsService.CheckAndUpdateMaterialsAsync(_studentLevel, _studentSemester,
                async subjects =>
                {
                    await InvokeAsync(() =>
                    {
                        _subjects = FilterByDepartment(subjects);
                        _noData = _subjects.Count == 0;
                        RefreshOfflineBadges();
                        StateHasChanged();
                    });
                });
        }
        catch
        {
            _error = true;
            _loading = false;
            await InvokeAsync(StateHasChanged);
        }
    }

    private async Task RefreshDetailsAsync()
    {
        try
        {
            var filesTask = MaterialsService.GetFilesAsync(_studentLevel, _studentSemester);
            try
            {
                var keys = await JS.InvokeAsync<string[]>("nmuFunctions.getCachedPdfKeys");
                _cachedPdfKeys = new HashSet<string>(keys ?? Array.Empty<string>(), StringComparer.Ordinal);
            }
            catch { _cachedPdfKeys = new HashSet<string>(); }

            _allFiles = await filesTask;
            RebuildLecturerMap();
            await InvokeAsync(() =>
            {
                RefreshOfflineBadges();
                StateHasChanged();
            });
        }
        catch { }
    }

    private void RefreshOfflineBadges()
    {
        var counts = new Dictionary<string, int>(StringComparer.OrdinalIgnoreCase);
        // Single pass over the file list: compute the cache key once per file
        // and count how many files per subject are available offline.
        foreach (var f in _allFiles)
        {
            if (f.Name.ToLowerInvariant().EndsWith("_text.pdf")) continue;
            var url = NMU.Platform.Components.Services.ArchiveCatalog.GetArchiveId(_studentLevel, _studentSemester) is string aid
                ? NMU.Platform.Components.Services.ArchiveCatalog.GetDownloadUrl(aid, f.Name)
                : f.Name;
            if (_cachedPdfKeys.Contains(GetPdfCacheKey(url)))
            {
                var subj = SubjectOf(f.Name);
                counts.TryGetValue(subj, out var c);
                counts[subj] = c + 1;
            }
        }
        _offlineCounts = counts;
    }

    private Dictionary<string, List<string>> _subjectLecturers = new(StringComparer.OrdinalIgnoreCase);

    private string GetSubjectLine(string subjectFull)
    {
        if (_customMode && _subjectSources.TryGetValue(subjectFull, out var src))
            return src.Replace("_", " ");
        if (_subjectLecturers.TryGetValue(subjectFull, out var list) && list.Count > 0)
            return string.Join(", ", list);
        return "PDF study materials";
    }

    private void RebuildLecturerMap()
    {
        var map = new Dictionary<string, List<string>>(StringComparer.OrdinalIgnoreCase);
        foreach (var f in _allFiles)
        {
            if (!f.Name.StartsWith("Data/", StringComparison.Ordinal)) continue;
            var segs = f.Name.Split('/');
            if (segs.Length < 2) continue;
            var subject = segs[1];
            string? lec = null;
            var pdfIdx = Array.FindIndex(segs, s => s.Equals("PDFs", StringComparison.OrdinalIgnoreCase));
            if (pdfIdx >= 0 && pdfIdx + 1 < segs.Length) lec = segs[pdfIdx + 1];
            if (string.IsNullOrWhiteSpace(lec)) continue;
            if (!map.TryGetValue(subject, out var list)) { list = new List<string>(); map[subject] = list; }
            if (!list.Contains(lec, StringComparer.Ordinal)) list.Add(lec);
        }
        _subjectLecturers = map;
    }

    /// <summary>
    /// Custom mode background pass: each subject lives in its own archive, so
    /// load every involved archive once, then build lecturer chips + offline
    /// badges per subject (same look as the normal mode).
    /// </summary>
    private async Task RefreshCustomDetailsAsync()
    {
        try
        {
            var pairs = _customSelections
                .Select(s => (s.Level, s.Semester))
                .Distinct()
                .ToList();
            var filesByArchive = new Dictionary<string, List<ArchiveFile>>(StringComparer.Ordinal);
            var archiveIds = new Dictionary<string, string>(StringComparer.Ordinal);
            foreach (var (level, semester) in pairs)
            {
                var files = await MaterialsService.GetFilesAsync(level, semester);
                var key = $"{level}|{semester}";
                filesByArchive[key] = files;
                var aid = NMU.Platform.Components.Services.ArchiveCatalog.GetArchiveId(level, semester);
                if (aid != null) archiveIds[key] = aid;
            }

            var lecMap = new Dictionary<string, List<string>>(StringComparer.OrdinalIgnoreCase);
            foreach (var sub in _subjects)
            {
                var sel = _customSelections.FirstOrDefault(c =>
                    string.Equals(c.Subject, sub.Name, StringComparison.OrdinalIgnoreCase));
                if (sel == null) continue;
                if (!filesByArchive.TryGetValue($"{sel.Level}|{sel.Semester}", out var files)) continue;
                var lecturers = MaterialsService.GetLecturersForSubject(files, sub.Name);
                if (lecturers.Count > 0) lecMap[sub.Name] = lecturers;
            }

            HashSet<string> cachedKeys;
            try
            {
                var keys = await JS.InvokeAsync<string[]>("nmuFunctions.getCachedPdfKeys");
                cachedKeys = new HashSet<string>(keys ?? Array.Empty<string>(), StringComparer.Ordinal);
            }
            catch { cachedKeys = new HashSet<string>(); }

            var counts = new Dictionary<string, int>(StringComparer.OrdinalIgnoreCase);
            foreach (var sub in _subjects)
            {
                var sel = _customSelections.FirstOrDefault(c =>
                    string.Equals(c.Subject, sub.Name, StringComparison.OrdinalIgnoreCase));
                if (sel == null) continue;
                var akey = $"{sel.Level}|{sel.Semester}";
                if (!filesByArchive.TryGetValue(akey, out var files)) continue;
                if (!archiveIds.TryGetValue(akey, out var aid)) continue;
                var n = 0;
                foreach (var f in files)
                {
                    if (!f.Name.StartsWith($"Data/{sub.Name}/", StringComparison.Ordinal)) continue;
                    if (!f.Name.EndsWith(".pdf", StringComparison.OrdinalIgnoreCase)) continue;
                    if (f.Name.ToLowerInvariant().EndsWith("_text.pdf")) continue;
                    var url = NMU.Platform.Components.Services.ArchiveCatalog.GetDownloadUrl(aid, f.Name);
                    if (cachedKeys.Contains(GetPdfCacheKey(url))) n++;
                }
                if (n > 0) counts[sub.Name] = n;
            }

            await InvokeAsync(() =>
            {
                _subjectLecturers = lecMap;
                _offlineCounts = counts;
                StateHasChanged();
            });
        }
        catch { }
    }

    private List<MaterialSubjectInfo> FilterByDepartment(List<MaterialSubjectInfo> list)
    {
        return list.Where(s => NMU.Platform.Components.Services.ArchiveCatalog.IsVisibleForDepartment(s.Branch, _studentDept)).ToList();
    }

    private string SubjectOf(string fileName)
    {
        // New layout: Data/{Subject}/PDFs/...
        if (!fileName.StartsWith("Data/", StringComparison.Ordinal)) return "";
        var segs = fileName.Split('/');
        return segs.Length >= 2 ? segs[1] : "";
    }

    private void Reload()
    {
        _error = false;
        _loading = true;
        StateHasChanged();
        _ = LoadDataAsync();
    }

    private void OpenSubject(string subject)
    {
        _ = OpenSubjectAsync(subject);
    }

    private async Task OpenSubjectAsync(string subject)
    {
        try
        {
            // Custom subjects live in their own archives: resolve first so the
            // lecturer dialog (and file list) comes from the right place.
            var (level, semester) = SubjectArchive(subject);
            List<ArchiveFile> files;
            if (string.Equals(level, _studentLevel, StringComparison.Ordinal)
                && string.Equals(semester, _studentSemester, StringComparison.Ordinal)
                && _allFiles.Count > 0)
            {
                files = _allFiles;
            }
            else
            {
                files = await MaterialsService.GetFilesAsync(level, semester);
            }
            var lecturers = MaterialsService.GetLecturersForSubject(files, subject);
            // Multiple lecturers: choose first on this page, navigate after.
            if (lecturers.Count > 1)
            {
                _dialogSubject = subject;
                _dialogLecturers = lecturers;
                _dialogOpen = true;
                await InvokeAsync(StateHasChanged);
                return;
            }
            NavigateToSubject(subject, lecturers.Count == 1 ? lecturers[0] : null);
        }
        catch
        {
            NavigateToSubject(subject, null);
        }
    }

    private (string Level, string Semester) SubjectArchive(string subject)
    {
        if (_customMode)
        {
            var m = _customSelections.FirstOrDefault(c =>
                string.Equals(c.Subject, subject, StringComparison.OrdinalIgnoreCase));
            if (m != null) return (m.Level, m.Semester);
        }
        return (_studentLevel, _studentSemester);
    }

    private void NavigateToSubject(string subject, string? lecturer)
    {
        _dialogOpen = false;
        var url = $"materials/{Uri.EscapeDataString(subject)}";
        if (!string.IsNullOrEmpty(lecturer))
            url += $"?lecturer={Uri.EscapeDataString(lecturer)}";
        Navigation.NavigateTo(url, replace: true);
    }

    private void PickDialogLecturer(string lecturer) => NavigateToSubject(_dialogSubject, lecturer);

    private void CloseLecturerDialog() => _dialogOpen = false;

    private static string GetPdfCacheKey(string fileUrl)
    {
        if (string.IsNullOrEmpty(fileUrl)) return "";
        var hash = Convert.ToHexString(System.Security.Cryptography.SHA256.HashData(System.Text.Encoding.UTF8.GetBytes(fileUrl)))[..16];
        return $"pdf_{hash}";
    }

    private void OnRefreshRequested() => Reload();

    public void Dispose()
    {
        LayoutState.RefreshRequested -= OnRefreshRequested;
    }
}
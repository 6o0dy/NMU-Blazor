@page "/"
@using NMU.Platform.Components.Models
@using NMU.Platform.Components.Services
@implements IDisposable
@inject StudentService StudentService
@inject MaterialsService MaterialsService
@inject NavigationManager Navigation
@inject IPlatformService Platform
@inject NavigationState NavState
@inject ToastService Toast
@inject IJSRuntime _js
@inject MediaCacheService MediaCache
@inject LayoutState LayoutState

@if (currentStudent != null)
{
    <div class="home-container">
        <div class="hero-section">
            <h1>
                Welcome,
                <span class="hero-name">@currentStudent.Name</span>
                👋
            </h1>
            <div class="code-tag">&lt; Everything you need is here /&gt;</div>
        </div>

        <div class="cards-grid">
            <div class="dev-card" @onclick="GoToMaterials">
                <div class="dev-card-title"><span>📚</span> Study Materials</div>
                <div class="dev-card-desc">Browse lectures and material files available for the current term.</div>
                <button class="btn-sky" @onclick="GoToMaterials" @onclick:stopPropagation>Browse Materials ➔</button>
            </div>

            <div class="dev-card" @onclick="GoToQuizzes">
                <div class="dev-card-title"><span>🧩</span> Quizzes &amp; Bank</div>
                <div class="dev-card-desc">Practice exams and real quiz mode with answer explanations.</div>
                <button class="btn-outlined" @onclick="GoToQuizzes" @onclick:stopPropagation>Start Quizzes ➔</button>
            </div>

            <div class="dev-card" @onclick="GoToRecorded">
                <div class="dev-card-title"><span>🎥</span> Recorded Lectures</div>
                <div class="dev-card-desc">Built-in player with seek bar and offline caching support.</div>
                <button class="btn-outlined" @onclick="GoToRecorded" @onclick:stopPropagation>Watch Lectures ➔</button>
            </div>

            <div class="dev-card" @onclick="GoToYouTube">
                <div class="dev-card-title"><span>▶️</span> YouTube Videos</div>
                <div class="dev-card-desc">Curated subject explanations from YouTube channels.</div>
                <button class="btn-outlined" @onclick="GoToYouTube" @onclick:stopPropagation>Browse Videos ➔</button>
            </div>

            @if (_showVirtualLab)
            {
                <div class="dev-card" @onclick="GoToLaboratory">
                    <div class="dev-card-title"><span>🧪</span> Virtual Lab</div>
                    <div class="dev-card-desc">Live simulations of practical electricity and circuits experiments.</div>
                    <button class="btn-outlined" @onclick="GoToLaboratory" @onclick:stopPropagation>Enter Lab ➔</button>
                </div>
            }
        </div>
    </div>

    @if (showManageModal)
    {
        <div class="profile-overlay" dir="ltr" id="manage-modal">
            <div class="profile-card">
                <div class="profile-head">
                    <button class="profile-close" @onclick="CloseManageModal">&times;</button>
                    <div class="profile-eyebrow">Student Profile</div>
                    <h2>Your Information</h2>
                    <p class="sub">@(isEditing ? "Update your data below." : "View your saved data.")</p>
                </div>
                <div class="profile-body">
                    <div class="profile-section">
                        <div class="profile-section-title"><span class="step-num">1</span> Personal</div>
                        <div class="field-group">
                            <label>Your Name</label>
                            <input type="text" id="edit-name" @bind="editName" disabled="@(!isEditing)" placeholder="Enter name" />
                        </div>
                    </div>

                    <div class="profile-section">
                        <div class="profile-section-title"><span class="step-num">2</span> Academic</div>
                        <div class="profile-grid">
                            <div class="field-group">
                                <label>Academic Level</label>
                                <select id="edit-year" @bind="editYear" disabled="@(!isEditing)">
                                    <option value="Level 1">Level 1</option>
                                    <option value="Level 2">Level 2</option>
                                    <option value="Level 3">Level 3</option>
                                    <option value="Level 4">Level 4</option>
                                    <option value="Level 5">Level 5</option>
                                </select>
                            </div>

                            <div class="field-group">
                                <label>Department</label>
                                <select id="edit-dept" @bind="editDept" disabled="@(!isEditing)">
                                    <option value="AIE">AIE - AI Engineering</option>
                                    <option value="CE">CE - Computer Engineering</option>
                                </select>
                            </div>
                        </div>

                        <div class="field-group" style="margin-top:12px;">
                            <label>The Semester</label>
                            <div class="term-tiles">
                                <label class="tile-item">
                                    <input type="radio" name="edit-term" value="Semester 1"
                                           checked='@(editTerm == "Semester 1")'
                                           disabled="@(!isEditing)"
                                           @onchange='() => { if (isEditing) editTerm = "Semester 1"; }' />
                                    <span class="tile-btn">Semester 1</span>
                                </label>
                                <label class="tile-item">
                                    <input type="radio" name="edit-term" value="Semester 2"
                                           checked='@(editTerm == "Semester 2")'
                                           disabled="@(!isEditing)"
                                           @onchange='() => { if (isEditing) editTerm = "Semester 2"; }' />
                                    <span class="tile-btn">Semester 2</span>
                                </label>
                            </div>
                        </div>
                    </div>

                    <div class="profile-section">
                        <div class="profile-section-title"><span class="step-num">3</span> Subjects <span class="opt-tag">اختياري</span></div>
                        <div class="custom-mode-group">
                            <label class="custom-mode-row" @onclick="ToggleCustomMode">
                                <span>
                                    <strong>Custom Subjects</strong>
                                    <small>Register subjects from any level / semester</small>
                                </span>
                                <span class="custom-mode-switch @(editCustomMode ? "on" : "")"></span>
                            </label>
                            @if (editCustomMode)
                            {
                                <div class="selected-subjects-bar">
                                    <button type="button" class="select-subjects-btn" @onclick="OpenPicker" disabled="@(!isEditing)">
                                        <i class="fa-solid fa-list-check"></i> Select Subjects
                                        @if (editSelectedSubjects.Count > 0)
                                        {
                                            <span class="selected-count-badge">@editSelectedSubjects.Count</span>
                                        }
                                    </button>
                                    @if (editSelectedSubjects.Count > 0)
                                    {
                                        <div class="selected-subjects-list">
                                            @foreach (var s in editSelectedSubjects.OrderBy(s => s.Level).ThenBy(s => s.Semester).ThenBy(s => s.Subject))
                                            {
                                                <span class="selected-subject-chip">
                                                    @s.Subject.Replace("_", " ")
                                                    @if (isEditing)
                                                    {
                                                        <i class="fa-solid fa-xmark" @onclick="() => RemoveSubject(s)"></i>
                                                    }
                                                </span>
                                            }
                                        </div>
                                    }
                                </div>
                            }
                        </div>
                    </div>
                </div>

                <div class="profile-foot">
                    <button class="action-btn @(isEditing ? "save-mode" : "edit-mode")" @onclick="HandleEditSave">
                        @(isEditing ? "Save Changes" : "Change")
                    </button>
                    <button class="action-btn delete-mode" @onclick="DeleteProfile">Delete Data</button>
                </div>
            </div>
        </div>
    }

    @if (showSubjectPicker)
    {
        <div class="subject-picker-overlay" dir="ltr" lang="en" @onclick="ClosePicker">
            <div class="subject-picker-card" @onclick:stopPropagation>
                <div class="subject-picker-header">
                    <button class="btn-small-icon" @onclick="ClosePicker">&times;</button>
                    <h3>Select Your Subjects @if (catalogUpdating) { <span class="updating-badge">جارٍ تحديث قائمة المواد...</span> }</h3>
                    <div class="search-wrapper">
                        <i class="fa-solid fa-magnifying-glass search-icon-inside"></i>
                        <input type="text" class="search-input" placeholder="Search subjects..."
                               @bind="searchQuery" @bind:event="oninput" />
                    </div>
                    @if (isEditing)
                    {
                        <button type="button" class="btn-link" @onclick="ClearAllSubjects">Clear all</button>
                    }
                </div>

                <div class="subject-picker-body">
                    @if (catalogLoading)
                    {
                        <div class="loading-state">
                            <i class="fas fa-circle-notch fa-spin fa-2x" style="color:var(--primary)"></i>
                            <br /><br />Loading subjects...
                        </div>
                    }
                    else if (catalog.Count == 0)
                    {
                        <div style="color:#94a3b8;text-align:center;padding:30px;">No subjects found. Please try again later.</div>
                    }
                    else
                    {
                        @foreach (var group in groups)
                        {
                            var visible = group.Entries.Where(e => MatchesQuery(e)).ToList();
                            if (visible.Count == 0) continue;
                            var groupAllSel = visible.All(e => editSelectedSubjects.Any(s => s.Matches(e.Level, e.Semester, e.Subject)));
                            <div class="subject-group">
                                <div class="subject-group-title">
                                    @group.DisplayLevel • @group.DisplaySemester
                                    @if (isEditing)
                                    {
                                        <button type="button" class="btn-link" @onclick="() => ToggleGroup(visible, groupAllSel)">
                                            @(groupAllSel ? "clear" : "check all")
                                        </button>
                                    }
                                </div>
                                <div class="subject-group-grid">
                                    @foreach (var entry in visible)
                                    {
                                        var isSel = editSelectedSubjects.Any(s => s.Matches(entry.Level, entry.Semester, entry.Subject));
                                        var label = string.IsNullOrEmpty(entry.DisplayName) ? entry.Subject.Replace("_", " ") : entry.DisplayName;
                                        <label class="subject-check-card @(isSel ? "selected" : "")" @onclick="() => ToggleSubject(entry)">
                                            <span class="subject-check-circle"></span>
                                            <span class="subject-check-name">@label</span>
                                            <span class="pick-stack">
                                                @if (!string.IsNullOrEmpty(entry.Code)) { <span class="badge badge-sky">@entry.Code</span> }
                                            </span>
                                        </label>
                                    }
                                </div>
                            </div>
                        }
                    }
                </div>

                <div class="subject-picker-footer">
                    <button class="ctrl-btn" style="flex:1;border-color:var(--text-secondary);color:#fff;" @onclick="ClosePicker">Cancel</button>
                    <button class="ctrl-btn" style="flex:1;background:var(--primary);color:#000;border:none;font-weight:700;" @onclick="ClosePicker">Done (@editSelectedSubjects.Count)</button>
                </div>
            </div>
        </div>
    }

    @if (showCacheModal)
    {
        <div class="profile-overlay">
            <div class="profile-card" style="max-width:400px;">
                <div class="profile-head">
                    <button class="profile-close" @onclick="CloseCacheModal">&times;</button>
                    <div class="profile-eyebrow">Storage</div>
                    <h2>🗑️ Clear Cache</h2>
                    <p class="sub">Choose what to delete</p>
                </div>
                <div class="profile-body">
                    <div style="display:flex;flex-direction:column;gap:12px;">
                        <button class="action-btn delete-mode" @onclick="ClearPdfCache" style="width:100%;">
                            <i class="fa-regular fa-file-pdf"></i> Delete Files Cache
                        </button>
                        <button class="action-btn delete-mode" @onclick="ClearVideoCache" style="width:100%;">
                            <i class="fa-solid fa-video"></i> Delete Videos Cache
                        </button>
                        <button class="action-btn delete-mode" @onclick="ClearQuizCache" style="width:100%;">
                            <i class="fa-solid fa-list-check"></i> Delete Quizzes Cache
                        </button>
                        <button class="action-btn delete-mode" @onclick="ClearAllCache" style="width:100%;background:#dc2626;border-color:#dc2626;">
                            <i class="fa-solid fa-radiation"></i> Delete Everything
                        </button>
                    </div>
                </div>
            </div>
        </div>
    }
}

@code {
    private StudentProfile? currentStudent;
    private bool showManageModal;
    private bool isEditing;
    private bool showCacheModal;

    private string editName = "";
    private string editYear = "Level 1";
    private string editDept = "AIE";
    private string editTerm = "Semester 1";

    private bool editCustomMode;
    private List<CustomSubjectSelection> editSelectedSubjects = new();
    private bool showSubjectPicker;
    private bool catalogLoading;
    private bool catalogUpdating;
    private string searchQuery = "";
    private List<SubjectCatalogEntry> catalog = new();
    private List<SubjectGroup> groups = new();
    private bool _showVirtualLab;

    protected override void OnInitialized()
    {
        LayoutState.SettingsRequested += OnSettingsRequested;
        LayoutState.CacheRequested += OnCacheRequested;
    }

    protected override async Task OnInitializedAsync()
    {
        NavState.PageTitle = "NMU-CE & AIE";
        try
        {
            currentStudent = await StudentService.GetStudentAsync();
        }
        catch { }

        _ = UpdateVirtualLabAsync();

        if (LayoutState.PendingSettings)
        {
            LayoutState.PendingSettings = false;
            OpenManageModal();
        }

        if (LayoutState.PendingCache)
        {
            LayoutState.PendingCache = false;
            OpenCacheModal();
        }
    }

    private void OnSettingsRequested()
    {
        OpenManageModal();
        StateHasChanged();
    }

    private void OnCacheRequested()
    {
        OpenCacheModal();
        StateHasChanged();
    }

    private async Task UpdateVirtualLabAsync()
    {
        try
        {
            if (currentStudent == null) { _showVirtualLab = false; return; }
            _showVirtualLab = await MaterialsService.HasPhysics2Async(currentStudent);
            await InvokeAsync(StateHasChanged);
        }
        catch { }
    }

    public void Dispose()
    {
        LayoutState.SettingsRequested -= OnSettingsRequested;
        LayoutState.CacheRequested -= OnCacheRequested;
    }

    private void OpenManageModal()
    {
        if (currentStudent != null)
        {
            editName = currentStudent.Name;
            editYear = currentStudent.AcademicLevel;
            editDept = string.IsNullOrEmpty(currentStudent.Department) ? "AIE" : currentStudent.Department;
            editTerm = currentStudent.Semester;
            editCustomMode = currentStudent.CustomSubjectsMode;
            editSelectedSubjects = currentStudent.CustomSubjects != null
                ? new List<CustomSubjectSelection>(currentStudent.CustomSubjects)
                : new List<CustomSubjectSelection>();
            showManageModal = true;
        }
    }

    private void ToggleCustomMode()
    {
        if (isEditing) editCustomMode = !editCustomMode;
    }

    private async Task OpenPicker()
    {
        searchQuery = "";
        showSubjectPicker = true;
        var justLoaded = false;
        if (catalog.Count == 0)
        {
            catalogLoading = true;
            catalog = await MaterialsService.GetSubjectCatalogAsync();
            catalogLoading = false;
            justLoaded = true;
        }
        BuildGroups();
        StateHasChanged();
        // Background catalog refresh once per session on first picker open:
        // instant cached list first, fresh merge when done.
        if (!justLoaded)
            _ = RefreshCatalogAsync();
    }

    private async Task RefreshCatalogAsync()
    {
        try
        {
            if (!MaterialsService.CatalogSessionRefreshDue()) return;
            catalogUpdating = true;
            await InvokeAsync(StateHasChanged);
            var fresh = await MaterialsService.RefreshSubjectCatalogForcedAsync();
            if (fresh != null && fresh.Count > 0)
            {
                catalog = fresh;
                BuildGroups();
            }
        }
        catch { }
        finally
        {
            catalogUpdating = false;
            await InvokeAsync(StateHasChanged);
        }
    }

    private void BuildGroups()
    {
        groups = catalog
            .GroupBy(e => (e.Level, e.Semester))
            .Select(g => new SubjectGroup
            {
                Level = g.Key.Level,
                Semester = g.Key.Semester,
                DisplayLevel = g.Key.Level.Replace("_", " "),
                DisplaySemester = g.Key.Semester.Replace("_", " "),
                Entries = g.AsEnumerable().ToList()
            })
            .ToList();
    }

    private bool MatchesQuery(SubjectCatalogEntry entry)
    {
        if (string.IsNullOrWhiteSpace(searchQuery)) return true;
        var q = searchQuery;
        return entry.Subject.Replace("_", " ").Contains(q, StringComparison.OrdinalIgnoreCase)
               || entry.DisplayName.Contains(q, StringComparison.OrdinalIgnoreCase)
               || entry.Code.Contains(q, StringComparison.OrdinalIgnoreCase)
               || SubjectMatcher.Normalize(entry.Subject).Contains(SubjectMatcher.Normalize(q))
               || SubjectMatcher.Normalize(entry.DisplayName).Contains(SubjectMatcher.Normalize(q));
    }

    private bool MatchesQuery(string subject)
    {
        if (string.IsNullOrWhiteSpace(searchQuery)) return true;
        return subject.Replace("_", " ").Contains(searchQuery, StringComparison.OrdinalIgnoreCase)
               || SubjectMatcher.Normalize(subject).Contains(SubjectMatcher.Normalize(searchQuery));
    }

    private void ToggleSubject(SubjectCatalogEntry entry)
    {
        if (!isEditing) return;
        var existing = editSelectedSubjects.FirstOrDefault(s => s.Matches(entry.Level, entry.Semester, entry.Subject));
        if (existing != null)
            editSelectedSubjects.Remove(existing);
        else
            editSelectedSubjects.Add(new CustomSubjectSelection
            {
                Level = entry.Level,
                Semester = entry.Semester,
                Subject = entry.Subject
            });
        StateHasChanged();
    }

    private void ToggleGroup(List<SubjectCatalogEntry> visible, bool allSelected)
    {
        if (!isEditing) return;
        if (allSelected)
        {
            foreach (var e in visible)
                editSelectedSubjects.RemoveAll(s => s.Matches(e.Level, e.Semester, e.Subject));
        }
        else
        {
            foreach (var e in visible)
            {
                if (!editSelectedSubjects.Any(s => s.Matches(e.Level, e.Semester, e.Subject)))
                    editSelectedSubjects.Add(new CustomSubjectSelection { Level = e.Level, Semester = e.Semester, Subject = e.Subject });
            }
        }
        StateHasChanged();
    }

    private void ClearAllSubjects()
    {
        if (!isEditing) return;
        editSelectedSubjects.Clear();
        StateHasChanged();
    }

    private void RemoveSubject(CustomSubjectSelection s)
    {
        if (!isEditing) return;
        editSelectedSubjects.Remove(s);
        StateHasChanged();
    }

    private void ClosePicker() => showSubjectPicker = false;

    private void OpenCacheModal()
    {
        showCacheModal = true;
    }

    private void CloseCacheModal() => showCacheModal = false;

    private async Task ClearPdfCache()
    {
        try
        {
            var count = await _js.InvokeAsync<int>("nmuFunctions.clearPdfCache");
            showCacheModal = false;
            Toast.ShowToast($"Deleted {count} files from cache", ToastType.Success);
        }
        catch
        {
            showCacheModal = false;
            Toast.ShowToast("An error occurred while clearing file cache", ToastType.Error);
        }
    }

    private async Task ClearVideoCache()
    {
        try
        {
            await MediaCache.ClearAllAsync();
            showCacheModal = false;
            Toast.ShowToast("Video cache cleared successfully", ToastType.Success);
        }
        catch
        {
            showCacheModal = false;
            Toast.ShowToast("An error occurred while clearing video cache", ToastType.Error);
        }
    }

    private async Task ClearQuizCache()
    {
        try
        {
            await _js.InvokeVoidAsync("nmuFunctions.clearQuizCache");
            showCacheModal = false;
            Toast.ShowToast("Quiz cache cleared successfully", ToastType.Success);
        }
        catch
        {
            showCacheModal = false;
            Toast.ShowToast("An error occurred while clearing quiz cache", ToastType.Error);
        }
    }

    private async Task ClearAllCache()
    {
        try
        {
            await MediaCache.ClearAllAsync();
            await _js.InvokeVoidAsync("nmuFunctions.clearAllCache");
            showCacheModal = false;
            Toast.ShowToast("All cache cleared successfully", ToastType.Success);
        }
        catch
        {
            showCacheModal = false;
            Toast.ShowToast("An error occurred while clearing cache", ToastType.Error);
        }
    }

    private void CloseManageModal()
    {
        showManageModal = false;
        isEditing = false;
    }

    private async Task HandleEditSave()
    {
        if (!isEditing)
        {
            isEditing = true;
            return;
        }

        if (string.IsNullOrWhiteSpace(editName) || editName.Length < 3)
            return;

        var oldLevel = currentStudent?.AcademicLevel ?? "";
        var oldSemester = currentStudent?.Semester ?? "";
        var levelChanged = !string.Equals(oldLevel, editYear, StringComparison.OrdinalIgnoreCase);
        var semChanged = !string.Equals(oldSemester, editTerm, StringComparison.OrdinalIgnoreCase);

        var updated = new StudentProfile
        {
            Name = editName,
            AcademicLevel = editYear,
            Semester = editTerm,
            Department = string.IsNullOrEmpty(editDept) ? "AIE" : editDept,
            CustomSubjectsMode = editCustomMode,
            CustomSubjects = editCustomMode ? editSelectedSubjects : new List<CustomSubjectSelection>()
        };

        await StudentService.SaveStudentAsync(updated);
        currentStudent = updated;
        showManageModal = false;
        isEditing = false;
        StateHasChanged();
        _ = UpdateVirtualLabAsync();

        // Smart auto-cleanup: if level or semester changed, remove old cached quiz data
        if (levelChanged || semChanged)
        {
            try
            {
                var removed = await _js.InvokeAsync<int>("nmuFunctions.cleanupOldQuizCache", oldLevel, oldSemester, editYear, editTerm);
                if (removed > 0)
                {
                    Toast.ShowToast($"Deleted {removed} cached files from the old term", ToastType.Success);
                }
            }
            catch { }
        }
    }

    private async Task DeleteProfile()
    {
        try
        {
            await StudentService.DeleteStudentAsync();
            currentStudent = null;
            await _js.InvokeVoidAsync("nmuFunctions.reloadWithoutHistory", Navigation.BaseUri);
        }
        catch { }
    }

    private void NavigateTo(string url)
    {
        var baseUri = Navigation.BaseUri.TrimEnd('/');
        var current = Navigation.Uri.TrimEnd('/');
        var target = baseUri + url;
        if (current == target) return;
        Navigation.NavigateTo(url.TrimStart('/'), replace: true);
    }

    private void GoToMaterials() => NavigateTo("/materials");
    private void GoToYouTube() => NavigateTo("/youtube");
    private void GoToRecorded() => NavigateTo("/recorded");
    private void GoToQuizzes() => NavigateTo("/quizzes");
    private void GoToLaboratory() => NavigateTo("/laboratory");

    private class SubjectGroup
    {
        public string Level { get; set; } = "";
        public string Semester { get; set; } = "";
        public string DisplayLevel { get; set; } = "";
        public string DisplaySemester { get; set; } = "";
        public List<SubjectCatalogEntry> Entries { get; set; } = new();
    }
}

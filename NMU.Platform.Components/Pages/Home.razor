@page "/"
@using NMU.Platform.Components.Models
@using NMU.Platform.Components.Services
@implements IDisposable
@inject StudentService StudentService
@inject NavigationManager Navigation
@inject IPlatformService Platform
@inject NavigationState NavState
@inject ToastService Toast
@inject IJSRuntime _js
@inject MediaCacheService MediaCache
@inject LayoutState LayoutState

@if (currentStudent != null)
{
    <div class="home-container">
        <div class="hero-section">
            <h1>
                Welcome,
                <span class="hero-name">@currentStudent.Name</span>
                👋
            </h1>
            <div class="code-tag">&lt; Everything you need is here /&gt;</div>
        </div>

        <div class="cards-grid">
            <div class="dev-card" @onclick="GoToMaterials">
                <div class="dev-card-title"><span>📚</span> Study Materials</div>
                <div class="dev-card-desc">Browse lectures and material files available for the current term.</div>
                <button class="btn-sky" @onclick="GoToMaterials" @onclick:stopPropagation>Browse Materials ➔</button>
            </div>

            <div class="dev-card" @onclick="GoToQuizzes">
                <div class="dev-card-title"><span>🧩</span> Quizzes &amp; Bank</div>
                <div class="dev-card-desc">Practice exams and real quiz mode with answer explanations.</div>
                <button class="btn-outlined" @onclick="GoToQuizzes" @onclick:stopPropagation>Start Quizzes ➔</button>
            </div>

            <div class="dev-card" @onclick="GoToRecorded">
                <div class="dev-card-title"><span>🎥</span> Recorded Lectures</div>
                <div class="dev-card-desc">Built-in player with seek bar and offline caching support.</div>
                <button class="btn-outlined" @onclick="GoToRecorded" @onclick:stopPropagation>Watch Lectures ➔</button>
            </div>

            <div class="dev-card" @onclick="GoToYouTube">
                <div class="dev-card-title"><span>▶️</span> YouTube Videos</div>
                <div class="dev-card-desc">Curated subject explanations from YouTube channels.</div>
                <button class="btn-outlined" @onclick="GoToYouTube" @onclick:stopPropagation>Browse Videos ➔</button>
            </div>

            <div class="dev-card" @onclick="GoToLaboratory">
                <div class="dev-card-title"><span>🧪</span> Virtual Lab</div>
                <div class="dev-card-desc">Live simulations of practical electricity and circuits experiments.</div>
                <button class="btn-outlined" @onclick="GoToLaboratory" @onclick:stopPropagation>Enter Lab ➔</button>
            </div>
        </div>
    </div>

    @if (showManageModal)
    {
        <div class="custom-modal" dir="ltr" id="manage-modal" style="display: flex;">
            <div class="modal-card">
                <button class="close-modal" @onclick="CloseManageModal">&times;</button>
                <h2>YOUR INFORMATION</h2>

                <div class="field-group">
                    <label>Your Name</label>
                    <input type="text" id="edit-name" @bind="editName" disabled="@(!isEditing)" placeholder="Enter name" />
                </div>

                <div class="field-group">
                    <label>Academic Level</label>
                    <select id="edit-year" @bind="editYear" disabled="@(!isEditing)">
                        <option value="Level 1">Level 1</option>
                        <option value="Level 2">Level 2</option>
                        <option value="Level 3">Level 3</option>
                    </select>
                </div>

                <div class="field-group">
                    <label>The Semester</label>
                    <div class="edit-term-container">
                        <div class="term-radio @(editTerm == "Semester 1" ? "selected" : "")"
                             @onclick='() => { if (isEditing) editTerm = "Semester 1"; }'>
                            Semester 1
                        </div>
                        <div class="term-radio @(editTerm == "Semester 2" ? "selected" : "")"
                             @onclick='() => { if (isEditing) editTerm = "Semester 2"; }'>
                            Semester 2
                        </div>
                    </div>
                </div>

                <div class="modal-actions">
                    <button class="action-btn @(isEditing ? "save-mode" : "edit-mode")" @onclick="HandleEditSave">
                        @(isEditing ? "Save Changes" : "Change")
                    </button>
                    <button class="action-btn delete-mode" @onclick="DeleteProfile">Delete Data</button>
                </div>
            </div>
        </div>
    }

    @if (showCacheModal)
    {
        <div class="custom-modal" style="display: flex;">
            <div class="modal-card" style="max-width:400px;">
                <button class="close-modal" @onclick="CloseCacheModal">&times;</button>
                <h2 style="text-align:center;font-size:1.2rem;color:var(--primary);">🗑️ CLEAR CACHE</h2>
                <p style="text-align:center;color:#94a3b8;font-size:0.85rem;margin:0 0 20px;">Choose what to delete</p>

                <div style="display:flex;flex-direction:column;gap:12px;">
                    <button class="action-btn delete-mode" @onclick="ClearPdfCache" style="width:100%;">
                        <i class="fa-regular fa-file-pdf"></i> Delete Files Cache
                    </button>
                    <button class="action-btn delete-mode" @onclick="ClearVideoCache" style="width:100%;">
                        <i class="fa-solid fa-video"></i> Delete Videos Cache
                    </button>
                    <button class="action-btn delete-mode" @onclick="ClearQuizCache" style="width:100%;">
                        <i class="fa-solid fa-list-check"></i> Delete Quizzes Cache
                    </button>
                    <button class="action-btn delete-mode" @onclick="ClearAllCache" style="width:100%;background:#dc2626;border-color:#dc2626;">
                        <i class="fa-solid fa-radiation"></i> Delete Everything
                    </button>
                </div>
            </div>
        </div>
    }
}

@code {
    private StudentProfile? currentStudent;
    private bool showManageModal;
    private bool isEditing;
    private bool showCacheModal;

    private string editName = "";
    private string editYear = "Level 1";
    private string editTerm = "Semester 1";

    protected override void OnInitialized()
    {
        LayoutState.SettingsRequested += OnSettingsRequested;
        LayoutState.CacheRequested += OnCacheRequested;
    }

    protected override async Task OnInitializedAsync()
    {
        NavState.PageTitle = "NMU-CE & AIE";
        try
        {
            currentStudent = await StudentService.GetStudentAsync();
        }
        catch { }

        if (LayoutState.PendingSettings)
        {
            LayoutState.PendingSettings = false;
            OpenManageModal();
        }

        if (LayoutState.PendingCache)
        {
            LayoutState.PendingCache = false;
            OpenCacheModal();
        }
    }

    private void OnSettingsRequested()
    {
        OpenManageModal();
        StateHasChanged();
    }

    private void OnCacheRequested()
    {
        OpenCacheModal();
        StateHasChanged();
    }

    public void Dispose()
    {
        LayoutState.SettingsRequested -= OnSettingsRequested;
        LayoutState.CacheRequested -= OnCacheRequested;
    }

    private void OpenManageModal()
    {
        if (currentStudent != null)
        {
            editName = currentStudent.Name;
            editYear = currentStudent.AcademicLevel;
            editTerm = currentStudent.Semester;
            showManageModal = true;
        }
    }

    private void OpenCacheModal()
    {
        showCacheModal = true;
    }

    private void CloseCacheModal() => showCacheModal = false;

    private async Task ClearPdfCache()
    {
        try
        {
            var count = await _js.InvokeAsync<int>("nmuFunctions.clearPdfCache");
            showCacheModal = false;
            Toast.ShowToast($"Deleted {count} files from cache", ToastType.Success);
        }
        catch
        {
            showCacheModal = false;
            Toast.ShowToast("An error occurred while clearing file cache", ToastType.Error);
        }
    }

    private async Task ClearVideoCache()
    {
        try
        {
            await MediaCache.ClearAllAsync();
            showCacheModal = false;
            Toast.ShowToast("Video cache cleared successfully", ToastType.Success);
        }
        catch
        {
            showCacheModal = false;
            Toast.ShowToast("An error occurred while clearing video cache", ToastType.Error);
        }
    }

    private async Task ClearQuizCache()
    {
        try
        {
            await _js.InvokeVoidAsync("nmuFunctions.clearQuizCache");
            showCacheModal = false;
            Toast.ShowToast("Quiz cache cleared successfully", ToastType.Success);
        }
        catch
        {
            showCacheModal = false;
            Toast.ShowToast("An error occurred while clearing quiz cache", ToastType.Error);
        }
    }

    private async Task ClearAllCache()
    {
        try
        {
            await MediaCache.ClearAllAsync();
            await _js.InvokeVoidAsync("nmuFunctions.clearAllCache");
            showCacheModal = false;
            Toast.ShowToast("All cache cleared successfully", ToastType.Success);
        }
        catch
        {
            showCacheModal = false;
            Toast.ShowToast("An error occurred while clearing cache", ToastType.Error);
        }
    }

    private void CloseManageModal()
    {
        showManageModal = false;
        isEditing = false;
    }

    private async Task HandleEditSave()
    {
        if (!isEditing)
        {
            isEditing = true;
            return;
        }

        if (string.IsNullOrWhiteSpace(editName) || editName.Length < 3)
            return;

        var oldLevel = currentStudent?.AcademicLevel ?? "";
        var oldSemester = currentStudent?.Semester ?? "";
        var levelChanged = !string.Equals(oldLevel, editYear, StringComparison.OrdinalIgnoreCase);
        var semChanged = !string.Equals(oldSemester, editTerm, StringComparison.OrdinalIgnoreCase);

        var updated = new StudentProfile
        {
            Name = editName,
            AcademicLevel = editYear,
            Semester = editTerm
        };

        await StudentService.SaveStudentAsync(updated);
        currentStudent = updated;
        showManageModal = false;
        isEditing = false;
        StateHasChanged();

        // Smart auto-cleanup: if level or semester changed, remove old cached quiz data
        if (levelChanged || semChanged)
        {
            try
            {
                var removed = await _js.InvokeAsync<int>("nmuFunctions.cleanupOldQuizCache", oldLevel, oldSemester, editYear, editTerm);
                if (removed > 0)
                {
                    Toast.ShowToast($"Deleted {removed} cached files from the old term", ToastType.Success);
                }
            }
            catch { }
        }
    }

    private async Task DeleteProfile()
    {
        try
        {
            await StudentService.DeleteStudentAsync();
            currentStudent = null;
            Navigation.NavigateTo("", true, true);
        }
        catch { }
    }

    private void NavigateTo(string url)
    {
        var baseUri = Navigation.BaseUri.TrimEnd('/');
        var current = Navigation.Uri.TrimEnd('/');
        var target = baseUri + url;
        if (current == target) return;
        Navigation.NavigateTo(url.TrimStart('/'), replace: true);
    }

    private void GoToMaterials() => NavigateTo("/materials");
    private void GoToYouTube() => NavigateTo("/youtube");
    private void GoToRecorded() => NavigateTo("/recorded");
    private void GoToQuizzes() => NavigateTo("/quizzes");
    private void GoToLaboratory() => NavigateTo("/laboratory");
}

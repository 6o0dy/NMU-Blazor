    private void Reload()
    {
        _loading = true;
        _errorMsg = null;
        StateHasChanged();
        _ = LoadDataAsync(forceRefresh: true);
    }

    private void ChangeFolder(string folder)
    {
        _currentFolder = folder;
        // Smart section behavior: a single section (general alone or one TA
        // alone) opens directly, 2+ sections (general and/or TAs) ask first.
        ResolveSubFolderState(forceDialogOnMulti: true);
        ApplyFileFilter();
        LayoutState.SearchBar = _searchBarFragment;
        LayoutState.NotifyStateChanged();
    }

    private void ChangeLecturer(string lecturer)
    {
        _currentLecturer = lecturer;
        var subset = _allSubjectFiles.Where(f => string.Equals(f.Lecturer, lecturer, StringComparison.Ordinal)).ToList();
        _folders = MaterialsService.GetFolderOrder(subset);
        _currentFolder = _folders.Count > 0 ? _folders[0] : "ROOT";
        ResolveSubFolderState(forceDialogOnMulti: true);
        ApplyFileFilter();
        LayoutState.SearchBar = _searchBarFragment;
        LayoutState.BottomBar = _folders.Count > 1 ? _bottomNavFragment : null;
        LayoutState.NotifyStateChanged();
    }

    private List<string> ComputeSubFolders()
    {
        if (string.IsNullOrEmpty(_currentFolder))
            return new List<string>();
        return MaterialsService.GetSubFolders(_allSubjectFiles, _currentLecturer, _currentFolder);
    }

    /// <summary>
    /// Smart Lab/TA routing, General counts as a full section:
    /// 1 total section (general alone or one TA alone) -> open directly,
    /// 2+ sections (e.g. general + TA, or several TAs) -> choice dialog.
    /// A selection always shows ONLY its own files (no general/TA mixing).
    /// </summary>
    private void ResolveSubFolderState(bool forceDialogOnMulti)
    {
        RecomputeTAOptions();
        _showSubFolderDropdown = false;
        var hasGeneral = HasGeneralFiles();
        var total = _taNames.Count + (hasGeneral ? 1 : 0);
        if (total <= 1)
        {
            _currentSubFolder = hasGeneral ? GeneralSection : (_taNames.Count == 1 ? _taNames[0] : "");
            _showSubFolderDialog = false;
        }
        else if ((IsGeneralSelected && hasGeneral)
            || (!IsGeneralSelected && (_taNames.Contains(_currentSubFolder, StringComparer.Ordinal)
                || _subFolders.Contains(_currentSubFolder, StringComparer.Ordinal))))
        {
            _showSubFolderDialog = false;
        }
        else if (forceDialogOnMulti)
        {
            _currentSubFolder = "";
            _showSubFolderDialog = true;
        }
        else
        {
            _showSubFolderDialog = false;
        }
    }

    private List<string> ComputeLecturers()
        => _allSubjectFiles.Select(f => f.Lecturer)
            .Where(l => !string.IsNullOrWhiteSpace(l))
            .Distinct(StringComparer.Ordinal)
            .OrderBy(l => l, StringComparer.OrdinalIgnoreCase)
            .ToList();

    private void RebuildLecturerFolderState()
    {
        _lecturers = ComputeLecturers();
        if (_lecturers.Count == 0 && _allSubjectFiles.Count > 0)
            _lecturers = new List<string> { "" };
        if (string.IsNullOrEmpty(_currentLecturer) || !_lecturers.Contains(_currentLecturer, StringComparer.Ordinal))
            _currentLecturer = _lecturers.Count > 0 ? _lecturers[0] : "";
        var subset = string.IsNullOrEmpty(_currentLecturer)
            ? _allSubjectFiles
            : _allSubjectFiles.Where(f => string.Equals(f.Lecturer, _currentLecturer, StringComparison.Ordinal)).ToList();
        _folders = MaterialsService.GetFolderOrder(subset.Count > 0 ? subset : _allSubjectFiles);
        _currentFolder = _folders.Count > 0 ? _folders[0] : "ROOT";
        // Initial paint: same smart rule (multi-TA -> dialog, single -> auto).
        ResolveSubFolderState(forceDialogOnMulti: true);
        // When a lecturer is still pending selection, never pre-open a TA dialog.
        if (string.IsNullOrEmpty(_currentLecturer) && _lecturers.Count > 1)
        {
            _subFolders = new List<string>();
            _taNames = new List<string>();
            _currentSubFolder = "";
            _showSubFolderDialog = false;
        }
        ApplyFileFilter();
    }

    private void RefreshSubFolderStatePreservingSelection()
    {
        var prev = _currentSubFolder;
        var wasGeneral = prev == GeneralSection;
        RecomputeTAOptions();
        var hasGeneral = HasGeneralFiles();
        var total = _taNames.Count + (hasGeneral ? 1 : 0);
        if (total <= 1)
        {
            _currentSubFolder = hasGeneral ? GeneralSection : (_taNames.Count == 1 ? _taNames[0] : "");
            _showSubFolderDialog = false;
        }
        else if ((wasGeneral && hasGeneral)
            || (!wasGeneral && (_taNames.Contains(prev, StringComparer.Ordinal)
                || _subFolders.Contains(prev, StringComparer.Ordinal))))
        {
            _currentSubFolder = prev;
            _showSubFolderDialog = false;
        }
        else
        {
            // New section appeared (or removed): ask again instead of silently mixing.
            _currentSubFolder = "";
            _showSubFolderDialog = true;
        }
    }


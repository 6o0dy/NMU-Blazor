@page "/materials/{Subject}"
@using NMU.Platform.Components.Models
@implements IDisposable
@inject MaterialsService MaterialsService
@inject StudentService StudentService
@inject NavigationManager Navigation
@inject NavigationState NavState
@inject LayoutState LayoutState

@if (_loading)
{
    <div class="loading-state">
        <i class="fas fa-circle-notch fa-spin fa-2x" style="color:var(--primary)"></i>
        <br /><br />Loading data...
    </div>
}
else if (_errorMsg != null)
{
    <div class="loading-state" style="color:#ef4444;">
        @_errorMsg
        <br /><br />
        <button class="placeholder-btn" @onclick="Reload">Retry</button>
    </div>
}
else
{
    <div class="files-list-container">
        @if (_filteredFiles.Count == 0)
        {
            <div style="text-align:center; color:#94a3b8; padding:20px; grid-column:1/-1;">
                No PDF files found.
            </div>
        }
        else
        {
            @foreach (var file in _filteredFiles)
            {
                var f = file;
                var displayName = f.Name.EndsWith(".pdf", StringComparison.OrdinalIgnoreCase)
                    ? f.Name[..^4] : f.Name;
                var downloadUrl = $"https://archive.org/download/nmu.ce/{f.Path}";
                <div class="file-item" @onclick="() => OpenFile(downloadUrl, f.Name)"
                     style="animation: slideIn 0.3s ease;">
                    <div class="file-icon"><i class="fa-regular fa-file-pdf"></i></div>
                    <div class="file-text">
                        <span class="file-name">@displayName</span>
                        <span class="file-size">@(f.Size.HasValue ? $"{(f.Size.Value / 1024.0 / 1024.0):F1} MB" : "? MB")</span>
                    </div>
                </div>
            }
        }
    </div>
}

@code {
    [Parameter] public string Subject { get; set; } = "";

    private bool _loading = true;
    private string? _errorMsg;
    private List<MaterialFile> _allSubjectFiles = new();
    private List<string> _folders = new();
    private string _currentFolder = "";
    private string _searchQuery = "";
    private List<MaterialFile> _filteredFiles = new();
    private List<ArchiveFile> _allFiles = new();
    private string _studentLevel = "Level_1";
    private string _studentSemester = "First_Term";

    RenderFragment _searchBarFragment => @<div class="files-search-fixed">
        <div class="search-wrapper">
            <i class="fa-solid fa-magnifying-glass search-icon-inside"></i>
            <input type="text" class="search-input" placeholder="Search files..."
                   value="@_searchQuery"
                   @oninput="OnSearchInput" />
        </div>
    </div>;

    RenderFragment _bottomNavFragment => @<div class="bottom-nav" dir="ltr">
        @foreach (var folder in _folders)
        {
            var f = folder;
            var icon = "fa-folder";
            var lower = f.ToLower();
            if (lower.Contains("lec")) icon = "fa-person-chalkboard";
            else if (lower.Contains("lab")) icon = "fa-flask";
            else if (lower.Contains("tut")) icon = "fa-file-pen";
            <button class="nav-item @(f == _currentFolder ? "active" : "")"
                    @onclick="() => ChangeFolder(f)">
                <span class="nav-icon"><i class="fa-solid @icon"></i></span>
                @f.ToUpper()
            </button>
        }
    </div>;

    protected override void OnInitialized()
    {
        LayoutState.SearchBar = _searchBarFragment;
        LayoutState.BottomBar = _bottomNavFragment;
        LayoutState.NotifyStateChanged();
    }

    protected override async Task OnInitializedAsync()
    {
        NavState.PageTitle = Subject.Replace("_", " ");
        _errorMsg = null;
        try
        {
            var student = await StudentService.GetStudentAsync();
            if (student != null)
            {
                _studentLevel = student.AcademicLevel.Replace(" ", "_");
                _studentSemester = student.Semester.Replace(" ", "_");
            }

            _allFiles = await MaterialsService.GetFilesAsync(_studentLevel, _studentSemester);
            var (folders, files) = MaterialsService.GetFilesForSubject(
                _allFiles, _studentLevel, _studentSemester, Subject);
            _folders = folders;
            _allSubjectFiles = files;
            _currentFolder = folders.Count > 0 ? folders[0] : "ROOT";
            ApplyFileFilter();

            if (_allFiles.Count == 0)
                _errorMsg = "No data received from server.";
            else if (_allSubjectFiles.Count == 0)
                _errorMsg = $"No files found for \"{Subject}\".";

            LayoutState.SearchBar = _searchBarFragment;
            LayoutState.BottomBar = _folders.Count > 1 ? _bottomNavFragment : null;
            LayoutState.NotifyStateChanged();
        }
        catch (Exception ex)
        {
            _errorMsg = $"Error: {ex.Message}";
        }
        _loading = false;
    }

    private void OnSearchInput(ChangeEventArgs e)
    {
        _searchQuery = e.Value?.ToString() ?? "";
        ApplyFileFilter();
        LayoutState.NotifyStateChanged();
    }

    private void Reload()
    {
        _loading = true;
        _errorMsg = null;
        StateHasChanged();
        _ = OnInitializedAsync();
    }

    private void ChangeFolder(string folder)
    {
        _currentFolder = folder;
        ApplyFileFilter();
        LayoutState.NotifyStateChanged();
    }

    private void ApplyFileFilter()
    {
        var filtered = _allSubjectFiles.Where(f =>
            f.Folder == _currentFolder &&
            f.Name.ToLower().EndsWith(".pdf") &&
            !f.Name.ToLower().EndsWith("_text.pdf")).ToList();

        if (!string.IsNullOrWhiteSpace(_searchQuery))
        {
            var q = _searchQuery.ToLower();
            filtered = filtered.Where(f => f.Name.ToLower().Contains(q)).ToList();
        }

        _filteredFiles = filtered.OrderBy(f => f.Name, StringComparer.OrdinalIgnoreCase).ToList();
        StateHasChanged();
    }

    private void OpenFile(string url, string name)
    {
        NavState.CurrentFileUrl = url;
        NavState.CurrentFileName = name;
        Navigation.NavigateTo($"materials/{Uri.EscapeDataString(Subject)}/viewer", replace: true);
    }

    public void Dispose()
    {
        LayoutState.Clear();
    }
}
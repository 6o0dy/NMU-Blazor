    private void RememberLecturer(string lecturer)
    {
        var key = LecturerMemoryKey(_studentLevel, _studentSemester, Subject);
        if (string.IsNullOrEmpty(lecturer))
            _lastLecturer.Remove(key);
        else
            _lastLecturer[key] = lecturer;
    }

    private static string LecturerMemoryKey(string level, string semester, string subject)
        => $"{level}|{semester}|{subject}";

    private static string LecturerClean(string lecturer)
    {
        var split = NMU.Platform.Components.Services.VideosService.SplitLecturerTag(lecturer);

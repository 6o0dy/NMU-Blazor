    private void ApplyFileFilter()
    {
        if (string.IsNullOrEmpty(_currentLecturer) && _lecturers.Count > 1)
        {
            // Multi-lecturer subject with no selection yet: never mix files together.
            _filteredFiles = new List<MaterialFile>();
            return;
        }
        if (SectionCount() > 1 && string.IsNullOrEmpty(_currentSubFolder))
        {
            // Multiple sections (general and/or TAs) with no selection yet:
            // show nothing until the user picks one (never mix sections).
            _filteredFiles = new List<MaterialFile>();
            return;
        }

        // Group selection ("A,B") shows ONLY that exact joint folder;
        // individual TA shows every folder they participate in (solo + joints).
        // General shows only loose files.
        var isJointGroup = !IsGeneralSelected && IsJointRaw(_currentSubFolder);
        var taFolders = (IsGeneralSelected || string.IsNullOrEmpty(_currentSubFolder) || isJointGroup)
            ? null
            : new HashSet<string>(FoldersForTA(_currentSubFolder), StringComparer.Ordinal);
        var filtered = _allSubjectFiles.Where(f =>
            (string.IsNullOrEmpty(_currentLecturer) || string.Equals(f.Lecturer, _currentLecturer, StringComparison.Ordinal)) &&
            string.Equals(f.Folder, _currentFolder, StringComparison.OrdinalIgnoreCase) &&
            (IsGeneralSelected
                ? string.IsNullOrEmpty(f.SubFolder)
                : isJointGroup
                    ? string.Equals(f.SubFolder, _currentSubFolder, StringComparison.Ordinal)
                    : taFolders!.Contains(f.SubFolder)) &&
            f.Name.ToLower().EndsWith(".pdf") &&
            !f.Name.ToLower().EndsWith("_text.pdf")).ToList();

        if (!string.IsNullOrWhiteSpace(_searchQuery))
        {
            var q = _searchQuery.ToLower();
            filtered = filtered.Where(f => f.Name.ToLower().Contains(q)).ToList();
        }

        _filteredFiles = filtered.OrderBy(f => f.Name, StringComparer.OrdinalIgnoreCase).ToList();
        StateHasChanged();
        // Admin custom order (order_config.json): applied in background so first
        // paint stays instant; the list snaps to the saved order when fetched.
        _ = ApplyServerOrderAsync(_currentLecturer, _currentFolder, _currentSubFolder, _searchQuery);
    }

    private static string DirOfPath(string p)
    {
        var i = (p ?? "").LastIndexOf('/');
        return i > 0 ? p[..(i + 1)] : "";
    }

    private async Task ApplyServerOrderAsync(string lecturer, string folder, string subFolder, string query)
    {
        try
        {
            if (_filteredFiles.Count < 2) return;
            var dir = DirOfPath(_filteredFiles[0].Path);
            if (string.IsNullOrEmpty(dir)) return;
            var aid = NMU.Platform.Components.Services.ArchiveCatalog.GetArchiveId(_studentLevel, _studentSemester);
            var order = await MaterialsService.GetCachedDirOrderAsync(dir, aid);
            if (order.Count == 0) return;
            await InvokeAsync(() =>
            {
                if (lecturer != _currentLecturer || folder != _currentFolder || subFolder != _currentSubFolder || query != _searchQuery) return;
                _filteredFiles = NMU.Platform.Components.Services.ArchiveCatalog.ApplyCustomOrder(_filteredFiles, f => f.Path, order);
                StateHasChanged();
                LayoutState.NotifyStateChanged();
            });
        }
        catch { }
    }

    private async Task<bool> CheckOnlineAsync()
    {
        try { return await JS.InvokeAsync<bool>("nmuFunctions.isOnline"); }
        catch { return true; }
    }

    private async Task OpenFile(string url, string name)
    {
        if (!_cachedPdfKeys.Contains(GetPdfCacheKey(url)))
        {
            if (!_isOnline) return;
            _isOnline = await CheckOnlineAsync();
            if (!_isOnline) return;
        }
        NavState.CurrentFileUrl = url;
        NavState.CurrentFileName = name;
        Navigation.NavigateTo($"materials/{Uri.EscapeDataString(Subject)}/viewer", replace: true);
    }

    public void Dispose()
    {
        LayoutState.RefreshRequested -= OnRefreshRequested;
        LayoutState.Clear();
    }

    private void OnRefreshRequested() => Reload();

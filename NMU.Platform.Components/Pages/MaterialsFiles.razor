@page "/materials/{Subject}"
@using NMU.Platform.Components.Models
@using NMU.Platform.Components.Services
@implements IDisposable
@inject IJSRuntime JS
@inject MaterialsService MaterialsService
@inject StudentService StudentService
@inject NavigationManager Navigation
@inject NavigationState NavState
@inject LayoutState LayoutState
@inject HttpClient Http
@inject IPlatformService Platform

<SeoHead Title="@($"{Subject.Replace("_", " ")} Materials | NMU-CE & AIE")" Description="ملفات ومحاضرات PDF الخاصة بالمادة مع معاينة مباشرة وتحميل للمذاكرة أوفلاين على منصة NMU-CE & AIE." Path="@($"/materials/{Subject}")" />

@if (_loading)
{
    <div class="loading-state">
        <i class="fas fa-circle-notch fa-spin fa-2x" style="color:var(--primary)"></i>
        <br /><br />Loading data...
    </div>
}
else if (_errorMsg != null)
{
    <div class="loading-state" style="color:#ef4444;">
        @_errorMsg
        <br /><br />
        <button class="placeholder-btn" @onclick="Reload">Retry</button>
    </div>
}
else
{
    <div class="files-list-container">
        @if (_filteredFiles.Count == 0)
        {
            <div style="text-align:center; color:#94a3b8; padding:20px; grid-column:1/-1;">
                @if (!string.IsNullOrWhiteSpace(_searchQuery))
                {
                    <span>No matching files.</span>
                }
                else if (_lecturers.Count > 1 && string.IsNullOrEmpty(_currentLecturer))
                {
                    <div>Please select a lecturer to view files.</div>
                    <br />
                    <button class="placeholder-btn" @onclick="OpenLecturerDialog">Choose Lecturer</button>
                }
                else if (SectionCount() > 1 && string.IsNullOrEmpty(_currentSubFolder))
                {
                    <div>Please choose what to view in @_currentFolder.</div>
                    <br />
                    <button class="placeholder-btn" @onclick="OpenSubFolderDialog">Choose @_currentFolder Content</button>
                }
                else
                {
                    <span>No PDF files found.</span>
                }
            </div>
        }
        else
        {
            @foreach (var file in _filteredFiles)
            {
                var f = file;
                var displayName = f.Name.EndsWith(".pdf", StringComparison.OrdinalIgnoreCase)
                    ? f.Name[..^4] : f.Name;
                var downloadUrl = NMU.Platform.Components.Services.ArchiveCatalog.GetArchiveId(_studentLevel, _studentSemester) is string aid
                    ? NMU.Platform.Components.Services.ArchiveCatalog.GetDownloadUrl(aid, f.Path)
                    : f.Path;
                var cacheKey = GetPdfCacheKey(downloadUrl);
                var isCached = _cachedPdfKeys.Contains(cacheKey);
                var isAvailable = isCached || _isOnline;
                <div class="file-item pdf-card @(isAvailable ? "" : "file-unavailable")" @onclick="() => OpenFile(downloadUrl, f.Name)"
                     style="animation: slideIn 0.3s ease;">
                    <div class="file-icon pdf-icon">
                        <i class="@(isAvailable ? "fa-regular fa-file-pdf" : "fa-solid fa-lock")"></i>
                    </div>
                    <div class="file-text">
                        <span class="file-name" title="@displayName">@displayName</span>
                        <span class="file-meta-row">
                            @if (!string.IsNullOrEmpty(f.Folder) && f.Folder != "ROOT")
                            {
                                <span class="badge badge-sky pdf-folder">@f.Folder.ToUpper()</span>
                            }
                            @if (!string.IsNullOrEmpty(f.SubFolder))
                            {
                                var tas = NMU.Platform.Components.Services.MaterialsService.SplitTANames(f.SubFolder);
                                if (tas.Count == 1)
                                {
                                    <span class="badge badge-sky pdf-folder ta-chip" title="@tas[0]">@ShortTAName(tas[0])</span>
                                }
                                else if (tas.Count > 1)
                                {
                                    <span class="badge badge-sky pdf-folder ta-group" title="@string.Join(" & ", tas)">
                                        <i class="fa-solid fa-user-group"></i>
                                        @string.Join(" • ", tas.Select(ShortTAName))
                                    </span>
                                }
                            }
                            <span class="file-size">@(f.Size.HasValue ? $"{(f.Size.Value / 1024.0 / 1024.0):F1} MB" : "? MB")</span>
                            @if (_lecturers.Count > 1 && !string.IsNullOrEmpty(f.Lecturer))
                            {
                                <span class="file-lecturer" title="@f.Lecturer">@f.Lecturer</span>
                            }
                        </span>
                    </div>
                    @if (!Platform.IsWeb)
                    {
                        <div class="file-status @(isCached ? "cached" : (isAvailable ? "online" : "offline"))"
                             title="@(isCached ? "متاح أوفلاين" : "محتاج نت")">
                            @if (isCached)
                            {
                                <i class="fa-solid fa-circle-check"></i>
                            }
                            else if (isAvailable)
                            {
                                <i class="fa-solid fa-cloud-arrow-down"></i>
                            }
                            else
                            {
                                <i class="fa-solid fa-cloud"></i>
                            }
                        </div>
                    }
                </div>
            }
        }
    </div>
}

@if (_showLecturerDialog && !_loading && _errorMsg == null)
{
    <div class="subject-picker-overlay" @onclick="CloseLecturerDialog">
        <div class="subject-picker-card" @onclick:stopPropagation>
            <div class="subject-picker-header">
                <button class="btn-small-icon" @onclick="CloseLecturerDialog" aria-label="إغلاق">&times;</button>
                <h3>Select Lecturer</h3>
            </div>
            <div class="subject-picker-body">
                @foreach (var lec in _lecturers)
                {
                    var l = lec;
                    var split = NMU.Platform.Components.Services.VideosService.SplitLecturerTag(l);
                    var clean = string.IsNullOrEmpty(split.Name) ? l : split.Name;
                    <div class="subject-check-card lec-pick" @onclick="() => PickLecturer(l)">
                        <span class="subject-check-name" title="@l">@clean</span>
                        @if (!string.IsNullOrEmpty(split.Tag))
                        {
                            <span class="badge badge-sky lec-tag">@split.Tag</span>
                        }
                        <i class="fa-solid fa-chevron-right" style="color:var(--text-secondary);font-size:12px;"></i>
                    </div>
                }
            </div>
        </div>
    </div>
}

@if (_showSubFolderDialog && !_loading && _errorMsg == null && string.IsNullOrEmpty(_currentSubFolder))
{
    <div class="subject-picker-overlay" @onclick="CloseSubFolderDialog">
        <div class="subject-picker-card" @onclick:stopPropagation>
            <div class="subject-picker-header">
                <button class="btn-small-icon" @onclick="CloseSubFolderDialog" aria-label="إغلاق">&times;</button>
                <h3>Select @(_currentFolder.ToUpper()) Content</h3>
            </div>
            <div class="subject-picker-body">
                @if (HasGeneralFiles())
                {
                    <div class="subject-check-card lec-pick" @onclick="() => PickSubFolder(GeneralSection)">
                        <span class="subject-check-icon"><i class="fa-solid fa-users"></i></span>
                        <span class="subject-check-name">General</span>
                        <i class="fa-solid fa-chevron-right" style="color:var(--text-secondary);font-size:12px;"></i>
                    </div>
                }
                @foreach (var t in SoloUngrouped())
                {
                    var name = t;
                    <div class="subject-check-card lec-pick ta-pick" @onclick="() => PickSubFolder(name)">
                        <span class="ta-avatar @TAAvatarClass(name)" title="@name">@TAInitials(name)</span>
                        <span class="subject-check-name" title="@name">@name</span>
                        <i class="fa-solid fa-chevron-right" style="color:var(--text-secondary);font-size:12px;"></i>
                    </div>
                }
                @foreach (var grp in JointGroups())
                {
                    var members = NMU.Platform.Components.Services.MaterialsService.SplitTANames(grp);
                    <div class="joint-group">
                        @foreach (var m in members)
                        {
                            var t = m;
                            <div class="subject-check-card lec-pick ta-pick joint-member-card" @onclick="() => PickSubFolder(t)">
                                <span class="ta-avatar @TAAvatarClass(t)" title="@t">@TAInitials(t)</span>
                                <span class="subject-check-name" title="@t">@t</span>
                                <i class="fa-solid fa-chevron-right" style="color:var(--text-secondary);font-size:12px;"></i>
                            </div>
                        }
                    </div>
                }
            </div>
        </div>
    </div>
}

@code {
    [Parameter] public string Subject { get; set; } = "";

    private bool _loading = true;
    private string? _errorMsg;
    private List<MaterialFile> _allSubjectFiles = new();
    private List<string> _folders = new();
    private string _currentFolder = "";
    private List<string> _lecturers = new();
    private string _currentLecturer = "";
    private string _searchQuery = "";
    private List<MaterialFile> _filteredFiles = new();
    private bool _isOnline = true; // optimistic default, verified in background
    private HashSet<string> _cachedPdfKeys = new();
    private string _studentLevel = "Level_1";
    private string _studentSemester = "First_Term";
    private bool _showFolderDropdown;
    private bool _showLecturerDropdown;
    private bool _showLecturerDialog;
    private static readonly Dictionary<string, string> _lastLecturer = new();
    private List<string> _subFolders = new();
    private List<string> _taNames = new();
    private string _currentSubFolder = "";
    private bool _showSubFolderDropdown;
    private bool _showSubFolderDialog;

    /// <summary>
    /// Explicit "General" section (loose files) when a folder also has TA
    /// sub-folders. General is a full section of its own: one section total
    /// opens directly, two or more force the choice dialog.
    /// </summary>
    private const string GeneralSection = "__general__";
    private bool IsGeneralSelected => _currentSubFolder == GeneralSection;
    private static string SubFolderDisplay(string s)
    {
        if (s == GeneralSection) return "General";
        if (string.IsNullOrEmpty(s)) return s;
        var parts = NMU.Platform.Components.Services.MaterialsService.SplitTANames(s);
        return parts.Count > 1 ? string.Join(" & ", parts) : s;
    }

    /// <summary>
    /// Raw joint folders ("A,B") shown as one grey group container.
    /// Header selects the whole group (exact folder only);
    /// inner rows select an individual TA (all folders they join).
    /// </summary>
    private List<string> JointGroups() =>
        _subFolders.Where(r => NMU.Platform.Components.Services.MaterialsService.SplitTANames(r).Count > 1)
            .OrderBy(x => x, StringComparer.OrdinalIgnoreCase).ToList();

    private List<string> SoloRaws() =>
        _subFolders.Where(r => NMU.Platform.Components.Services.MaterialsService.SplitTANames(r).Count == 1)
            .OrderBy(x => x, StringComparer.OrdinalIgnoreCase).ToList();

    private static bool IsJointRaw(string s) =>
        NMU.Platform.Components.Services.MaterialsService.SplitTANames(s ?? "").Count > 1;

    private int JointFileCount(string raw) =>
        _allSubjectFiles.Count(f =>
            string.Equals(f.Lecturer, _currentLecturer, StringComparison.Ordinal) &&
            string.Equals(f.Folder, _currentFolder, StringComparison.OrdinalIgnoreCase) &&
            string.Equals(f.SubFolder, raw, StringComparison.Ordinal));

    /// <summary>
    /// Solo TAs that are NOT part of any joint group (shown as plain rows).
    /// TAs inside a joint group are shown only inside the grey wrapper,
    /// so no TA appears twice.
    /// </summary>
    private List<string> SoloUngrouped()
    {
        var inJoint = new HashSet<string>(JointGroups()
            .SelectMany(r => NMU.Platform.Components.Services.MaterialsService.SplitTANames(r)),
            StringComparer.Ordinal);
        return SoloRaws()
            .Select(r => NMU.Platform.Components.Services.MaterialsService.SplitTANames(r).FirstOrDefault() ?? r)
            .Where(t => !inJoint.Contains(t, StringComparer.Ordinal))
            .OrderBy(x => x, StringComparer.OrdinalIgnoreCase).ToList();
    }

    /// <summary>
    /// Raw sub-folders a TA participates in (joint folders like "A,B" count
    /// for every listed TA). Files under any of them belong to that TA's view.
    /// </summary>
    private List<string> FoldersForTA(string ta) =>
        NMU.Platform.Components.Services.MaterialsService.FoldersForTA(_subFolders, ta);

    /// <summary>Avatar initials, skipping titles: "Eng. Manar Ashraf" -> "MA".</summary>
    private static string TAInitials(string ta)
    {
        if (string.IsNullOrWhiteSpace(ta)) return "?";
        var titles = new HashSet<string>(StringComparer.OrdinalIgnoreCase)
            { "eng", "dr", "mr", "ms", "mrs" };
        var words = ta.Split(new[] { ' ', '.', '\t' }, StringSplitOptions.RemoveEmptyEntries)
            .Where(w => !titles.Contains(w.Trim('.', ' '))).ToList();
        if (words.Count == 0) return "?";
        var first = char.ToUpperInvariant(words[0][0]).ToString();
        return words.Count == 1 ? first : first + char.ToUpperInvariant(words[1][0]);
    }

    /// <summary>Short first name, skipping titles: "Eng. Manar Ashraf" -> "Manar".</summary>
    private static string ShortTAName(string ta)
    {
        if (string.IsNullOrWhiteSpace(ta)) return ta ?? "";
        var titles = new HashSet<string>(StringComparer.OrdinalIgnoreCase)
            { "eng", "dr", "mr", "ms", "mrs" };
        var words = ta.Split(new[] { ' ', '.', '\t' }, StringSplitOptions.RemoveEmptyEntries)
            .Where(w => !titles.Contains(w.Trim('.', ' '))).ToList();
        return words.Count == 0 ? ta.Trim() : words[0].Trim();
    }

    /// <summary>Deterministic avatar color per TA name.</summary>
    private static string TAAvatarClass(string ta)
    {
        string[] palette = { "ta-c0", "ta-c1", "ta-c2", "ta-c3", "ta-c4", "ta-c5", "ta-c6", "ta-c7" };
        unchecked
        {
            int h = 0;
            foreach (var c in ta ?? "") h = h * 31 + c;
            return palette[(h & 0x7fffffff) % palette.Length];
        }
    }

    /// <summary>True when loose (general) files exist in the current lecturer+folder.</summary>
    private bool HasGeneralFiles() => _allSubjectFiles.Any(f =>
        string.Equals(f.Lecturer, _currentLecturer, StringComparison.Ordinal) &&
        string.Equals(f.Folder, _currentFolder, StringComparison.OrdinalIgnoreCase) &&
        string.IsNullOrEmpty(f.SubFolder));

    /// <summary>Total selectable sections: individual TAs + General (if present).
    /// Joint folders ("A,B") expand, so each TA is its own option.</summary>
    private int SectionCount() => _taNames.Count + (HasGeneralFiles() ? 1 : 0);

    /// <summary>Rebuilds raw folders + expanded individual TA options together.</summary>
    private void RecomputeTAOptions()
    {
        _subFolders = ComputeSubFolders();
        _taNames = NMU.Platform.Components.Services.MaterialsService.ExpandTANames(_subFolders);
    }

    private static string GetPdfCacheKey(string fileUrl)
    {
        if (string.IsNullOrEmpty(fileUrl)) return "";
        var hash = Convert.ToHexString(System.Security.Cryptography.SHA256.HashData(System.Text.Encoding.UTF8.GetBytes(fileUrl)))[..16];
        return $"pdf_{hash}";
    }

    RenderFragment _searchBarFragment => @<div class="files-search-fixed">
        <div class="search-wrapper">
            <i class="fa-solid fa-magnifying-glass search-icon-inside"></i>
            <input type="text" class="search-input" placeholder="Search files..."
                   value="@_searchQuery"
                   @oninput="OnSearchInput" />
        </div>
        @if (_lecturers.Count > 1)
        {
            <div class="files-folder-dropdown show-desktop">
                <button type="button" class="folder-dropdown-toggle @(_showLecturerDropdown ? "open" : "")"
                        @onclick="ToggleLecturerDropdown">
                    <i class="fa-solid fa-user-tie"></i>
                    <span class="folder-dropdown-current">@LecturerClean(_currentLecturer)</span>
                    @if (!string.IsNullOrEmpty(LecturerTag(_currentLecturer)))
                    {
                        <span class="badge badge-sky lec-tag">@LecturerTag(_currentLecturer)</span>
                    }
                    <i class="fa-solid fa-chevron-down"></i>
                </button>
                @if (_showLecturerDropdown)
                {
                    <div class="folder-dropdown-menu" @onclick:stopPropagation>
                        @foreach (var lec in _lecturers)
                        {
                            var l = lec;
                            var clean = LecturerClean(l);
                            var tag = LecturerTag(l);
                            <button class="folder-dropdown-item @(l == _currentLecturer ? "active" : "")"
                                    @onclick="() => SelectLecturerFromDropdown(l)">
                                <i class="fa-solid fa-user-tie"></i>
                                @clean
                                @if (!string.IsNullOrEmpty(tag))
                                {
                                    <span class="badge badge-sky lec-tag">@tag</span>
                                }
                            </button>
                        }
                    </div>
                }
            </div>
        }
        @if (_folders.Count > 1)
        {
            <div class="files-folder-dropdown">
                <button type="button" class="folder-dropdown-toggle @(_showFolderDropdown ? "open" : "")"
                        @onclick="ToggleFolderDropdown">
                    <i class="fa-solid fa-folder-tree"></i>
                    <span class="folder-dropdown-current">@_currentFolder.ToUpper()</span>
                    <i class="fa-solid fa-chevron-down"></i>
                </button>
                @if (_showFolderDropdown)
                {
                    <div class="folder-dropdown-menu" @onclick:stopPropagation>
                        @foreach (var folder in _folders)
                        {
                            var f = folder;
                            var icon = "fa-folder";
                            var lower = f.ToLower();
                            if (lower.Contains("lec")) icon = "fa-person-chalkboard";
                            else if (lower.Contains("lab")) icon = "fa-flask";
                            else if (lower.Contains("tut")) icon = "fa-file-pen";
                            <button class="folder-dropdown-item @(f == _currentFolder ? "active" : "")"
                                    @onclick="() => SelectFolderFromDropdown(f)">
                                <i class="fa-solid @icon"></i>
                                @f.ToUpper()
                            </button>
                        }
                    </div>
                }
            </div>
        }
        @if (SectionCount() > 1)
        {
            <div class="files-folder-dropdown show-desktop">
                <button type="button" class="folder-dropdown-toggle @(_showSubFolderDropdown ? "open" : "")"
                        @onclick="ToggleSubFolderDropdown">
                    <i class="fa-solid fa-chalkboard-user"></i>
                    <span class="folder-dropdown-current">@(string.IsNullOrEmpty(_currentSubFolder) ? "Select content" : SubFolderDisplay(_currentSubFolder))</span>
                    <i class="fa-solid fa-chevron-down"></i>
                </button>
                @if (_showSubFolderDropdown)
                {
                    <div class="folder-dropdown-menu" @onclick:stopPropagation>
                        @if (HasGeneralFiles())
                        {
                            <button class="folder-dropdown-item @(IsGeneralSelected ? "active" : "")"
                                    @onclick="() => SelectSubFolderFromDropdown(GeneralSection)">
                                <i class="fa-solid fa-users"></i>
                                General
                            </button>
                        }
                        @foreach (var ta in _taNames)
                        {
                            var t = ta;
                            <button class="folder-dropdown-item @(t == _currentSubFolder ? "active" : "")"
                                    @onclick="() => SelectSubFolderFromDropdown(t)">
                                <span class="ta-avatar ta-avatar-sm @TAAvatarClass(t)">@TAInitials(t)</span>
                                @t
                            </button>
                        }
                    </div>
                }
            </div>
        }
    </div>;

    RenderFragment _bottomNavFragment => @<div class="bottom-nav" dir="ltr">
        @foreach (var folder in _folders)
        {
            var f = folder;
            var icon = "fa-folder";
            var lower = f.ToLower();
            if (lower.Contains("lec")) icon = "fa-person-chalkboard";
            else if (lower.Contains("lab")) icon = "fa-flask";
            else if (lower.Contains("tut")) icon = "fa-file-pen";
            <button class="nav-item @(f == _currentFolder ? "active" : "")"
                    @onclick="() => ChangeFolder(f)">
                <span class="nav-icon"><i class="fa-solid @icon"></i></span>
                @f.ToUpper()
            </button>
        }
    </div>;

    protected override void OnInitialized()
    {
        LayoutState.RefreshRequested += OnRefreshRequested;
        LayoutState.SearchBar = _searchBarFragment;
        LayoutState.BottomBar = _bottomNavFragment;
        LayoutState.NotifyStateChanged();
    }

    protected override async Task OnInitializedAsync()
    {
        var decoded = Uri.UnescapeDataString(Subject);
        NMU.Platform.Components.Services.ArchiveCatalog.ParseSubjectFolder(decoded, out _, out var clean, out _);
        NavState.PageTitle = string.IsNullOrEmpty(clean) ? decoded.Replace("_", " ") : clean;
        // Return immediately so the router paints the page (loading state) without
        // freezing the current page; all data loading happens in the background.
        _ = LoadDataAsync();
    }

    /// <summary>
    /// Manual refresh (header button / retry) forces a fresh metadata fetch,
    /// bypassing the revalidation window: use right after uploading new
    /// folders/files instead of waiting for the background pass.
    /// </summary>
    private async Task LoadDataAsync(bool forceRefresh = false)
    {
        _errorMsg = null;
        try
        {
            var studentTask = StudentService.GetStudentAsync();
            _isOnline = await JS.InvokeAsync<bool>("nmuFunctions.isOnline");

            var student = await studentTask;
            if (student != null)
            {
                _studentLevel = student.AcademicLevel.Replace(" ", "_");
                _studentSemester = student.Semester.Replace(" ", "_");
            }

            // Custom subjects mode: this subject may live in another level/semester.
            // Resolve it from the student's selected subjects, falling back to the
            // student's default level/semester if it isn't in the list.
            if (student?.CustomSubjectsMode == true && student.CustomSubjects != null && student.CustomSubjects.Count > 0)
            {
                var match = student.CustomSubjects.FirstOrDefault(c =>
                    string.Equals(c.Subject, Subject, StringComparison.OrdinalIgnoreCase));
                if (match != null)
                {
                    _studentLevel = match.Level;
                    _studentSemester = match.Semester;
                }
            }

            // Fast path: per-subject file list from a small cache (same as the quiz page),
            // instead of loading the full archive file list before showing anything.
            _allSubjectFiles = await MaterialsService.GetCachedSubjectFilesAsync(_studentLevel, _studentSemester, Subject);
            if (_allSubjectFiles.Count == 0)
                _allSubjectFiles = await MaterialsService.GetSubjectFilesAsync(_studentLevel, _studentSemester, Subject);

            RebuildLecturerFolderState();

            var memKey = LecturerMemoryKey(_studentLevel, _studentSemester, Subject);
            _lastLecturer.TryGetValue(memKey, out var remembered);
            var queryLecturer = ReadLecturerQuery();
            if (!string.IsNullOrEmpty(queryLecturer) && _lecturers.Contains(queryLecturer, StringComparer.Ordinal))
            {
                // Lecturer pre-selected on the subjects page: go straight in.
                _showLecturerDialog = false;
                if (queryLecturer != _currentLecturer)
                    ChangeLecturer(queryLecturer);
                RememberLecturer(queryLecturer);
            }
            else
            {
                var hasRemembered = !string.IsNullOrEmpty(remembered) && _lecturers.Contains(remembered, StringComparer.Ordinal);
                if (_lecturers.Count > 1 && !hasRemembered)
                {
                    // Multiple lecturers: ask first instead of auto-picking one.
                    _currentLecturer = "";
                    _currentFolder = "";
                    _folders = new List<string>();
                    _subFolders = new List<string>();
                    _taNames = new List<string>();
                    _currentSubFolder = "";
                    _showSubFolderDialog = false;
                    _filteredFiles = new List<MaterialFile>();
                    _showLecturerDialog = true;
                    LayoutState.BottomBar = null;
                }
                else if (hasRemembered && remembered != _currentLecturer)
                {
                    ChangeLecturer(remembered!);
                }
            }

            if (_allSubjectFiles.Count == 0)
                _errorMsg = $"No files found for \"{Subject}\".";

            LayoutState.SearchBar = _searchBarFragment;
            LayoutState.BottomBar = _folders.Count > 1 ? _bottomNavFragment : null;
            LayoutState.NotifyStateChanged();

            _loading = false;
            await InvokeAsync(StateHasChanged);

            // Background: cached PDF keys for offline badges (no longer blocks first paint).
            _ = LoadCachedPdfKeysAsync();

            // Background revalidation (HEAD request), same as the quiz page.
            _ = MaterialsService.CheckAndUpdateSubjectFilesAsync(_studentLevel, _studentSemester, Subject,
                async updated =>
                {
                    await InvokeAsync(() =>
                    {
                        _allSubjectFiles = updated;
                        if (_showLecturerDialog || (_lecturers.Count > 1 && string.IsNullOrEmpty(_currentLecturer)))
                        {
                            // Still waiting for an explicit choice: refresh the
                            // lecturer list only, never auto-pick.
                            _lecturers = ComputeLecturers();
                            _filteredFiles = new List<MaterialFile>();
                        }
                        else if (_showSubFolderDialog || (SectionCount() > 1 && string.IsNullOrEmpty(_currentSubFolder)))
                        {
                            // Still waiting for a TA choice: refresh the TA list
                            // only, never auto-pick or mix TAs.
                            RecomputeTAOptions();
                            _filteredFiles = new List<MaterialFile>();
                            LayoutState.SearchBar = _searchBarFragment;
                        }
                        else
                        {
                            // Preserve the user's lecturer/folder/TA selection
                            // across background refreshes when still valid.
                            var prevLecturer = _currentLecturer;
                            var prevFolder = _currentFolder;
                            var prevSub = _currentSubFolder;
                            _lecturers = ComputeLecturers();
                            if (!_lecturers.Contains(prevLecturer, StringComparer.Ordinal))
                            {
                                RebuildLecturerFolderState();
                            }
                            else
                            {
                                _currentLecturer = prevLecturer;
                                var subset = _allSubjectFiles.Where(f => string.Equals(f.Lecturer, _currentLecturer, StringComparison.Ordinal)).ToList();
                                _folders = MaterialsService.GetFolderOrder(subset.Count > 0 ? subset : _allSubjectFiles);
                                if (!_folders.Contains(prevFolder))
                                {
                                    _currentFolder = _folders.Count > 0 ? _folders[0] : "ROOT";
                                    ResolveSubFolderState(forceDialogOnMulti: true);
                                }
                                else
                                {
                                    _currentFolder = prevFolder;
                                    _currentSubFolder = prevSub;
                                    RefreshSubFolderStatePreservingSelection();
                                }
                                ApplyFileFilter();
                                LayoutState.SearchBar = _searchBarFragment;
                                LayoutState.BottomBar = _folders.Count > 1 ? _bottomNavFragment : null;
                            }
                        }
                        StateHasChanged();
                        LayoutState.NotifyStateChanged();
                    });
                }, force: forceRefresh);
        }
        catch (Exception ex)
        {
            _errorMsg = $"Error: {ex.Message}";
            _loading = false;
            await InvokeAsync(StateHasChanged);
        }
    }

    private async Task LoadCachedPdfKeysAsync()
    {
        try
        {
            var keys = await JS.InvokeAsync<string[]>("nmuFunctions.getCachedPdfKeys");
            _cachedPdfKeys = new HashSet<string>(keys ?? Array.Empty<string>());
        }
        catch { _cachedPdfKeys = new HashSet<string>(); }
        await InvokeAsync(StateHasChanged);
    }

    private void OnSearchInput(ChangeEventArgs e)

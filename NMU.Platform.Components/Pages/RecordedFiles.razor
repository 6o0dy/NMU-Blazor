@page "/recorded/{Group}"
@using NMU.Platform.Components.Models
@implements IDisposable
@inject RecordedService RecordedService
@inject StudentService StudentService
@inject NavigationManager Navigation
@inject NavigationState NavState
@inject LayoutState LayoutState
@inject IJSRuntime JS
@inject IPlatformService Platform
@inject MediaCacheService MediaCache

@if (_loading)
{
    <div class="loading-state">
        <i class="fas fa-circle-notch fa-spin fa-2x" style="color:var(--primary)"></i>
        <br /><br />Loading data...
    </div>
}
else if (_errorMsg != null)
{
    <div class="loading-state" style="color:#ef4444;">
        @_errorMsg
        <br /><br />
        <button class="placeholder-btn" @onclick="Reload">Retry</button>
    </div>
}
else
{
    <div class="recorded-files">
        @if (_filteredFiles.Count == 0)
        {
            <div style="text-align:center; color:#94a3b8; padding:20px;">
                @if (!string.IsNullOrEmpty(_searchQuery))
                {
                    <span>No matching files.</span>
                }
                else if (_lecturers.Count > 1 && string.IsNullOrEmpty(_currentLecturer))
                {
                    <div>Please select a lecturer to view recordings.</div>
                    <br />
                    <button class="placeholder-btn" @onclick="OpenLecturerDialog">Choose Lecturer</button>
                }
                else
                {
                    <span>No files found.</span>
                }
            </div>
        }
        else
        {
            @foreach (var file in _filteredFiles)
            {
                var f = file;
                <div class="recorded-card" @onclick="() => PlayFile(f)">
                    @if (f.IsAudio)
                    {
                        <div class="recorded-thumb audio-placeholder">
                            <i class="fa-solid fa-music"></i>
                        </div>
                    }
                    else if (!string.IsNullOrEmpty(f.ThumbName))
                    {
                        var thumbArchive = !string.IsNullOrEmpty(f.ArchiveId) ? f.ArchiveId : NMU.Platform.Components.Services.ArchiveCatalog.GetArchiveId(_studentLevel, _studentSemester);
                        var thumbUrl = thumbArchive != null ? NMU.Platform.Components.Services.ArchiveCatalog.GetDownloadUrl(thumbArchive, f.ThumbName) : f.ThumbName;
                        <img src="@thumbUrl" class="recorded-thumb" loading="lazy" />
                    }
                    else
                    {
                        <div class="recorded-thumb audio-placeholder">
                            <i class="fa-solid fa-video"></i>
                        </div>
                    }
                    <div class="recorded-info">
                        <div class="recorded-title" title="@f.DisplayName">@f.DisplayName</div>
                        <div class="recorded-meta">
                            <span class="badge @(f.IsAudio ? "badge-aud" : "badge-vid")">@(f.IsAudio ? "AUDIO" : "VIDEO")</span>
                            <span class="recorded-sub">@f.SubFolder</span>
                        </div>
                    </div>
                    <div class="recorded-dl" @onclick:stopPropagation @onclick="() => DownloadFile(f)">
                        <i class="fa-solid fa-download"></i>
                    </div>
                    @{
                        var cacheIcon = _cacheStatus.GetValueOrDefault(f.Name) ?? "";
                        if (cacheIcon == "✓")
                        {
                            <div class="recorded-cache-badge cached" title="Available offline">✓ Available Offline</div>
                        }
                        else if (cacheIcon == "⏳")
                        {
                            <div class="recorded-cache-badge partial" title="Partially cached">⏳ Caching</div>
                        }
                    }
                </div>
            }
        }
    </div>
}

@if (_showLecturerDialog && !_loading && _errorMsg == null)
{
    <div class="subject-picker-overlay" @onclick="CloseLecturerDialog">
        <div class="subject-picker-card" @onclick:stopPropagation>
            <div class="subject-picker-header">
                <button class="btn-small-icon" @onclick="CloseLecturerDialog">&times;</button>
                <h3>Select Lecturer</h3>
            </div>
            <div class="subject-picker-body">
                @foreach (var lec in _lecturers)
                {
                    var l = lec;
                    var clean = LecturerDisplayName(l);
                    var tag = LecturerTag(l);
                    <div class="subject-check-card lec-pick" @onclick="() => PickLecturer(l)">
                        <span class="subject-check-name" title="@l">@clean</span>
                        @if (!string.IsNullOrEmpty(tag))
                        {
                            <span class="badge badge-sky lec-tag">@tag</span>
                        }
                        <i class="fa-solid fa-chevron-right" style="color:var(--text-secondary);font-size:12px;"></i>
                    </div>
                }
            </div>
        </div>
    </div>
}

@code {
    [Parameter] public string Group { get; set; } = "";

    private bool _loading = true;
    private string? _errorMsg;
    private List<RecordedFile> _allFiles = new();
    private List<RecordedFile> _allGroupFiles = new();
    private List<RecordedFile> _filteredFiles = new();
    private string _searchQuery = "";
    private string _studentLevel = "Level_1";
    private string _studentSemester = "First_Term";
    private Dictionary<string, string> _cacheStatus = new();
    private List<string> _lecturers = new();
    private string _currentLecturer = "";
    private bool _showLecturerDropdown;
    private bool _showLecturerDialog;
    private static readonly Dictionary<string, string> _lastLecturer = new();

    private RenderFragment _searchBarFragment => @<div class="files-search-fixed">
        <div class="search-wrapper">
            <i class="fa-solid fa-magnifying-glass search-icon-inside"></i>
            <input type="text" class="search-input" placeholder="Search in media..."
                   value="@_searchQuery"
                   @oninput="OnSearchInput" />
        </div>
        @if (_lecturers.Count > 1)
        {
            <div class="files-folder-dropdown show-desktop">
                <button type="button" class="folder-dropdown-toggle @(_showLecturerDropdown ? "open" : "")"
                        @onclick="ToggleLecturerDropdown">
                    <i class="fa-solid fa-user-tie"></i>
                    <span class="folder-dropdown-current">@LecturerDisplayName(_currentLecturer)</span>
                    @if (!string.IsNullOrEmpty(LecturerTag(_currentLecturer)))
                    {
                        <span class="badge badge-sky lec-tag">@LecturerTag(_currentLecturer)</span>
                    }
                    <i class="fa-solid fa-chevron-down"></i>
                </button>
                @if (_showLecturerDropdown)
                {
                    <div class="folder-dropdown-menu" @onclick:stopPropagation>
                        @if (_lecturers.Count <= 1)
                        {
                            <button class="folder-dropdown-item @(string.IsNullOrEmpty(_currentLecturer) ? "active" : "")"
                                    @onclick='() => SelectLecturer("")'>
                                <i class="fa-solid fa-users"></i>
                                ALL
                            </button>
                        }
                        @foreach (var lec in _lecturers)
                        {
                            var l = lec;
                            <button class="folder-dropdown-item @(l == _currentLecturer ? "active" : "")"
                                    @onclick="() => SelectLecturer(l)">
                                <i class="fa-solid fa-user-tie"></i>
                                @LecturerDisplayName(l)
                                @if (!string.IsNullOrEmpty(LecturerTag(l)))
                                {
                                    <span class="badge badge-sky lec-tag">@LecturerTag(l)</span>
                                }
                            </button>
                        }
                    </div>
                }
            </div>
        }
    </div>;

    protected override void OnInitialized()
    {
        LayoutState.StateChanged += OnLayoutStateChanged;
        LayoutState.RefreshRequested += OnRefreshRequested;
    }

    protected override async Task OnInitializedAsync()
    {
        var decodedGroup = Uri.UnescapeDataString(Group);
        NMU.Platform.Components.Services.ArchiveCatalog.ParseSubjectFolder(decodedGroup, out _, out var cleanTitle, out _);
        NavState.PageTitle = string.IsNullOrEmpty(cleanTitle) ? decodedGroup.Replace("_", " ") : cleanTitle;
        _errorMsg = null;
        try
        {
            var student = await StudentService.GetStudentAsync();
            if (student != null)
            {
                _studentLevel = student.AcademicLevel.Replace(" ", "_");
                _studentSemester = student.Semester.Replace(" ", "_");
            }

            // Custom subjects mode: the group may belong to a selected subject from a
            // different level/semester. Resolve it so files are fetched from the right place.
            if (student?.CustomSubjectsMode == true && student.CustomSubjects != null && student.CustomSubjects.Count > 0)
            {
                var match = student.CustomSubjects.FirstOrDefault(c =>
                    SubjectMatcher.Matches(c.Subject, decodedGroup));
                if (match != null)
                {
                    _studentLevel = match.Level;
                    _studentSemester = match.Semester;
                }
            }

            _allFiles = await RecordedService.GetFilesAsync(_studentLevel, _studentSemester);

            if (_allFiles.Count == 0)
                _errorMsg = "No data received from server.";
            else
            {
                _allGroupFiles = RecordedService.GetFilesForGroup(_allFiles, _studentLevel, _studentSemester, decodedGroup);
                if (_allGroupFiles.Count == 0)
                    _errorMsg = $"No files found for \"{decodedGroup}\".";
                else
                {
                    _lecturers = _allGroupFiles.Select(f => f.Lecturer)
                        .Where(l => !string.IsNullOrWhiteSpace(l))
                        .Distinct(StringComparer.Ordinal)
                        .OrderBy(l => l, StringComparer.OrdinalIgnoreCase)
                        .ToList();

                    var memKey = LecturerMemoryKey(_studentLevel, _studentSemester, decodedGroup);
                    _lastLecturer.TryGetValue(memKey, out var remembered);
                    var queryLecturer = ReadLecturerQuery();
                    if (!string.IsNullOrEmpty(queryLecturer) && _lecturers.Contains(queryLecturer, StringComparer.Ordinal))
                    {
                        // Lecturer pre-selected on the subjects page: go straight in.
                        _currentLecturer = queryLecturer;
                        _lastLecturer[memKey] = queryLecturer;
                        ApplyFilter();
                    }
                    else
                    {
                        var hasRemembered = !string.IsNullOrEmpty(remembered)
                            && _lecturers.Contains(remembered, StringComparer.Ordinal);
                        if (_lecturers.Count > 1 && !hasRemembered)
                        {
                            // Multiple lecturers: ask first instead of mixing all files together.
                            _currentLecturer = "";
                            _filteredFiles = new List<RecordedFile>();
                            _showLecturerDialog = true;
                        }
                        else
                        {
                            _currentLecturer = _lecturers.Count == 1
                                ? _lecturers[0]
                                : remembered ?? "";
                            ApplyFilter();
                        }
                    }
                }
            }

            LayoutState.SearchBar = _searchBarFragment;
            LayoutState.NotifyStateChanged();

            if (!Platform.IsWeb)
            {
                _ = RefreshAllCacheStatuses();
                _ = MediaCache.WarmUpAsync();
            }
        }
        catch (Exception ex)
        {
            _errorMsg = $"Error: {ex.Message}";
        }
        _loading = false;
    }

    private async Task RefreshAllCacheStatuses()
    {
        try
        {
            foreach (var f in _allGroupFiles)
            {
                var url = ResolveDownloadUrl(f);
                var key = MediaCache.GetCacheKey(url);
                var complete = await MediaCache.IsCompleteAsync(key);
                var partial = !complete && await MediaCache.HasAnyCacheAsync(key);
                _cacheStatus[f.Name] = complete ? "✓" : partial ? "⏳" : "";
            }
            await InvokeAsync(StateHasChanged);
        }
        catch { }
    }

    private void OnLayoutStateChanged() => StateHasChanged();

    private void OnSearchInput(ChangeEventArgs e)
    {
        _searchQuery = e.Value?.ToString() ?? "";
        ApplyFilter();
        LayoutState.NotifyStateChanged();
    }

    private void ApplyFilter()
    {
        IEnumerable<RecordedFile> query = _allGroupFiles;
        if (!string.IsNullOrEmpty(_currentLecturer))
            query = query.Where(f => string.Equals(f.Lecturer, _currentLecturer, StringComparison.Ordinal));
        else if (_lecturers.Count > 1)
        {
            // Multi-lecturer subject with no selection yet: never mix files together.
            _filteredFiles = new List<RecordedFile>();
            return;
        }
        if (string.IsNullOrWhiteSpace(_searchQuery))
        {
            _filteredFiles = query.ToList();
        }
        else
        {
            var q = _searchQuery.ToLower();
            _filteredFiles = query.Where(f => f.DisplayName.ToLower().Contains(q)).ToList();
        }
    }

    private void ToggleLecturerDropdown()
    {
        _showLecturerDropdown = !_showLecturerDropdown;
        LayoutState.NotifyStateChanged();
    }

    private void SelectLecturer(string lecturer)
    {
        _showLecturerDropdown = false;
        _currentLecturer = lecturer;
        RememberLecturer(lecturer);
        ApplyFilter();
        LayoutState.SearchBar = _searchBarFragment;
        LayoutState.NotifyStateChanged();
    }

    private void OpenLecturerDialog()
    {
        _showLecturerDialog = true;
    }

    private void CloseLecturerDialog()
    {
        _showLecturerDialog = false;
    }

    private void PickLecturer(string lecturer)
    {
        _showLecturerDialog = false;
        _currentLecturer = lecturer;
        RememberLecturer(lecturer);
        ApplyFilter();
        LayoutState.SearchBar = _searchBarFragment;
        LayoutState.NotifyStateChanged();
    }

    private void RememberLecturer(string lecturer)
    {
        var key = LecturerMemoryKey(_studentLevel, _studentSemester, Uri.UnescapeDataString(Group));
        if (string.IsNullOrEmpty(lecturer))
            _lastLecturer.Remove(key);
        else
            _lastLecturer[key] = lecturer;
    }

    private static string LecturerMemoryKey(string level, string semester, string group)
        => $"{level}|{semester}|{group}";

    private string? ReadLecturerQuery()
    {
        try
        {
            var q = System.Web.HttpUtility.ParseQueryString(new Uri(Navigation.Uri).Query).Get("lecturer");
            return string.IsNullOrWhiteSpace(q) ? null : q;
        }
        catch { return null; }
    }

    /// <summary>Lecturer name without any parenthetical tag, e.g. "Dr. Nourhan (LAB)" -> "Dr. Nourhan".</summary>
    private static string LecturerDisplayName(string lecturer)
        => RecordedService.SplitLecturerTag(lecturer).Name;

    /// <summary>Parenthetical tag of a lecturer folder, e.g. "Dr. Nourhan (LAB)" -> "LAB".</summary>
    private static string LecturerTag(string lecturer)
        => RecordedService.SplitLecturerTag(lecturer).Tag;

    private string ResolveDownloadUrl(RecordedFile file)
    {
        if (!string.IsNullOrEmpty(file.ArchiveId))
            return NMU.Platform.Components.Services.ArchiveCatalog.GetDownloadUrl(file.ArchiveId, file.Name);
        return RecordedService.GetDownloadUrl(file.Name, _studentLevel, _studentSemester);
    }

    private void Reload()
    {
        _loading = true;
        _errorMsg = null;
        StateHasChanged();
        _ = OnInitializedAsync();
    }

    private void PlayFile(RecordedFile file)
    {
        var url = ResolveDownloadUrl(file);
        var name = file.DisplayName + (file.IsAudio ? ".mp3" : ".mp4");
        if (!Platform.IsWeb && !file.IsAudio)
            _ = MediaCache.PrefetchCriticalAsync(url);
        NavState.CurrentFileUrl = url;
        NavState.CurrentFileName = name;
        var encodedUrl = Uri.EscapeDataString(url);
        var encodedName = Uri.EscapeDataString(name);
        Navigation.NavigateTo($"recorded/{Uri.EscapeDataString(Uri.UnescapeDataString(Group))}/player?url={encodedUrl}&name={encodedName}", replace: true);
    }

    private async Task DownloadFile(RecordedFile file)
    {
        var url = ResolveDownloadUrl(file);
        var name = file.DisplayName + (file.IsAudio ? ".mp3" : ".mp4");
        if (Platform.IsWeb)
            await JS.InvokeVoidAsync("window.open", url, "_blank");
        else
            await Platform.DownloadFileAsync(url, name);
    }

    public void Dispose()
    {
        LayoutState.StateChanged -= OnLayoutStateChanged;
        LayoutState.RefreshRequested -= OnRefreshRequested;
        LayoutState.Clear();
    }

    private void OnRefreshRequested() => Reload();
}

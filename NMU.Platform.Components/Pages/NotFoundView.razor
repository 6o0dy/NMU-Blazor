@inject NavigationManager Navigation
@inject IJSRuntime JS

<SeoHead Title="صفحة غير موجودة | NMU-CE & AIE" Description="الصفحة المطلوبة غير موجودة على منصة NMU-CE & AIE." Path="/" NoIndex />

<div class="nf-wrap">
    <div class="nf-wash nf-wash-top"></div>
    <div class="nf-glow"></div>
    <div class="nf-wash nf-wash-bottom"></div>

    <div class="nf-page" dir="rtl" lang="ar">
        <svg class="nf-illus" viewBox="0 0 160 160" fill="none" aria-hidden="true">
            <circle cx="80" cy="80" r="72" style="fill:var(--bg-surface-hover)" />
            <circle cx="80" cy="80" r="72" stroke-width="3" style="stroke:var(--primary)" stroke-dasharray="10 8" opacity="0.55" />
            <g>
                <path d="M58 48 h32 l14 14 v44 a6 6 0 0 1 -6 6 H58 a6 6 0 0 1 -6 -6 V54 a6 6 0 0 1 6 -6 z" style="fill:var(--bg-card);stroke:var(--text-secondary)" stroke-width="3" />
                <path d="M90 48 v14 h14" style="stroke:var(--text-secondary)" stroke-width="3" stroke-linejoin="round" />
                <text x="78" y="95" text-anchor="middle" font-size="30" font-weight="800" style="fill:var(--primary)" font-family="Cairo, sans-serif">؟</text>
            </g>
            <g>
                <circle cx="108" cy="104" r="20" style="fill:var(--bg-card);stroke:var(--primary)" stroke-width="5" />
                <line x1="122" y1="118" x2="138" y2="134" style="stroke:var(--primary)" stroke-width="7" stroke-linecap="round" />
            </g>
        </svg>

        <p class="nf-code" dir="ltr">404</p>
        <h1 class="nf-title">الصفحة دي مش موجودة 🧭</h1>
        <p class="nf-sub">
            يبدو إن الرابط اللي فتحته اتنقل أو اتمسح، أو فيه غلطة في العنوان.
            متقلقش — كل حاجتك لسه موجودة في المنصة.
        </p>
        @if (!string.IsNullOrWhiteSpace(BadPath))
        {
            <p class="nf-path-row">
                <span class="nf-path-label">الرابط المطلوب:</span>
                <code class="nf-path" dir="ltr">/@BadPath.TrimStart('/')</code>
            </p>
        }

        <div class="nf-actions">
            <button class="btn-sky" @onclick="GoHome">🏠 الصفحة الرئيسية</button>
            <button class="btn-outlined" @onclick="GoBack">↩ رجوع</button>
        </div>

        <div class="nf-links">
            <span>أو جرّب أقسام المنصة:</span>
            <div class="nf-links-row">
                <button class="nf-chip" @onclick='() => GoTo("materials")'>📚 المواد</button>
                <button class="nf-chip" @onclick='() => GoTo("videos")'>🎥 الفيديوهات</button>
                <button class="nf-chip" @onclick='() => GoTo("quizzes")'>🧩 الكويزات</button>
            </div>
        </div>
    </div>
</div>

@code {
    /// <summary>The unmatched URL path (without leading slash), shown to help spot typos.</summary>
    [Parameter] public string? BadPath { get; set; }

    private void GoHome() => Navigation.NavigateTo("", replace: true);

    private void GoTo(string page) => Navigation.NavigateTo(page, replace: true);

    private async Task GoBack()
    {
        try { await JS.InvokeVoidAsync("nmuFunctions.goBackOrHome", Navigation.BaseUri); }
        catch { GoHome(); }
    }
}

@page "/feedback"
@using System.Text.Json
@using System.Text
@using NMU.Platform.Components.Models
@implements IDisposable
@inject NavigationManager Navigation
@inject NavigationState NavState
@inject StudentService StudentService
@inject IJSRuntime JS
@inject HttpClient Http

@if (!_fingerprintReady)
{
    <div class="loading-state">
        <i class="fas fa-circle-notch fa-spin fa-2x" style="color:var(--primary)"></i>
        <br /><br />Initializing...
    </div>
}
else
{
    <div class="feedback-container">
        <div class="feedback-widget">
            <div class="widget-header">
                <img src="https://blogger.googleusercontent.com/img/b/R29vZ2xl/AVvXsEhoHaelFYav8PXI1IdRySjwvoS2AvCXGjtQ1m61L4IncpasjOykB_ksA3IwQJJGBF4VMqsbn2WJ4D7fziJbXpYxlqSnfmEUKYfSVDXSuiMwGrz25nFTr49aBfGbeO_apptQX-CeVo6CzSVJk84HJRGefeaeWqSaG01aZL9NCXxrzhQI-uoqrFmGS30Mcaw/s1024/1000071927.jpg"
                     class="widget-img" alt="Profile" />
                <div class="widget-title">
                    <h3>ABDELRHMAN ELSAYED</h3>
                    <p>أخبرنا عن تجربتك واقتراحاتك</p>
                </div>
                <img src="https://blogger.googleusercontent.com/img/b/R29vZ2xl/AVvXsEhoHaelFYav8PXI1IdRySjwvoS2AvCXGjtQ1m61L4IncpasjOykB_ksA3IwQJJGBF4VMqsbn2WJ4D7fziJbXpYxlqSnfmEUKYfSVDXSuiMwGrz25nFTr49aBfGbeO_apptQX-CeVo6CzSVJk84HJRGefeaeWqSaG01aZL9NCXxrzhQI-uoqrFmGS30Mcaw/s1024/1000071927.jpg"
                     class="widget-img" alt="Profile" />
            </div>

            <div class="row-flex">
                <div class="rating-container" @onmouseleave="ClearHover">
                    @for (int i = 1; i <= 5; i++)
                    {
                        var idx = i;
                        <span class="star-wrapper">
                            <span class="star-hitbox star-left" @onclick="() => SetRating(idx - 0.5)" @onmouseover="() => _hoverRating = idx - 0.5"></span>
                            <span class="star-hitbox star-right" @onclick="() => SetRating(idx)" @onmouseover="() => _hoverRating = idx"></span>
                            <i class="@GetStarClass(idx)"></i>
                        </span>
                    }
                </div>
                <div class="toggle-wrapper @(_isAnonymous ? "active" : "")" @onclick="ToggleAnonymous">
                    <div class="toggle-switch"></div>
                    <div class="toggle-label">مجهول</div>
                </div>
            </div>

            <div class="input-group">
                <input type="text" @bind="_nameInput" class="input-field" disabled="@_isAnonymous"
                       placeholder="@(_isAnonymous ? "مجهول (Anonymous)" : "ادخل اسمك هنا...")" />
                <textarea @bind="_commentInput" class="input-field" placeholder="اكتب تقييمك أو مشكلتك هنا..."></textarea>
            </div>

            <div class="actions-row">
                <button class="btn btn-primary" @onclick="SubmitReview" disabled="@_isSending">
                    @if (_isSending)
                    {
                        <i class="fa-solid fa-circle-notch fa-spin"></i>
                    }
                    else if (_hasExistingReview)
                    {
                        <i class="fa-solid fa-pen"></i>
                    }
                    else
                    {
                        <i class="fa-solid fa-paper-plane"></i>
                    }
                    @_buttonText
                </button>
                @if (_hasExistingReview)
                {
                    <button class="btn btn-danger" @onclick="RequestDelete" title="حذف تقييمي">
                        <i class="fa-solid fa-trash"></i>
                    </button>
                }
            </div>

            <a href="https://wa.me/201029691937" target="_blank" class="wa-strip">
                <i class="fa-brands fa-whatsapp"></i>
                عندك مشكلة تقنية؟ تواصل معي على الواتساب
            </a>
        </div>

        <div class="reviews-header" id="reviews-header-anchor">
            <h3>آراء الطلاب</h3>
            <span class="reviews-count-badge @(_countPulse ? "pulse-update" : "")" id="reviews-count-badge">
                <span id="reviews-count">@_reviews.Count</span> تقييم
            </span>
        </div>

        <div class="reviews-list">
            @foreach (var rev in _reviews)
            {
                var r = rev;
                var isMine = r.Serial == _fingerprint;
                var val = double.TryParse(r.ReviewRating, System.Globalization.NumberStyles.Any, System.Globalization.CultureInfo.InvariantCulture, out var v) ? v : 0;
                var safeName = r.Name == "مجهول" ? "طالب مجهول" : r.Name;
                var avatarUrl = r.Name == "مجهول" || r.Name == "طالب مجهول"
                    ? "https://ui-avatars.com/api/?name=A&background=1e293b&color=94a3b8"
                    : $"https://ui-avatars.com/api/?name={Uri.EscapeDataString(safeName)}&background=00f2ff&color=000&font-weight=bold";
                var dateStr = r.Timestamp > 0 ? DateTimeOffset.FromUnixTimeMilliseconds(r.Timestamp).ToString("dd/MM/yyyy") : "";

                <div class="review-card @(isMine ? "my-review" : "")">
                    <img src="@avatarUrl" class="reviewer-avatar" alt="avatar" />
                    <div class="review-content">
                        <div class="review-top">
                            <div>
                                <div class="r-name">
                                    @safeName
                                    @if (r.IsVerified)
                                    {
                                        <i class="fa-solid fa-circle-check r-verified" title="طالب مسجل"></i>
                                    }
                                </div>
                                <div class="r-date">@dateStr</div>
                            </div>
                            <div class="r-stars">
                                @RenderStars(val)
                            </div>
                        </div>
                        @if (!string.IsNullOrEmpty(r.Comment))
                        {
                            <div class="r-text">@r.Comment</div>
                        }
                    </div>
                </div>
            }
        </div>
    </div>
}

@if (_showModal)
{
    <div class="feedback-modal-overlay @(_showModal ? "active" : "")" @onclick="CloseModal">
        <div class="feedback-modal-box @_modalType" @onclick:stopPropagation>
            <div class="modal-icon">
                @if (_modalType == "success")
                {
                    <i class="fa-solid fa-circle-check" style="color:#00e676"></i>
                }
                else if (_modalType == "error")
                {
                    <i class="fa-solid fa-circle-xmark" style="color:var(--danger)"></i>
                }
                else
                {
                    <i class="fa-solid fa-triangle-exclamation" style="color:var(--danger)"></i>
                }
            </div>
            <div class="modal-msg">@_modalMessage</div>
            <div class="modal-actions">
                @if (_modalConfirm)
                {
                    <button class="c-btn c-btn-danger" @onclick="ExecuteDelete">نعم، احذف</button>
                    <button class="c-btn c-btn-cancel" @onclick="CloseModal">إلغاء</button>
                }
                else
                {
                    <button class="c-btn c-btn-primary" @onclick="CloseModal">حسناً</button>
                }
            </div>
        </div>
    </div>
}

@code {
    private const string FirebaseUrl = "https://nmu-ce-default-rtdb.firebaseio.com";
    private const string ReviewsPath = "/reviews";

    private bool _fingerprintReady;
    private string _fingerprint = "";
    private bool _isAnonymous;
    private string _nameInput = "";
    private string _commentInput = "";
    private double _currentRating;
    private double _hoverRating;
    private bool _isSending;
    private bool _hasExistingReview;
    private string _buttonText = "إرسال";
    private List<Review> _reviews = new();
    private int _previousReviewCount = -1;
    private bool _countPulse;

    private bool _showModal;
    private string _modalMessage = "";
    private string _modalType = "";
    private bool _modalConfirm;

    private Timer? _pollTimer;
    private bool _isVerified;
    private string _academicLevel = "";

    protected override async Task OnInitializedAsync()
    {
        NavState.PageTitle = "FEEDBACK";
        try
        {
            _fingerprint = await JS.InvokeAsync<string>("window.nmuFunctions.getFingerprint");
            _fingerprintReady = true;

            var student = await StudentService.GetStudentAsync();
            if (student != null && !string.IsNullOrEmpty(student.Name))
            {
                _nameInput = student.Name;
                _isVerified = true;
                _academicLevel = student.AcademicLevel;
            }

            await LoadReviews();

            _pollTimer = new Timer(async _ => await PollReviews(), null, TimeSpan.FromSeconds(10), TimeSpan.FromSeconds(10));
        }
        catch
        {
            _fingerprintReady = true;
        }
    }

    private string GetStarClass(int star)
    {
        var rating = _hoverRating > 0 ? _hoverRating : _currentRating;
        if (rating >= star) return "fa-solid fa-star filled";
        if (rating >= star - 0.5) return "fa-solid fa-star-half-stroke filled";
        return "fa-regular fa-star";
    }

    private void SetRating(double val)
    {
        _currentRating = val;
        _hoverRating = 0;
    }

    private void ClearHover() => _hoverRating = 0;

    private void ToggleAnonymous()
    {
        _isAnonymous = !_isAnonymous;
        if (_isAnonymous)
            _nameInput = "";
        else if (_isVerified)
        {
            _ = RestoreName();
        }
    }

    private async Task RestoreName()
    {
        var student = await StudentService.GetStudentAsync();
        if (student != null)
            _nameInput = student.Name;
    }

    private async Task SubmitReview()
    {
        if (string.IsNullOrWhiteSpace(_fingerprint)) return;

        var name = _isAnonymous ? "مجهول" : _nameInput.Trim();
        if (!_isAnonymous && name.Length < 3)
        {
            ShowModal("يرجى إدخال اسم صحيح.", "error");
            return;
        }
        if (_currentRating == 0)
        {
            ShowModal("الرجاء تحديد التقييم بالنجوم أولاً.", "info");
            return;
        }

        _isSending = true;
        StateHasChanged();

        try
        {
            var review = new Review
            {
                Serial = _fingerprint,
                ReviewRating = _currentRating.ToString(System.Globalization.CultureInfo.InvariantCulture),
                Comment = _commentInput.Trim(),
                Name = name,
                IsVerified = _isVerified && !_isAnonymous,
                Level = _isVerified && !_isAnonymous ? _academicLevel : "",
                Timestamp = DateTimeOffset.UtcNow.ToUnixTimeMilliseconds()
            };

            var json = JsonSerializer.Serialize(review);
            var content = new StringContent(json, Encoding.UTF8, "application/json");
            var url = $"{FirebaseUrl}{ReviewsPath}/{Uri.EscapeDataString(_fingerprint)}.json";
            var response = await Http.PutAsync(url, content);

            if (response.IsSuccessStatusCode)
            {
                _hasExistingReview = true;
                _buttonText = "تحديث التقييم";
                ShowModal("تم حفظ تقييمك بنجاح! شكراً لك.", "success");
                await LoadReviews();
            }
            else
            {
                ShowModal("حدث خطأ في الاتصال بالخادم.", "error");
            }
        }
        catch
        {
            ShowModal("حدث خطأ في الاتصال بالخادم.", "error");
        }
        _isSending = false;
        StateHasChanged();
    }

    private void RequestDelete()
    {
        if (string.IsNullOrWhiteSpace(_fingerprint) || !_hasExistingReview) return;
        ShowModal("هل أنت متأكد أنك تريد حذف تقييمك نهائياً؟", "confirm", confirm: true);
    }

    private async Task ExecuteDelete()
    {
        _showModal = false;
        StateHasChanged();

        try
        {
            var url = $"{FirebaseUrl}{ReviewsPath}/{Uri.EscapeDataString(_fingerprint)}.json";
            var response = await Http.DeleteAsync(url);

            if (response.IsSuccessStatusCode)
            {
                ResetForm();
                ShowModal("تم حذف التقييم نهائياً.", "success");
                await LoadReviews();
            }
            else
            {
                ShowModal("فشل الحذف، يرجى المحاولة لاحقاً.", "error");
            }
        }
        catch
        {
            ShowModal("فشل الحذف، يرجى المحاولة لاحقاً.", "error");
        }
    }

    private void ResetForm()
    {
        _currentRating = 0;
        _hoverRating = 0;
        _hasExistingReview = false;
        _buttonText = "إرسال";
        _commentInput = "";
        if (!_isAnonymous)
        {
            _nameInput = "";
            _ = RestoreName();
        }
        StateHasChanged();
    }

    private async Task LoadReviews()
    {
        try
        {
            var url = $"{FirebaseUrl}{ReviewsPath}.json";
            var response = await Http.GetAsync(url);

            if (response.IsSuccessStatusCode)
            {
                var json = await response.Content.ReadAsStringAsync();
                if (json == "null")
                {
                    _reviews = new List<Review>();
                    return;
                }

                var dict = JsonSerializer.Deserialize<Dictionary<string, Review>>(json);
                _reviews = dict?.Values.ToList() ?? new List<Review>();
                var current = _reviews.FirstOrDefault(r => r.Serial == _fingerprint);
                _hasExistingReview = current != null;

                if (current != null)
                {
                    FillMyData(current);
                }
                else if (_hasExistingReview)
                {
                    ResetForm();
                }

                _reviews = _reviews.OrderByDescending(r => r.Timestamp).ToList();

                if (_previousReviewCount != -1 && _previousReviewCount != _reviews.Count)
                {
                    _countPulse = true;
                    StateHasChanged();
                    await Task.Delay(1000);
                    _countPulse = false;
                }
                _previousReviewCount = _reviews.Count;
            }
        }
        catch { }
        StateHasChanged();
    }

    private async Task PollReviews()
    {
        if (!_fingerprintReady) return;
        try
        {
            var url = $"{FirebaseUrl}{ReviewsPath}.json?orderBy=\"timestamp\"&limitToLast=20";
            var response = await Http.GetAsync(url);

            if (response.IsSuccessStatusCode)
            {
                var json = await response.Content.ReadAsStringAsync();
                if (json == "null") return;

                var dict = JsonSerializer.Deserialize<Dictionary<string, Review>>(json);
                var latest = dict?.Values.ToList() ?? new List<Review>();

                var merged = new Dictionary<string, Review>();
                foreach (var r in _reviews)
                    if (!merged.ContainsKey(r.Serial))
                        merged[r.Serial] = r;
                foreach (var r in latest)
                    if (merged.ContainsKey(r.Serial))
                        merged[r.Serial] = r;
                    else
                        merged[r.Serial] = r;

                _reviews = merged.Values.OrderByDescending(r => r.Timestamp).ToList();

                if (_reviews.Count != _previousReviewCount)
                {
                    _previousReviewCount = _reviews.Count;
                    _countPulse = true;
                    await InvokeAsync(StateHasChanged);
                    await Task.Delay(1000);
                    _countPulse = false;
                    await InvokeAsync(StateHasChanged);
                }
            }
        }
        catch { }
    }

    private void FillMyData(Review data)
    {
        _hasExistingReview = true;
        _currentRating = double.TryParse(data.ReviewRating, System.Globalization.NumberStyles.Any, System.Globalization.CultureInfo.InvariantCulture, out var v) ? v : 0;

        if (data.Name == "مجهول" || data.Name == "طالب مجهول")
        {
            _isAnonymous = true;
            _nameInput = "";
        }
        else
        {
            _isAnonymous = false;
            _nameInput = data.Name;
        }
        _commentInput = data.Comment;
        _buttonText = "تحديث التقييم";
    }

    private void ShowModal(string message, string type, bool confirm = false)
    {
        _modalMessage = message;
        _modalType = type;
        _modalConfirm = confirm;
        _showModal = true;
        StateHasChanged();
    }

    private void CloseModal()
    {
        _showModal = false;
        StateHasChanged();
    }

    private RenderFragment RenderStars(double val) => builder =>
    {
        for (int i = 1; i <= 5; i++)
        {
            builder.OpenElement(0, "i");
            if (val >= i)
                builder.AddAttribute(1, "class", "fa-solid fa-star");
            else if (val >= i - 0.5)
                builder.AddAttribute(2, "class", "fa-solid fa-star-half-stroke");
            else
                builder.AddAttribute(3, "class", "fa-regular fa-star");
            builder.CloseElement();
        }
    };

    public void Dispose()
    {
        _pollTimer?.Dispose();
    }
}

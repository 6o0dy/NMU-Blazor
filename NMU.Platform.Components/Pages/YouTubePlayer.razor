@page "/youtube/{Channel}/player"
@inject NavigationManager Navigation
@inject NavigationState NavState
@inject IJSRuntime JS
@implements IDisposable

@* Same look & controls as the regular video player (vp-* design system).
   The engine is still the chromeless YouTube IFrame API: no YouTube UI of
   any kind is touchable — only OUR controls below. *@
<div class="vp-root" id="yt-player-body" @oncontextmenu:preventDefault>
    <div class="vp-player-wrapper">
        <div id="yt-player-container" class="ytp-frame"></div>
        <div id="ytp-tap" class="ytp-tap" title="Play / Pause"></div>

        <div class="vp-buffer" id="ytp-buffer" style="display:none">
            <span class="vp-buffer-text">جاري تجهيز التشغيل...</span>
        </div>

        <div class="vp-center-play" id="ytp-center-play" style="opacity:0">
            <i id="ytp-center-icon" class="fa-solid fa-play"></i>
        </div>

        <div id="ytp-error" class="ytp-error" style="display:none">
            <div class="ytp-error-text">Couldn't load this video.</div>
            <div class="yt-direct-actions">
                <button id="ytp-retry" class="placeholder-btn" type="button">Retry</button>
                <button id="ytp-error-open" class="placeholder-btn" type="button">Open in YouTube</button>
            </div>
        </div>
    </div>

    <div class="vp-controls" id="ytp-controls">
        <div class="vp-progress-area" id="ytp-progress-area">
            <span class="vp-time-current" id="ytp-time-current">0:00</span>
            <div class="vp-progress-bg"></div>
            <div class="vp-progress-bar" id="ytp-progress-bar" style="width:0%"></div>
            <div class="vp-progress-thumb" id="ytp-progress-thumb" style="left:0%"></div>
            <span class="vp-time-duration" id="ytp-time-duration">0:00</span>
        </div>

        <div class="vp-controls-row">
            <div class="vp-left">
                <button class="vp-btn vp-play-btn" id="ytp-play" type="button" aria-label="Play/Pause">
                    <i id="ytp-play-icon" class="fa-solid fa-play"></i>
                </button>
                <div class="vp-volume">
                    <button class="vp-btn" id="ytp-mute" type="button" aria-label="Mute" style="width:28px;height:28px;font-size:13px;">
                        <i id="ytp-mute-icon" class="fa-solid fa-volume-high"></i>
                    </button>
                    <input id="ytp-volume" type="range" min="0" max="100" value="100" style="width:50px;" aria-label="Volume" />
                </div>
            </div>
            <div class="vp-right">
                <button class="vp-btn" id="ytp-open" type="button" title="Open in YouTube">
                    <i class="fa-brands fa-youtube"></i>
                </button>
                <button class="vp-btn" id="ytp-back10" type="button" title="-10s">
                    <i class="fa-solid fa-rotate-left"></i>
                </button>
                <button class="vp-btn" id="ytp-fw10" type="button" title="+10s">
                    <i class="fa-solid fa-rotate-right"></i>
                </button>
                <button class="vp-btn vp-speed-btn" id="ytp-speed" type="button" title="Speed">1x</button>
                <span id="ytp-quality-badge" class="ytp-quality-badge" title="Current quality">Auto</span>
                <button class="vp-btn" id="ytp-full" type="button" title="Fullscreen">
                    <i class="fa-solid fa-expand"></i>
                </button>
            </div>
        </div>
    </div>
</div>

@code {
    [Parameter] public string Channel { get; set; } = "";

    private string _videoId = "";
    private string _videoTitle = "";

    protected override void OnInitialized()
    {
        var uri = new Uri(Navigation.Uri);
        var query = System.Web.HttpUtility.ParseQueryString(uri.Query);
        var idFromQuery = query["videoId"];
        var titleFromQuery = query["title"];
        _videoId = idFromQuery ?? NavState.YouTubeVideoId ?? "";
        _videoTitle = titleFromQuery ?? NavState.YouTubeVideoTitle ?? "Untitled";

        if (!string.IsNullOrEmpty(_videoId))
        {
            NavState.YouTubeVideoId = _videoId;
            NavState.YouTubeVideoTitle = _videoTitle;
        }

        if (string.IsNullOrEmpty(_videoId))
        {
            Navigation.NavigateTo($"youtube/{Channel}", replace: true);
            return;
        }

        NavState.IsFullScreen = true;
        NavState.PageTitle = _videoTitle;
    }

    protected override async Task OnAfterRenderAsync(bool firstRender)
    {
        if (!firstRender || string.IsNullOrEmpty(_videoId)) return;
        try { await JS.InvokeVoidAsync("youtubePlayer.init", _videoId); } catch { }
    }

    public void Dispose()
    {
        try { _ = JS.InvokeVoidAsync("youtubePlayer.destroy"); } catch { }
    }
}

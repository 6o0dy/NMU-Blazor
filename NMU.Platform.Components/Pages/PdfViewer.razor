@page "/materials/{Subject}/viewer"
@inject IJSRuntime JS
@inject NavigationManager Navigation
@inject NavigationState NavState
@inject HttpClient Http
@inject IPlatformService Platform
@inject ToastService Toast

<div class="viewer-page">
    <div id="pdf-loading-overlay" style="opacity: @(_showLoader ? "1" : "0"); display: @(_showLoader ? "flex" : "none");">
        <div class="spinner-view"></div>
        <div class="loading-text-viewer">@_loadingText</div>
    </div>

    @if (_useCanvas)
    {
        <div class="pdf-canvas-container" id="pdf-canvas-container">
            <div id="pdf-pages"></div>
        </div>
    }
    else
    {
        <div class="pdf-container">
            <iframe class="pdf-frame" id="viewer-frame"
                    src="@_resolvedUrl"
                    style="touch-action: auto;">
            </iframe>
            @if (_showDownloadOverlay)
            {
                <div class="drive-blocker">
                    <button class="drive-download-btn" @onclick="DownloadCurrentFile" title="Download PDF">
                        <svg xmlns="http://www.w3.org/2000/svg" viewBox="0 -960 960 960" width="22" height="22">
                            <path d="M480-320 280-520l56-58 104 104v-320h80v320l104-104 56 58-200 200ZM240-160q-33 0-56.5-23.5T160-240v-120h80v120h480v-120h80v120q0 33-23.5 56.5T720-160H240Z" fill="currentColor"/>
                        </svg>
                    </button>
                </div>
            }
        </div>
    }

    @if (!string.IsNullOrEmpty(_fallbackUrl) && !_showDownloadOverlay)
    {
        <button class="download-fallback" @onclick="OpenFallback">
            <svg xmlns="http://www.w3.org/2000/svg" viewBox="0 -960 960 960" width="20" height="20">
                <path d="M480-320 280-520l56-58 104 104v-320h80v320l104-104 56 58-200 200ZM240-160q-33 0-56.5-23.5T160-240v-120h80v120h480v-120h80v120q0 33-23.5 56.5T720-160H240Z" fill="currentColor"/>
            </svg>
            Open PDF
        </button>
    }
</div>

@code {
    [Parameter] public string Subject { get; set; } = "";

    private string _resolvedUrl = "";
    private string _fallbackUrl = "";
    private string _loadingText = "ESTABLISHING CONNECTION...";
    private bool _showLoader = true;
    private bool _useCanvas;
    private bool _showDownloadOverlay;

    private static string GetPdfCacheKey(string fileUrl)
    {
        if (string.IsNullOrEmpty(fileUrl)) return "";
        var hash = Convert.ToHexString(System.Security.Cryptography.SHA256.HashData(System.Text.Encoding.UTF8.GetBytes(fileUrl)))[..16];
        return $"pdf_{hash}";
    }

    protected override async Task OnInitializedAsync()
    {
        var fileUrl = NavState.CurrentFileUrl ?? "";
        var fileName = NavState.CurrentFileName ?? "";

        if (string.IsNullOrEmpty(fileUrl))
        {
            Navigation.NavigateTo($"materials/{Uri.EscapeDataString(Subject)}", replace: true);
            return;
        }

        NavState.PageTitle = fileName;
    }

    protected override async Task OnAfterRenderAsync(bool firstRender)
    {
        if (!firstRender) return;

        var fileUrl = NavState.CurrentFileUrl ?? "";
        var pdfKey = GetPdfCacheKey(fileUrl);
        var fromCache = false;

        if (!Platform.IsWeb && !Platform.IsDesktop)
        {
            try
            {
                _useCanvas = true;
                StateHasChanged();

                var found = await JS.InvokeAsync<bool>("nmuFunctions.checkPdfCache", pdfKey);
                if (found)
                {
                    await JS.InvokeVoidAsync("nmuFunctions.renderPdfFromCache", pdfKey);
                    _showLoader = false;
                    fromCache = true;
                }
                else
                {
                    _loadingText = "LOADING PDF...";
                    StateHasChanged();

                    var resolvedUrl = await JS.InvokeAsync<string>("nmuFunctions.resolveDirectUrl", fileUrl);
                    var bytes = await Http.GetByteArrayAsync(resolvedUrl);
                    await JS.InvokeVoidAsync("nmuFunctions.setCachedPdfBytes", pdfKey, bytes);
                    await JS.InvokeVoidAsync("nmuFunctions.renderPdfWithPdfJsFromBytes", bytes);
                }
            }
            catch { }
        }
        else if (!Platform.IsWeb)
        {
            try
            {
                // 1. Check cache first for instant offline display (blob URL, no network)
                var blobUrl = await JS.InvokeAsync<string>("nmuFunctions.getCachedPdfBlobUrl", pdfKey);
                if (!string.IsNullOrEmpty(blobUrl))
                {
                    _resolvedUrl = blobUrl;
                    _showLoader = false;
                    fromCache = true;
                    StateHasChanged();
                }
                else
                {
                    // 2. Show direct resolved URL immediately (no wait for download)
                    var resolvedUrl = await JS.InvokeAsync<string>("nmuFunctions.resolveDirectUrl", fileUrl);
                    _resolvedUrl = resolvedUrl;
                    _showLoader = false;
                    StateHasChanged();

                    // 3. Cache in background for offline use next time
                    _ = Task.Run(async () =>
                    {
                        try
                        {
                            var bytes = await Http.GetByteArrayAsync(resolvedUrl);
                            await JS.InvokeVoidAsync("nmuFunctions.setCachedPdfBytes", pdfKey, bytes);
                        }
                        catch { }
                    });
                }
            }
            catch
            {
                _resolvedUrl = fileUrl;
                _showLoader = false;
            }
        }
        else
        {
            // Web: online-only, no IndexedDB caching (display direct URL instantly)
            try
            {
                // 1. Check if Google Docs viewer is needed (Android Chrome)
                var viewerUrl = await JS.InvokeAsync<string>("nmuFunctions.getViewerUrl", fileUrl);
                if (!string.IsNullOrEmpty(viewerUrl))
                {
                    _resolvedUrl = viewerUrl;
                    _fallbackUrl = await JS.InvokeAsync<string>("nmuFunctions.resolveDirectUrl", fileUrl);
                    _showDownloadOverlay = true;
                }
                else
                {
                    // 2. Show direct resolved URL immediately (the iframe displays it inline)
                    var resolvedUrl = await JS.InvokeAsync<string>("nmuFunctions.resolveDirectUrl", fileUrl);
                    _resolvedUrl = resolvedUrl;
                    _showLoader = false;
                }
            }
            catch
            {
                _resolvedUrl = fileUrl;
                _showLoader = false;
            }
        }

        StateHasChanged();

        if (fromCache)
        {
            _ = TryBackgroundRevalidation(pdfKey, fileUrl);
        }

        if (!_useCanvas && !fromCache)
        {
            _ = HideLoaderAfterDelay();
        }
    }

    private async Task HideLoaderAfterDelay()
    {
        await Task.Delay(2000);
        _showLoader = false;
        await InvokeAsync(StateHasChanged);
    }

    private void Close()
    {
        _ = JS.InvokeVoidAsync("nmuFunctions.disablePinchZoom");
        NavState.CurrentFileUrl = null;
        NavState.CurrentFileName = null;
        Navigation.NavigateTo($"materials/{Uri.EscapeDataString(Subject)}", replace: true);
    }

    private void DownloadCurrentFile()
    {
        var url = NavState.CurrentFileUrl ?? "";
        if (!string.IsNullOrEmpty(url))
            _ = JS.InvokeVoidAsync("nmuFunctions.openExternal", url);
    }

    private void OpenFallback()
    {
        if (!string.IsNullOrEmpty(_fallbackUrl))
            _ = JS.InvokeVoidAsync("nmuFunctions.openExternal", _fallbackUrl);
    }

    private async Task TryBackgroundRevalidation(string pdfKey, string fileUrl)
    {
        try
        {
            var online = await JS.InvokeAsync<bool>("nmuFunctions.isOnline");
            if (!online) return;

            // 1. Get cached metadata from JS
            var cachedMeta = await JS.InvokeAsync<CachedPdfMeta>("nmuFunctions.getCachedPdfMeta", pdfKey);
            if (cachedMeta == null || cachedMeta.ContentLength == 0) return;

            // 2. HEAD request from C# (No CORS/Proxy issues)
            using var request = new HttpRequestMessage(HttpMethod.Head, fileUrl);
            using var response = await Http.SendAsync(request, HttpCompletionOption.ResponseHeadersRead);
            if (!response.IsSuccessStatusCode) return;

            var serverLength = response.Content.Headers.ContentLength ?? 0;
            var serverEtag = response.Headers.ETag?.Tag ?? "";
            var serverLastMod = response.Content.Headers.LastModified?.ToString("R") ?? "";

            // 3. Compare
            bool changed = false;
            if (serverLength > 0 && cachedMeta.ContentLength > 0 && serverLength != cachedMeta.ContentLength)
                changed = true;
            else if (!string.IsNullOrEmpty(serverEtag) && !string.IsNullOrEmpty(cachedMeta.Etag) && serverEtag != cachedMeta.Etag)
                changed = true;
            else if (!string.IsNullOrEmpty(serverLastMod) && !string.IsNullOrEmpty(cachedMeta.LastModified) && serverLastMod != cachedMeta.LastModified)
                changed = true;

            if (!changed) return;

            // 4. Update Cache (Fetch + Store)
            var bytes = await Http.GetByteArrayAsync(fileUrl);
            await JS.InvokeVoidAsync("nmuFunctions.setCachedPdfBytes", pdfKey, bytes, serverLength, serverEtag, serverLastMod);
            
            Toast.ShowToast("تم تحديث الملف المفتوح", ToastType.Success);
        }
        catch { }
    }

    public class CachedPdfMeta
    {
        public long ContentLength { get; set; }
        public string Etag { get; set; } = "";
        public string LastModified { get; set; } = "";
        public long Timestamp { get; set; }
    }
}

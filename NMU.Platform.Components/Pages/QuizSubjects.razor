@page "/quizzes"
@using NMU.Platform.Components.Models
@using NMU.Platform.Components.Services
@implements IDisposable
@inject QuizService QuizService
@inject MaterialsService MaterialsService
@inject StudentService StudentService
@inject NavigationManager Navigation
@inject NavigationState NavState
@inject QuizStateService QuizState
@inject LayoutState LayoutState
@inject IJSRuntime JS
 
@if (_loading)
{
    <div class="loading-state">
        <i class="fas fa-circle-notch fa-spin fa-2x" style="color:var(--primary)"></i>
        <br /><br />
        @if (_syncProgress != null && _syncProgress.Total > 0)
        {
            <div class="sync-progress-container">
                <div class="sync-progress-bar">
                    <div class="sync-progress-fill" style="width: @(_syncProgress.Current * 100 / _syncProgress.Total)%;"></div>
                </div>
                <div class="sync-progress-text">
                    @if (_syncProgress.IsDownloading)
                    {
                        <span>Downloading @_syncProgress.SubjectName...</span>
                    }
                    else if (_syncProgress.IsComplete)
                    {
                        <span>✓ Sync Complete!</span>
                    }
                    else
                    {
                        <span>Processing @_syncProgress.Current of @_syncProgress.Total subjects</span>
                    }
                </div>
                <div class="sync-progress-percent">@(_syncProgress.Current * 100 / _syncProgress.Total)%</div>
            </div>
        }
        else
        {
            <span>Synchronizing Data...</span>
        }
    </div>
}
else if (_error)
{
    <div class="loading-state" style="color:#ef4444;">
        @_errorMsg
        <br /><br />
        <button class="placeholder-btn" @onclick="Reload">Retry</button>
    </div>
}
else if (_subjects.Count == 0)
{
    <div class="loading-state" style="color:#94a3b8;">
        No quizzes available yet.
    </div>
}
else
{
    <div class="quiz-subjects-container">
        <div class="grid-view">
            @foreach (var subject in _subjects)
            {
                var s = subject;
                var style = SubjectIcons.Resolve(s.Code, s.Name);
                <div class="subject-card" @onclick="() => OpenSubject(s)">
                    @if (!string.IsNullOrEmpty(s.Code))
                    {
                        <span class="badge badge-sky code-badge-corner">@s.Code</span>
                    }
                    <div class="card-icon @style.ColorClass">
                        <i class="@style.Icon"></i>
                    </div>
                    <div class="card-label-wrap">
                        <div class="card-label" title="@s.Name @s.Code">@s.Name</div>
                    </div>
                    @if (!string.IsNullOrEmpty(s.Lecturer))
                    {
                        <div class="card-sub" title="@s.Lecturer">@s.Lecturer</div>
                    }
                </div>
            }
        </div>
    </div>
}

@code {
    private bool _loading = true;
    private bool _error;
    private string _errorMsg = "Failed to connect to server.";
    private List<QuizSubject> _subjects = new();
    private string _studentLevel = "Level_1";
    private string _studentSemester = "First_Term";
    private string _studentDept = "ALL";
    private SyncProgress? _syncProgress;

    protected override async Task OnInitializedAsync()
    {
        NavState.PageTitle = "QUIZZES";
        QuizState.Reset();

        QuizService.SyncProgressChanged -= OnSyncProgress;
        QuizService.SyncProgressChanged += OnSyncProgress;
        LayoutState.RefreshRequested += OnRefreshRequested;

        // Fast path: render from the small cached subject list instantly, then
        // refresh in the background (same pattern as Materials/Videos).
        try
        {
            var student = await StudentService.GetStudentAsync();
            if (student != null)
            {
                _studentLevel = student.AcademicLevel.Replace(" ", "_");
                _studentSemester = student.Semester.Replace(" ", "_");
                _studentDept = NMU.Platform.Components.Services.ArchiveCatalog.NormalizeDepartment(student.Department);
            }

            if (student?.CustomSubjectsMode == true && student.CustomSubjects != null && student.CustomSubjects.Count > 0)
            {
                await BuildCustomQuizListAsync(student.CustomSubjects);
                if (_subjects.Count == 0)
                    _errorMsg = "No quizzes available for your selected subjects.";

                _loading = false;
                StateHasChanged();
                return;
            }

            _subjects = await QuizService.GetCachedQuizListAsync(_studentLevel, _studentSemester);
            if (_subjects.Count == 0)
                _subjects = await QuizService.GetQuizListAsync(_studentLevel, _studentSemester);

            _subjects = _subjects.Where(s => NMU.Platform.Components.Services.ArchiveCatalog.IsVisibleForDepartment(s.Branch, _studentDept)).ToList();
            // SubjectPathMap keyed by display name; duplicates (same subject, multiple
            // lecturers) keep the first path — full navigation uses QuizState.CurrentQuiz.
            QuizState.SubjectPathMap = _subjects.GroupBy(s => s.Name, StringComparer.OrdinalIgnoreCase).ToDictionary(g => g.Key, g => g.First().Path, StringComparer.OrdinalIgnoreCase);
            try { await JS.InvokeVoidAsync("localStorage.setItem", "nmu_quiz_path_map", System.Text.Json.JsonSerializer.Serialize(QuizState.SubjectPathMap)); } catch { }
            if (_subjects.Count == 0)
                _errorMsg = "No quizzes available.";

            _loading = false;
            StateHasChanged();

            // Background revalidation for quiz list
            _ = QuizService.CheckAndUpdateQuizListAsync(_studentLevel, _studentSemester, async updatedList =>
            {
                _subjects = updatedList.Where(s => NMU.Platform.Components.Services.ArchiveCatalog.IsVisibleForDepartment(s.Branch, _studentDept)).ToList();
                QuizState.SubjectPathMap = _subjects.GroupBy(s => s.Name, StringComparer.OrdinalIgnoreCase).ToDictionary(g => g.Key, g => g.First().Path, StringComparer.OrdinalIgnoreCase);
                await InvokeAsync(StateHasChanged);
            });
        }
        catch (Exception ex)
        {
            _error = true;
            _errorMsg = $"Error: {ex.Message}";
            _loading = false;
        }
    }

    private void OnSyncProgress(SyncProgress progress)
    {
        _syncProgress = progress;
        if (progress.IsComplete)
        {
            QuizService.SyncProgressChanged -= OnSyncProgress;
        }
        InvokeAsync(StateHasChanged);
    }

    private async Task BuildCustomQuizListAsync(List<CustomSubjectSelection> selections)
    {
        var result = new List<QuizSubject>();
        var seenPaths = new HashSet<string>(StringComparer.OrdinalIgnoreCase);

        // Per SELECTION (not per archive quiz name): every registered subject
        // must contribute its own archive's quizzes. Matching on the full
        // folder name is exact; the fuzzy matcher stays as fallback. Dedupe by
        // file path so same-named subjects from different archives don't
        // swallow each other (the old seen-by-Name logic dropped them).
        foreach (var group in selections.GroupBy(s => (s.Level, s.Semester)))
        {
            var quizzes = await QuizService.GetCachedQuizListAsync(group.Key.Level, group.Key.Semester);
            if (quizzes.Count == 0)
                quizzes = await QuizService.GetQuizListAsync(group.Key.Level, group.Key.Semester);

            foreach (var sel in group)
            {
                foreach (var quiz in quizzes)
                {
                    var keep = string.Equals(sel.Subject, quiz.SubjectFullName, StringComparison.OrdinalIgnoreCase)
                        || SubjectMatcher.Matches(sel.Subject, quiz.SubjectFullName)
                        || SubjectMatcher.Matches(sel.Subject, quiz.Name);
                    if (!keep) continue;
                    if (seenPaths.Add(quiz.Path))
                        result.Add(quiz);
                }
            }
        }

        _subjects = result;
        QuizState.SubjectPathMap = _subjects.GroupBy(s => s.Name, StringComparer.OrdinalIgnoreCase).ToDictionary(g => g.Key, g => g.First().Path, StringComparer.OrdinalIgnoreCase);
        try { await JS.InvokeVoidAsync("localStorage.setItem", "nmu_quiz_path_map", System.Text.Json.JsonSerializer.Serialize(QuizState.SubjectPathMap)); } catch { }
    }

    public void Dispose()
    {
        QuizService.SyncProgressChanged -= OnSyncProgress;
        LayoutState.RefreshRequested -= OnRefreshRequested;
    }

    private void OnRefreshRequested() => Reload();

    private void OpenSubject(QuizSubject subject)
    {
        QuizState.SubjectName = subject.Name;
        QuizState.SubjectPath = subject.Path;
        QuizState.SubjectArchiveId = subject.ArchiveId;
        QuizState.SubjectLevel = subject.Level;
        QuizState.SubjectSemester = subject.Semester;
        QuizState.CurrentQuiz = subject;
        Navigation.NavigateTo($"quizzes/{Uri.EscapeDataString(subject.Name)}", replace: true);
    }

    private void Reload()
    {
        _error = false;
        _loading = true;
        StateHasChanged();
        _ = OnInitializedAsync();
    }


}

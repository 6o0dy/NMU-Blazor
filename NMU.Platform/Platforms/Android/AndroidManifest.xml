<?xml version="1.0" encoding="utf-8"?>
<manifest xmlns:android="http://schemas.android.com/apk/res/android">
	<!-- Network access: archive.org content, Firebase update checks, APK downloads -->
	<uses-permission android:name="android.permission.INTERNET" />
	<uses-permission android:name="android.permission.ACCESS_NETWORK_STATE" />
	<!-- Launcher icons (hand-placed legacy PNGs; MauiIcon excludes Android).
	     Without these, the generated template defaults that used to carry the
	     icon are replaced by this file and the app installs with no icon. -->
	<application android:icon="@mipmap/appicon" android:roundIcon="@mipmap/appicon_round"></application>
</manifest>

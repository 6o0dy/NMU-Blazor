<?xml version="1.0" encoding="utf-8"?>
<!--
  One-click publish for macOS (Mac Catalyst app bundle).
  REQUIRES: a paired Mac. Cannot build from Windows alone.
  Usage (on the paired setup): right-click NMU.Platform -> Publish -> pick
  "MacCatalyst-Folder" -> Publish.
-->
<Project>
  <PropertyGroup>
    <Configuration>Release</Configuration>
    <Platform>Any CPU</Platform>
    <PublishDir>bin\Release\net10.0-maccatalyst\publish\</PublishDir>
    <PublishProtocol>FileSystem</PublishProtocol>
    <TargetFramework>net10.0-maccatalyst</TargetFramework>
    <_TargetId>Folder</_TargetId>
  </PropertyGroup>
</Project>

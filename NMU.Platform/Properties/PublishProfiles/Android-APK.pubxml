<?xml version="1.0" encoding="utf-8"?>
<!--
  One-click publish for Android (APK for direct distribution, e.g. Drive).
  Usage: right-click NMU.Platform -> Publish -> pick "Android-APK" -> Publish.
  No manual framework switching or CLI needed.
-->
<Project>
  <PropertyGroup>
    <Configuration>Release</Configuration>
    <Platform>Any CPU</Platform>
    <PublishDir>bin\Release\net10.0-android\publish\</PublishDir>
    <PublishProtocol>FileSystem</PublishProtocol>
    <TargetFramework>net10.0-android</TargetFramework>
    <_TargetId>Folder</_TargetId>
  </PropertyGroup>
</Project>

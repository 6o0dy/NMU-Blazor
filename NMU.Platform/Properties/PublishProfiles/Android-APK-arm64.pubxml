<?xml version="1.0" encoding="utf-8"?>
<!--
  One-click publish for Android, arm64 phones only (smaller APK ~40% less).
  Usage: right-click NMU.Platform -> Publish -> pick "Android-APK-arm64" -> Publish.
  Architecture is set by RuntimeIdentifiers below: change it to
  android-arm / android-x86_64 / or remove the line for a universal APK.
-->
<Project>
  <PropertyGroup>
    <Configuration>Release</Configuration>
    <Platform>Any CPU</Platform>
    <PublishDir>bin\Release\net10.0-android\publish-arm64\</PublishDir>
    <PublishProtocol>FileSystem</PublishProtocol>
    <TargetFramework>net10.0-android</TargetFramework>
    <RuntimeIdentifiers>android-arm64</RuntimeIdentifiers>
    <_TargetId>Folder</_TargetId>
  </PropertyGroup>
</Project>

<?xml version="1.0" encoding="utf-8"?>
<!--
  One-click publish for iPhone (physical device).
  REQUIRES: a paired Mac + Apple Developer signing (certificate + provisioning
  profile for the bundle id com.companyname.nmu.platform). Cannot run from
  Windows alone.
  Usage (on the paired setup): right-click NMU.Platform -> Publish -> pick
  "iOS-Device" -> Publish.
-->
<Project>
  <PropertyGroup>
    <Configuration>Release</Configuration>
    <Platform>iPhone</Platform>
    <PublishDir>bin\Release\net10.0-ios\publish\</PublishDir>
    <PublishProtocol>FileSystem</PublishProtocol>
    <TargetFramework>net10.0-ios</TargetFramework>
    <_TargetId>Folder</_TargetId>
  </PropertyGroup>
</Project>

<?xml version="1.0" encoding="utf-8"?>
<!--
  One-click publish for Windows (unpackaged exe folder, ready to zip/share).
  Usage: right-click NMU.Platform -> Publish -> pick "Windows-Folder" -> Publish.
  No manual framework switching or CLI needed.
-->
<Project>
  <PropertyGroup>
    <Configuration>Release</Configuration>
    <Platform>Any CPU</Platform>
    <PublishDir>bin\Release\net10.0-windows10.0.19041.0\publish\</PublishDir>
    <PublishProtocol>FileSystem</PublishProtocol>
    <TargetFramework>net10.0-windows10.0.19041.0</TargetFramework>
    <_TargetId>Folder</_TargetId>
  </PropertyGroup>
</Project>
